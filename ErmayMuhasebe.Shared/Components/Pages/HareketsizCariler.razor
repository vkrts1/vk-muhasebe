@page "/hareketsiz-cariler"
@using ErmayMuhasebe.Models
@using ErmayMuhasebe.Services
@inject DatabaseService DbService
@inject NavigationManager Nav
@inject IPdfService PdfService
@inject IFileService FileService
@inject ISnackbar Snackbar
@using MudBlazor



    <div class="d-flex align-center justify-space-between mb-4">
        <MudText Typo="Typo.h5" Color="MudBlazor.Color.Primary">Hareketsiz Cariler Raporu</MudText>
        <MudStack Row="true" Spacing="2">
            <MudButton Variant="Variant.Text" Color="Color.Warning" StartIcon="@Icons.Material.Filled.List" OnClick="@(() => Nav.NavigateTo("/raporlar-menu"))">Tüm Raporlar</MudButton>
            @if(hareketsizCariler.Any())
            {
                 <MudButton Variant="Variant.Outlined" Color="MudBlazor.Color.Secondary" StartIcon="@Icons.Material.Filled.PictureAsPdf" OnClick="PrintReport">
                    Yazdır / PDF
                </MudButton>
            }
        </MudStack>
    </div>

<MudPaper Class="pa-4 mb-4">
    <MudNumericField @bind-Value="gunSayisi" Label="Hareketsizlik Süresi (Gün)" Variant="Variant.Outlined" Min="30" Max="365" />
    <div class="d-flex gap-2 mt-2">
        <MudButton Variant="Variant.Filled" Color="MudBlazor.Color.Primary" OnClick="LoadData" Disabled="isLoading">
            @if(isLoading)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            Raporu Oluştur
        </MudButton>
    </div>
</MudPaper>

@if(isLoading)
{
    <MudProgressLinear Indeterminate="true" Color="MudBlazor.Color.Primary" />
}
else if(hareketsizCariler.Any())
{
    <MudTable Items="@hareketsizCariler" Hover="true">
        <HeaderContent>
            <MudTh>Unvan</MudTh>
            <MudTh>Grup</MudTh>
            <MudTh>Telefon</MudTh>
            <MudTh>Bakiye</MudTh>
            <MudTh>Kayıt Tarihi</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.Unvan</MudTd>
            <MudTd>@context.Grup</MudTd>
            <MudTd>@context.Telefon</MudTd>
            <MudTd>@context.Bakiye.ToString("C2")</MudTd>
            <MudTd>@context.KayitTarihi.ToShortDateString()</MudTd>
        </RowTemplate>
    </MudTable>
    
    <MudAlert Severity="Severity.Info" Class="mt-4">
        Toplam @hareketsizCariler.Count adet hareketsiz cari bulundu.
    </MudAlert>
}
else if(hasLoaded)
{
    <MudAlert Severity="Severity.Success" Class="mt-4">
        Son @gunSayisi gün içinde hareketsiz cari bulunmadı.
    </MudAlert>
}

@code {
    private int gunSayisi = 90;
    private List<CariKart> hareketsizCariler = new();
    private bool isLoading = false;
    private bool hasLoaded = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            hareketsizCariler = await DbService.GetHareketsizCarilerAsync(gunSayisi);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Hata: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
            hasLoaded = true;
        }
    }

    private async Task PrintReport()
    {
        try
        {
            var headers = new[] { "Unvan", "Grup", "Telefon", "Bakiye", "Kayıt Tarihi" };
            var rows = hareketsizCariler.Select(c => new string[] 
            { 
                c.Unvan ?? "",
                c.Grup ?? "",
                c.Telefon ?? "",
                c.Bakiye.ToString("C2"),
                c.KayitTarihi.ToShortDateString()
            }).ToList();
            
            var pdf = await PdfService.GenerateGenericTablePdfBytesAsync("Hareketsiz Cariler Raporu", headers, rows);
            await FileService.SaveAndOpenFileAsync("HareketsizCariler.pdf", pdf, "application/pdf");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Hata: {ex.Message}", Severity.Error);
        }
    }
}

