@page "/etiket-tasarim"
@using MudBlazor

<MudText Typo="Typo.h5" Color="Color.Primary" Class="mb-4">Etiket Şablon Tasarımcısı</MudText>

<MudGrid>
    <MudItem xs="12" md="4">
        <MudPaper Class="pa-4">
            <MudText Typo="Typo.h6" Class="mb-4">Tasarım Araçları</MudText>
            
            <MudExpansionPanels MultiExpansion="true">
                <MudExpansionPanel Text="Düzen (Layout)" Expanded="true">
                    <MudNumericField @bind-Value="genislik" Label="Genişlik (mm)" Variant="Variant.Outlined" Class="mb-2" />
                    <MudNumericField @bind-Value="yukseklik" Label="Yükseklik (mm)" Variant="Variant.Outlined" Class="mb-2" />
                </MudExpansionPanel>
                
                <MudExpansionPanel Text="Ekran Alanları">
                    <MudCheckBox @bind-Value="showBarkod" Label="Barkod Göster" Color="Color.Primary" />
                    <MudCheckBox @bind-Value="showFiyat" Label="Fiyat Göster" Color="Color.Primary" />
                    <MudCheckBox @bind-Value="showStokAdi" Label="Stok Adı Göster" Color="Color.Primary" />
                    <MudCheckBox @bind-Value="showLogo" Label="Şirket Logosu" Color="Color.Primary" />
                </MudExpansionPanel>

                <MudExpansionPanel Text="Yazı Tipi">
                    <MudSelect T="string" Label="Font" Variant="Variant.Outlined">
                        <MudSelectItem Value="@("Arial")">Arial</MudSelectItem>
                        <MudSelectItem Value="@("Roboto")">Roboto</MudSelectItem>
                        <MudSelectItem Value="@("Consolas")">Consolas</MudSelectItem>
                    </MudSelect>
                    <MudSlider @bind-Value="fontSize" Min="8" Max="24" Step="1">Yazı Boyutu: @fontSize px</MudSlider>
                </MudExpansionPanel>
            </MudExpansionPanels>

            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Class="mt-4" StartIcon="@Icons.Material.Filled.Save">
                Şablonu Kaydet
            </MudButton>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="8">
        <MudPaper Class="pa-8 d-flex flex-column align-center justify-center gray-bg" Style="min-height: 500px">
            <MudText Typo="Typo.caption" Class="mb-2">Önizleme (Canlı)</MudText>
            
            <div class="label-preview shadow-lg" style="@($"width: {genislik*3}px; height: {yukseklik*3}px; background: white; padding: 10px; position: relative;")">
                @if (showLogo)
                {
                    <div style="font-weight: bold; font-size: 10px; border-bottom: 1px solid #ccc; margin-bottom: 5px;">ERMAY MUHASEBE</div>
                }
                
                @if (showStokAdi)
                {
                    <div style="@($"font-size: {fontSize}px; font-weight: bold; margin-bottom: 5px;")">ÖRNEK ÜRÜN ADI</div>
                }

                @if (showBarkod)
                {
                    <div class="mt-4 d-flex flex-column align-center">
                        <div style="width: 80%; height: 40px; background: repeating-linear-gradient(90deg, #000, #000 2px, #fff 2px, #fff 4px);"></div>
                        <div style="font-size: 10px;">8691234567890</div>
                    </div>
                }

                @if (showFiyat)
                {
                    <div style="position: absolute; bottom: 10px; right: 10px; text-align: right;">
                        <div style="font-size: 10px; color: gray;">KDV Dahil</div>
                        <div style="font-size: 24px; font-weight: 900; color: #d32f2f;">149,90 TL</div>
                    </div>
                }
            </div>

            <MudText Typo="Typo.caption" Class="mt-4">@genislik x @yukseklik mm ölçeğinde çıktı alınacaktır.</MudText>
        </MudPaper>
    </MudItem>
</MudGrid>

<style>
    .gray-bg {
        background-color: #f5f5f5;
        border: 2px dashed #ccc;
    }
    .label-preview {
        transition: all 0.3s ease;
    }
</style>

@code {
    private int genislik = 80;
    private int yukseklik = 40;
    private int fontSize = 14;
    private bool showBarkod = true;
    private bool showFiyat = true;
    private bool showStokAdi = true;
    private bool showLogo = true;
}
