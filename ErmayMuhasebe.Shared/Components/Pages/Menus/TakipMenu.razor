@page "/takip-listeleri-menu"
@using MudBlazor

<MudText Typo="Typo.h5" Class="mb-4 font-weight-bold" Color="Color.Primary">Takip Listeleri</MudText>

<MudGrid Spacing="3">
    <MudItem xs="12" sm="6" md="4">
        <MudCard Elevation="3" Class="d-flex flex-column align-center justify-center pa-4 cursor-pointer hover-effect" @onclick='() => Nav.NavigateTo("stok-hareketleri")'>
            <MudIcon Icon="@Icons.Material.Filled.History" Size="Size.Large" Color="Color.Primary" Class="mb-2" />
            <MudText Typo="Typo.h6">Stok Hareketleri</MudText>
        </MudCard>
    </MudItem>
    <MudItem xs="12" sm="6" md="4">
        <MudCard Elevation="3" Class="d-flex flex-column align-center justify-center pa-4 cursor-pointer hover-effect" @onclick='() => Nav.NavigateTo("odeme-takibi")'>
            <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Size="Size.Large" Color="Color.Primary" Class="mb-2" />
            <MudText Typo="Typo.h6">Ödeme Takibi</MudText>
        </MudCard>
    </MudItem>
</MudGrid>

<style>
    .hover-effect:hover {
        background-color: var(--mud-palette-action-hover);
        transform: translateY(-2px);
        transition: all 0.3s;
    }
</style>

@inject NavigationManager Nav
