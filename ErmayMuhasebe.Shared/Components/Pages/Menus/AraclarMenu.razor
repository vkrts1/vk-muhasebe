@page "/araclar-menu"
@using MudBlazor
@inject NavigationManager Nav

<MudText Typo="Typo.h5" Class="mb-4 font-weight-bold" Color="Color.Primary">Araçlar & Yardımcılar</MudText>

<MudGrid Spacing="3">
    <MudItem xs="12" sm="6" md="4">
        <MudCard Elevation="3" Class="d-flex flex-column align-center justify-center pa-4 cursor-pointer hover-effect" @onclick='() => Nav.NavigateTo("/doviz-kurlari")'>
            <MudIcon Icon="@Icons.Material.Filled.AttachMoney" Size="Size.Large" Color="Color.Primary" Class="mb-2" />
            <MudText Typo="Typo.h6">Döviz Kurları</MudText>
        </MudCard>
    </MudItem>
    <MudItem xs="12" sm="6" md="4">
        <MudCard Elevation="3" Class="d-flex flex-column align-center justify-center pa-4 cursor-pointer hover-effect" @onclick='() => Nav.NavigateTo("/ajanda")'>
            <MudIcon Icon="@Icons.Material.Filled.Event" Size="Size.Large" Color="Color.Primary" Class="mb-2" />
            <MudText Typo="Typo.h6">Ajanda</MudText>
        </MudCard>
    </MudItem>
    <MudItem xs="12" sm="6" md="4">
        <MudCard Elevation="3" Class="d-flex flex-column align-center justify-center pa-4 cursor-pointer hover-effect" @onclick='() => Nav.NavigateTo("/hesap-makinesi")'>
            <MudIcon Icon="@Icons.Material.Filled.Calculate" Size="Size.Large" Color="Color.Primary" Class="mb-2" />
            <MudText Typo="Typo.h6">Hesap Makinesi</MudText>
        </MudCard>
    </MudItem>
</MudGrid>

<style>
    .hover-effect:hover {
        background-color: var(--mud-palette-action-hover);
        transform: translateY(-2px);
        transition: all 0.3s;
    }
</style>
