@page "/fatura-islemleri-menu"
@using MudBlazor
@inject NavigationManager Nav

<MudText Typo="Typo.h5" Class="mb-4 font-weight-bold" Color="Color.Primary">Fatura İşlemleri</MudText>

<MudGrid Spacing="3">
    <MudItem xs="12" sm="6" md="4">
        <MudCard Elevation="3" Class="d-flex flex-column align-center justify-center pa-4 cursor-pointer hover-effect" @onclick='() => Nav.NavigateTo("/fatura-listesi")'>
            <MudIcon Icon="@Icons.Material.Filled.List" Size="Size.Large" Color="Color.Primary" Class="mb-2" />
            <MudText Typo="Typo.h6">Fatura Listesi</MudText>
        </MudCard>
    </MudItem>
    <MudItem xs="12" sm="6" md="4">
        <MudCard Elevation="3" Class="d-flex flex-column align-center justify-center pa-4 cursor-pointer hover-effect" @onclick='() => Nav.NavigateTo("/fatura-olustur/Satis")'>
            <MudIcon Icon="@Icons.Material.Filled.ShoppingCart" Size="Size.Large" Color="Color.Success" Class="mb-2" />
            <MudText Typo="Typo.h6">Satış Faturası</MudText>
        </MudCard>
    </MudItem>
    <MudItem xs="12" sm="6" md="4">
        <MudCard Elevation="3" Class="d-flex flex-column align-center justify-center pa-4 cursor-pointer hover-effect" @onclick='() => Nav.NavigateTo("/fatura-olustur/Alis")'>
            <MudIcon Icon="@Icons.Material.Filled.Store" Size="Size.Large" Color="Color.Warning" Class="mb-2" />
            <MudText Typo="Typo.h6">Alış Faturası</MudText>
        </MudCard>
    </MudItem>
</MudGrid>

<style>
    .hover-effect:hover {
        background-color: var(--mud-palette-action-hover);
        transform: translateY(-2px);
        transition: all 0.3s;
    }
</style>
