@page "/kar-zarar-mukayese"
@using ErmayMuhasebe.Models
@using ErmayMuhasebe.Services
@inject DatabaseService DbService
@inject ISnackbar Snackbar
@inject IPdfService PdfService
@inject IFileService FileService
@inject IJSRuntime JS
@inject NavigationManager Nav
@using MudBlazor

<div class="d-flex justify-space-between align-center mb-4">
    <MudText Typo="Typo.h5" Color="Color.Primary">Aylık Kar-Zarar Mukayesesi (YENİ)</MudText>
    <MudStack Row="true" Spacing="2">
        <MudButton Variant="Variant.Text" Color="Color.Warning" StartIcon="@Icons.Material.Filled.List" OnClick="@(() => Nav.NavigateTo("/raporlar-menu"))">Tüm Raporlar</MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.PictureAsPdf" OnClick="PrintReport">
            Yazdır / PDF
        </MudButton>
    </MudStack>
</div>

<MudAlert Severity="Severity.Info" Class="mb-4">Bu rapor, bu yılın verilerini önceki yılın aynı dönemleriyle karşılaştırır.</MudAlert>

<MudGrid>
    <MudItem xs="12">
        <MudTable Items="@comparisons" Dense="true" Hover="true" Striped="true" Bordered="true">
            <HeaderContent>
                <MudTh>Ay</MudTh>
                <MudTh Style="text-align: right;">Bu Yıl Satış</MudTh>
                <MudTh Style="text-align: right;">Geçen Yıl Satış</MudTh>
                <MudTh Style="text-align: right;">Değişim (%)</MudTh>
                <MudTh Style="text-align: right;">Bu Yıl Kar</MudTh>
                <MudTh Style="text-align: right;">Geçen Yıl Kar</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.AyIsmi</MudTd>
                <MudTd Style="text-align: right;">@context.BuYilSatis.ToString("N2") ₺</MudTd>
                <MudTd Style="text-align: right;">@context.GecenYilSatis.ToString("N2") ₺</MudTd>
                <MudTd Style="text-align: right;">
                    <MudText Color="@(context.SatisDegisim >= 0 ? Color.Success : Color.Error)">
                        % @context.SatisDegisim.ToString("N1")
                    </MudText>
                </MudTd>
                <MudTd Style="text-align: right;">@context.BuYilKar.ToString("N2") ₺</MudTd>
                <MudTd Style="text-align: right;">@context.GecenYilKar.ToString("N2") ₺</MudTd>
            </RowTemplate>
        </MudTable>
    </MudItem>
</MudGrid>

@code {
    private List<ComparisonResult> comparisons = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        int thisYear = DateTime.Now.Year;
        int lastYear = thisYear - 1;

        var faturalar = await DbService.GetFaturalarAsync();
        
        for (int i = 1; i <= 12; i++)
        {
            var buYilSatis = faturalar.Where(f => f.Tur == "Satis" && f.Tarih.Year == thisYear && f.Tarih.Month == i).Sum(f => f.GenelToplam);
            var gecenYilSatis = faturalar.Where(f => f.Tur == "Satis" && f.Tarih.Year == lastYear && f.Tarih.Month == i).Sum(f => f.GenelToplam);

            // Kar hesaplama basitçe: Satış - Alış (veya maliyet). Şimdilik satış üzerinden gidelim.
            // Gerçek kar için stok maliyetleri gerek.
            
            comparisons.Add(new ComparisonResult
            {
                AyIndex = i,
                AyIsmi = new DateTime(thisYear, i, 1).ToString("MMMM"),
                BuYilSatis = buYilSatis,
                GecenYilSatis = gecenYilSatis,
                BuYilKar = buYilSatis * 0.2m, // Örnek %20 kar varsayımı
                GecenYilKar = gecenYilSatis * 0.2m
            });
        }
    }

    private async Task PrintReport()
    {
        try
        {
            var headers = new[] { "Ay", "Bu Yıl Satış", "Geçen Yıl Satış", "Değişim (%)", "Bu Yıl Kar" };
            var rows = comparisons.Select(c => new[] 
            { 
                c.AyIsmi, 
                c.BuYilSatis.ToString("C2"), 
                c.GecenYilSatis.ToString("C2"),
                "%" + c.SatisDegisim.ToString("N1"),
                c.BuYilKar.ToString("C2")
            }).ToList();
            
            var pdf = await PdfService.GenerateGenericTablePdfBytesAsync("Aylık Kar-Zarar Mukayese Raporu", headers, rows);
            await FileService.SaveAndOpenFileAsync("KarZararMukayese.pdf", pdf, "application/pdf");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Hata: {ex.Message}", Severity.Error);
        }
    }

    public class ComparisonResult
    {
        public int AyIndex { get; set; }
        public string AyIsmi { get; set; } = "";
        public decimal BuYilSatis { get; set; }
        public decimal GecenYilSatis { get; set; }
        public decimal BuYilKar { get; set; }
        public decimal GecenYilKar { get; set; }
        public decimal SatisDegisim => GecenYilSatis == 0 ? (BuYilSatis > 0 ? 100 : 0) : (BuYilSatis - GecenYilSatis) / GecenYilSatis * 100;
    }
}
