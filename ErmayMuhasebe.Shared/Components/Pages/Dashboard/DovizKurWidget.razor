@using ErmayMuhasebe.Services
@using ErmayMuhasebe.Models
@inject DatabaseService DbService
@inject DovizService DovizService

<MudPaper Class="pa-4" Elevation="2">
    <MudText Typo="Typo.h6" Class="mb-4">Döviz Kurları</MudText>
    <MudGrid Spacing="2">
        @foreach (var kur in kurlar.Where(k => k.Kod == "USD" || k.Kod == "EUR" || k.Kod == "GBP"))
        {
            <MudItem xs="4">
                <MudCard Elevation="0" Outlined="true" Class="pa-2 text-center">
                    <MudText Typo="Typo.subtitle2" Style="font-weight:bold">@kur.Kod</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Success">@kur.Satis.ToString("N2")</MudText>
                </MudCard>
            </MudItem>
        }
    </MudGrid>
    @if (!kurlar.Any())
    {
        <MudButton Variant="Variant.Text" OnClick="async () => { await DovizService.UpdateRatesFromTcmbAsync(); await OnInitializedAsync(); }">Kurları Yükle</MudButton>
    }
</MudPaper>

@code {
    private List<DovizKur> kurlar = new();

    protected override async Task OnInitializedAsync()
    {
        kurlar = await DbService.GetDovizKurlariAsync();
    }
}
