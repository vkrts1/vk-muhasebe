@page "/mukerrer-kontrol"
@using ErmayMuhasebe.Models
@using ErmayMuhasebe.Services
@inject DatabaseService DbService
@using MudBlazor
@inject NavigationManager Nav
@inject IPdfService PdfService
@inject IFileService FileService
@inject ISnackbar Snackbar

<div class="d-flex align-center justify-space-between mb-4">
    <MudText Typo="Typo.h5" Color="Color.Primary">Mükerrer Kayıt Kontrolü (YENİ)</MudText>
    <MudStack Row="true" Spacing="2">
        <MudButton Variant="Variant.Text" Color="Color.Warning" StartIcon="@Icons.Material.Filled.List" OnClick="@(() => Nav.NavigateTo("/raporlar-menu"))">Tüm Raporlar</MudButton>
        @if(duplicates.Any())
        {
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.PictureAsPdf" OnClick="PrintReport">
                Yazdır / PDF
            </MudButton>
        }
    </MudStack>
</div>

<MudAlert Severity="Severity.Info" Class="mb-4">Bu rapor, aynı Vergi No/TC, Telefon veya benzer Ünvan ile açılmış cari kartlarını tespit eder.</MudAlert>

<MudGrid>
    <MudItem xs="12">
        <MudTable Items="@duplicates" Dense="true" Hover="true" Striped="true" Bordered="true">
            <HeaderContent>
                <MudTh>Mükerrerlik Türü</MudTh>
                <MudTh>Değer</MudTh>
                <MudTh>İlgili Cariler</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.Tur</MudTd>
                <MudTd><strong>@context.Deger</strong></MudTd>
                <MudTd>
                    @foreach(var unvan in context.Cariler)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@unvan</MudChip>
                    }
                </MudTd>
            </RowTemplate>
        </MudTable>
    </MudItem>
</MudGrid>

@code {
    private List<DuplicateGroup> duplicates = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        var cariler = await DbService.GetCarilerAsync();

        // VKN Bazlı
        var vknDupes = cariler.Where(c => !string.IsNullOrEmpty(c.VKN))
            .GroupBy(c => c.VKN)
            .Where(g => g.Count() > 1);
            
        foreach(var g in vknDupes)
        {
            duplicates.Add(new DuplicateGroup { Tur = "Aynı VKN / TC", Deger = g.Key ?? "", Cariler = g.Select(c => c.Unvan ?? "").ToList() });
        }

        // Telefon Bazlı
        var telDupes = cariler.Where(c => !string.IsNullOrEmpty(c.Telefon))
            .GroupBy(c => c.Telefon?.Replace(" ", "").Replace("-", "") ?? "")
            .Where(g => g.Count() > 1);

        foreach(var g in telDupes)
        {
            duplicates.Add(new DuplicateGroup { Tur = "Aynı Telefon", Deger = g.Key ?? "", Cariler = g.Select(c => c.Unvan ?? "").ToList() });
        }

        // Ünvan Bazlı (Birebir aynı)
        var unvanDupes = cariler.GroupBy(c => (c.Unvan ?? "").ToLower().Trim())
            .Where(g => g.Count() > 1);

        foreach(var g in unvanDupes)
        {
             duplicates.Add(new DuplicateGroup { Tur = "Aynı Ünvan", Deger = g.Key ?? "", Cariler = g.Select(c => c.Unvan ?? "").ToList() });
        }
    }

    private async Task PrintReport()
    {
        try
        {
            var headers = new[] { "Mükerrerlik Türü", "Değer", "İlgili Cariler" };
            var rows = duplicates.Select(d => new string[] 
            { 
                d.Tur, 
                d.Deger, 
                string.Join(", ", d.Cariler) 
            }).ToList();
            
            var pdf = await PdfService.GenerateGenericTablePdfBytesAsync("Mükerrer Kayıt Kontrol Raporu", headers, rows);
            await FileService.SaveAndOpenFileAsync("MukerrerKayıtlar.pdf", pdf, "application/pdf");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Hata: {ex.Message}", Severity.Error);
        }
    }

    public class DuplicateGroup
    {
        public string Tur { get; set; } = "";
        public string Deger { get; set; } = "";
        public List<string> Cariler { get; set; } = new();
    }
}
