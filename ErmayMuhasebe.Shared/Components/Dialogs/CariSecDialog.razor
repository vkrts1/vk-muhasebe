@using ErmayMuhasebe.Models
@using ErmayMuhasebe.Services
@using MudBlazor
@inject DatabaseService DbService

<MudDialog Style="min-width: 800px;">
    <DialogContent>
        <MudTable Items="@filteredCariler" Hover="true" Breakpoint="Breakpoint.Sm" Filter="new Func<CariKart,bool>(FilterFunc)" @bind-SelectedItem="selectedCari" OnRowClick="RowClickEvent" T="CariKart" Dense="true" Striped="true" Bordered="true">
            <ToolBarContent>
                <MudText Typo="Typo.h6">Cari Seçimi</MudText>
                <MudSpacer />
                <MudTextField @bind-Value="searchString" Placeholder="Carilerde Ara (Ünvan, VKN, Yetkili)..." Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
            </ToolBarContent>
            <HeaderContent>
                <MudTh>Ünvan</MudTh>
                <MudTh>VKN/TC</MudTh>
                <MudTh>Yetkili</MudTh>
                <MudTh>Telefon</MudTh>
                <MudTh>Bakiye</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Ünvan"><div style="width:100%; height:100%; cursor:pointer;" @ondblclick="@(() => OnRowDoubleClick(context))">@context.Unvan</div></MudTd>
                <MudTd DataLabel="VKN"><div style="width:100%; height:100%; cursor:pointer;" @ondblclick="@(() => OnRowDoubleClick(context))">@context.VKN</div></MudTd>
                <MudTd DataLabel="Yetkili"><div style="width:100%; height:100%; cursor:pointer;" @ondblclick="@(() => OnRowDoubleClick(context))">@context.Yetkili</div></MudTd>
                <MudTd DataLabel="Telefon"><div style="width:100%; height:100%; cursor:pointer;" @ondblclick="@(() => OnRowDoubleClick(context))">@context.Telefon</div></MudTd>
                <MudTd DataLabel="Bakiye"><div style="width:100%; height:100%; cursor:pointer;" @ondblclick="@(() => OnRowDoubleClick(context))">@context.Bakiye.ToString("N2")</div></MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager />
            </PagerContent>
        </MudTable>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Vazgeç</MudButton>
        <MudButton Color="Color.Primary" OnClick="Submit" Disabled="@(selectedCari == null)">Seç</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    private List<CariKart> cariler = new();
    private List<CariKart> filteredCariler = new();
    private CariKart? selectedCari;
    private string searchString = "";

    protected override async Task OnInitializedAsync()
    {
        cariler = await DbService.GetCarilerAsync();
        filteredCariler = cariler;
    }

    private bool FilterFunc(CariKart element)
    {
        if (string.IsNullOrWhiteSpace(searchString))
            return true;
        if ((element.Unvan ?? "").Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        if (element.VKN?.Contains(searchString, StringComparison.OrdinalIgnoreCase) == true)
            return true;
        if (element.Yetkili?.Contains(searchString, StringComparison.OrdinalIgnoreCase) == true)
            return true;
        return false;
    }

    private void RowClickEvent(TableRowClickEventArgs<CariKart> tableRowClickEventArgs)
    {
       selectedCari = tableRowClickEventArgs.Item;
       StateHasChanged();
    }

    private void OnRowDoubleClick(CariKart item)
    {
        selectedCari = item;
        Submit();
    }
    
    void Submit() 
    {
        if (selectedCari != null)
        {
            MudDialog.Close(DialogResult.Ok(selectedCari));
        }
    }
    void Cancel() => MudDialog.Cancel();
}
