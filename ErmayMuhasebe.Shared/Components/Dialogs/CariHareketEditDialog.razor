@using ErmayMuhasebe.Models
@using ErmayMuhasebe.Services
@using MudBlazor
@inject IDialogService DialogService

<MudDialog Style="min-width: 400px;">
    <DialogContent>
        <MudSelect T="string" Label="İşlem Türü" @bind-Value="IslemTuru" Variant="Variant.Outlined" AdornmentIcon="@Icons.Material.Filled.SwapVert">
            <MudSelectItem Value="@("Tahsilat")">Tahsilat (Giriş / Alacak)</MudSelectItem>
            <MudSelectItem Value="@("Ödeme")">Ödeme (Çıkış / Borç)</MudSelectItem>
        </MudSelect>
        
        <MudDatePicker Label="Tarih" @bind-Date="date" Variant="Variant.Outlined" Class="mt-3" />
        
        <MudTextField @bind-Value="Model.CariUnvan" Label="Cari Unvan" Variant="Variant.Outlined" ReadOnly="true" Class="mt-3" />
        
        <MudNumericField @bind-Value="Tutar" Label="Tutar" Variant="Variant.Outlined" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.AttachMoney" Class="mt-3" />
        
        <MudTextField @bind-Value="Model.Aciklama" Label="Açıklama" Variant="Variant.Outlined" Lines="2" Class="mt-3" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">İptal</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">Kaydet</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    
    [Parameter] public CariHareket Model { get; set; } = new();
    
    private DateTime? date;
    private string IslemTuru { get; set; } = "Tahsilat";
    private decimal Tutar { get; set; }

    protected override void OnInitialized()
    {
        date = Model.Tarih;
        
        // Smart detect type from Alacak/Borc or IslemTuru string
        if (Model.Alacak > 0)
        {
            IslemTuru = "Tahsilat";
            Tutar = Model.Alacak;
        }
        else if (Model.Borc > 0)
        {
            IslemTuru = "Ödeme";
            Tutar = Model.Borc;
        }
        else 
        {
            // Fallback
            IslemTuru = (Model.IslemTuru == "Tahsilat" || Model.IslemTuru == "Alacak") ? "Tahsilat" : "Ödeme";
        }
    }

    void Submit()
    {
        if (Tutar <= 0) return;
        if (date.HasValue) Model.Tarih = date.Value;
        
        // Apply changes back to Model
        if (IslemTuru == "Tahsilat")
        {
            Model.Alacak = Tutar;
            Model.Borc = 0;
            // Dont overwrite IslemTuru string arbitrarily, just ensure it makes sense?
            // User might want to keep "Kredi Kartı Slipleri" or similar.
            // But we can append or leave as is if user didn't change it.
            // For now, let's leave IslemTuru string unless it was generic.
        }
        else
        {
            Model.Borc = Tutar;
            Model.Alacak = 0;
        }
        
        MudDialog.Close(DialogResult.Ok(Model));
    }
    
    void Cancel() => MudDialog.Cancel();
}
