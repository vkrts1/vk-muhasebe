@using Microsoft.AspNetCore.Components.Routing
@using MudBlazor

<MudDialog Class="legacy-light" DefaultFocus="DefaultFocus.None">
    <TitleContent>
        <MudText Typo="Typo.h6">@Title</MudText>
    </TitleContent>
    <DialogContent>
        <div style="min-width: 900px; min-height: 600px; padding: 16px;">
            @if (!string.IsNullOrEmpty(Url))
            {
                var type = GetPageType();
                if (Url == "/cari")
                {
                    var parameters = new Dictionary<string, object>();
                    if (Open != null) parameters["RequestedOperation"] = Open;

                    <DynamicComponent Type="@type" Parameters="parameters" />
                }
                else
                {
                    <DynamicComponent Type="@type" />
                }
            }
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close" Color="Color.Secondary" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Close">Kapat</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    
    [Parameter] public string Url { get; set; } = "";
    [Parameter] public string? Open { get; set; }
    [Parameter] public string Title { get; set; } = "";
    
    private Type? GetPageType()
    {
        // URL'den sayfa tipini bul
        var pageMap = new Dictionary<string, Type>
        {
            ["/"] = typeof(ErmayMuhasebe.Shared.Components.Pages.Home),
            ["/cari"] = typeof(ErmayMuhasebe.Shared.Components.Pages.CariList),
            ["/stok"] = typeof(ErmayMuhasebe.Shared.Components.Pages.StokList),
            ["/fatura-olustur/Satis"] = typeof(ErmayMuhasebe.Shared.Components.Pages.FaturaOlustur),
            ["/fatura-olustur/Alis"] = typeof(ErmayMuhasebe.Shared.Components.Pages.FaturaOlustur),
            ["/finans"] = typeof(ErmayMuhasebe.Shared.Components.Pages.Finans),
            ["/cek-takip"] = typeof(ErmayMuhasebe.Shared.Components.Pages.CekTakip),
            ["/senet-takip"] = typeof(ErmayMuhasebe.Shared.Components.Pages.SenetTakip),
            ["/doviz"] = typeof(ErmayMuhasebe.Shared.Components.Pages.Doviz),
            ["/siparis-listesi"] = typeof(ErmayMuhasebe.Shared.Components.Pages.SiparisList),
            ["/teklif-listesi"] = typeof(ErmayMuhasebe.Shared.Components.Pages.TeklifList),
            ["/fatura-islemleri-menu"] = typeof(ErmayMuhasebe.Shared.Components.Pages.Menus.FaturaMenu),
            ["/muhasebe-menu"] = typeof(ErmayMuhasebe.Shared.Components.Pages.Menus.MuhasebeMenu),
            ["/raporlar-menu"] = typeof(ErmayMuhasebe.Shared.Components.Pages.Menus.RaporMenu),
            ["/takip-listeleri-menu"] = typeof(ErmayMuhasebe.Shared.Components.Pages.Menus.TakipMenu),
            ["/araclar-menu"] = typeof(ErmayMuhasebe.Shared.Components.Pages.Menus.AraclarMenu),
            ["/ayarlar"] = typeof(ErmayMuhasebe.Shared.Components.Pages.Ayarlar)
        };
        
        return pageMap.TryGetValue(Url, out var type) ? type : typeof(ErmayMuhasebe.Shared.Components.Pages.Home);
    }
    
    void Close() => MudDialog.Close(DialogResult.Ok(true));
}
