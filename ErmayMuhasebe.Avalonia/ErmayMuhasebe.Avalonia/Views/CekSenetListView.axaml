<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ErmayMuhasebe.Avalonia.ViewModels;assembly=ErmayMuhasebe.Avalonia"
             xmlns:ic="using:FluentIcons.Avalonia.Fluent"
             xmlns:sys="using:System"
             xmlns:conv="using:ErmayMuhasebe.Avalonia.Converters"
             xmlns:views="using:ErmayMuhasebe.Avalonia.Views"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="800"
             x:Class="ErmayMuhasebe.Avalonia.Views.CekSenetListView"
             x:DataType="vm:CekSenetListViewModel">

  <UserControl.Resources>
    <conv:BitmapAssetValueConverter x:Key="BitmapAssetValueConverter"/>
    <conv:CekDurumToColorConverter x:Key="CekDurumToColorConverter"/>
    <conv:CekDurumToTextConverter x:Key="CekDurumToTextConverter"/>
  </UserControl.Resources>

  <Grid Margin="25">
    <!-- Main Content Area -->
    <Grid RowDefinitions="Auto, *">
      
      <!-- Top Action Bar -->
      <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Margin="0,0,0,25">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="15">
              <Border Background="{StaticResource FluidBlueGradient}" Width="48" Height="48" CornerRadius="12">
                  <ic:SymbolIcon Symbol="MoneyHand" Foreground="White" FontSize="24" HorizontalAlignment="Center"/> 
              </Border>
              <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="Çek Listesi ve Kontrolü" FontSize="20" FontWeight="Bold" Foreground="White"/>
                  <TextBlock Text="Alınan ve verilen çeklerin portföy takibi" FontSize="12" Foreground="#88FFFFFF"/>
              </StackPanel>
          </StackPanel>

          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12">
              <Button Command="{Binding OpenNewCekFormCommand}" Classes="SideButton Info" Width="170">
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
                      <ic:SymbolIcon Symbol="Add" FontSize="18"/> 
                      <TextBlock Text="Yeni Çek Kaydı" FontWeight="Bold"/>
                  </StackPanel>
              </Button>
              <Button Command="{Binding LoadDataCommand}" Classes="SideButton Secondary" Width="45">
                  <ic:SymbolIcon Symbol="ArrowSync" FontSize="18"/> 
              </Button>
          </StackPanel>
      </Grid>

      <!-- Data List Area -->
      <Border Grid.Row="1" Background="{DynamicResource PanelBrush}" CornerRadius="16" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" ClipToBounds="True">
          <Grid RowDefinitions="*, Auto">
              <DataGrid Grid.Row="0" ItemsSource="{Binding Cekler}" SelectedItem="{Binding SelectedCek}"
                        AutoGenerateColumns="False" IsReadOnly="True" 
                        GridLinesVisibility="Horizontal" Background="Transparent"
                        BorderThickness="0" RowHeight="38">
                  <DataGrid.ContextMenu>
                      <ContextMenu>
                          <MenuItem Header="Düzenle" Command="{Binding OpenEditCekFormCommand}" CommandParameter="{Binding SelectedCek}">
                              <MenuItem.Icon><ic:SymbolIcon Symbol="Edit"/></MenuItem.Icon>
                          </MenuItem>
                          <MenuItem Header="Görüntüle (PDF)" Command="{Binding ViewCekPdfCommand}" CommandParameter="{Binding SelectedCek}">
                              <MenuItem.Icon><ic:SymbolIcon Symbol="Print"/></MenuItem.Icon>
                          </MenuItem>
                          <Separator/>
                          <MenuItem Header="Tahsil Edildi" Command="{Binding UpdateCekDurumCommand}" CommandParameter="Tahsil">
                              <MenuItem.Icon><ic:SymbolIcon Symbol="CheckmarkCircle" Foreground="#2ecc71"/> </MenuItem.Icon>
                          </MenuItem>
                          <MenuItem Header="Karşılıksız" Command="{Binding UpdateCekDurumCommand}" CommandParameter="Karsiliksiz">
                              <MenuItem.Icon><ic:SymbolIcon Symbol="DismissCircle" Foreground="#e74c3c"/> </MenuItem.Icon>
                          </MenuItem>
                          <Separator/>
                          <MenuItem Header="Sil" Command="{Binding DeleteCekConfirmCommand}" CommandParameter="{Binding SelectedCek}" Foreground="Crimson">
                              <MenuItem.Icon><ic:SymbolIcon Symbol="Delete" Foreground="Crimson"/> </MenuItem.Icon>
                          </MenuItem>
                      </ContextMenu>
                  </DataGrid.ContextMenu>
                  <DataGrid.Columns>
                      <DataGridTextColumn Header="Portföy No" Binding="{Binding PortfoyNo}" Width="110"/>
                      <DataGridTemplateColumn Header="Vade" Width="100">
                          <DataTemplate>
                              <TextBlock Text="{Binding VadeTarihi, StringFormat='dd.MM.yyyy'}" 
                                         VerticalAlignment="Center" HorizontalAlignment="Center"
                                         FontWeight="Bold" Foreground="#60A5FA" FontSize="12"/>
                          </DataTemplate>
                      </DataGridTemplateColumn>
                      <DataGridTextColumn Header="Asıl Borçlu / Cari" Binding="{Binding AsilBorclu}" Width="*"/>
                      <DataGridTemplateColumn Header="Tutar" Width="130">
                          <DataTemplate>
                              <TextBlock Text="{Binding Tutar, StringFormat='{}{0:N2} ₺'}" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="Bold" Margin="0,0,10,0" FontSize="12"/>
                          </DataTemplate>
                      </DataGridTemplateColumn>
                      <DataGridTemplateColumn Header="Durum" Width="140">
                          <DataTemplate>
                              <Border Padding="14,0" CornerRadius="999" Height="28" Background="{Binding Durum, Converter={StaticResource CekDurumToColorConverter}}" 
                                      HorizontalAlignment="Center" VerticalAlignment="Center">
                                  <TextBlock Text="{Binding Durum, Converter={StaticResource CekDurumToTextConverter}}" 
                                             FontSize="13" FontWeight="Medium" Foreground="White"
                                             VerticalAlignment="Center" HorizontalAlignment="Center"
                                             TextWrapping="NoWrap"/>
                              </Border>
                          </DataTemplate>
                      </DataGridTemplateColumn>
                  </DataGrid.Columns>
              </DataGrid>

               <!-- Total Summary Footer -->
               <Border Grid.Row="1" Background="#1660A5FA" Padding="25,12" BorderBrush="#3360A5FA" BorderThickness="0,1,0,0">
                   <Grid ColumnDefinitions="*, Auto">
                       <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                           <ic:SymbolIcon Symbol="Info" FontSize="18" Foreground="#60A5FA" Opacity="0.7"/> 
                           <TextBlock Text="Portföydeki toplam çek sayısı ve genel mali tablo özeti." FontSize="11" Opacity="0.5" VerticalAlignment="Center" FontStyle="Italic"/>
                       </StackPanel>
                       
                       <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="25">
                           <StackPanel Orientation="Horizontal" Spacing="10">
                               <TextBlock Text="TOPLAM ÇEK TUTARI:" VerticalAlignment="Center" FontSize="12" FontWeight="Black" Opacity="0.6" LetterSpacing="1"/>
                               <Border Background="#2660A5FA" Padding="15,6" CornerRadius="8">
                                   <TextBlock Text="{Binding TotalCekTutari, StringFormat='{}{0:N2} ₺'}" 
                                              Foreground="#60A5FA" FontSize="18" FontWeight="Black"/>
                                </Border>
                           </StackPanel>
                       </StackPanel>
                   </Grid>
               </Border>
          </Grid>
      </Border>
    </Grid>

    <!-- DELETE CONFIRMATION OVERLAY -->
    <Grid Grid.RowSpan="3" Background="#E6000000" IsVisible="{Binding IsConfirmVisible}">
          <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="16" Width="400" VerticalAlignment="Center" HorizontalAlignment="Center" BoxShadow="0 20 60 0 #CC000000" ClipToBounds="True">
             <Grid RowDefinitions="Auto, *">
                  <Border Grid.Row="0" Background="#26FF416C" Padding="20,12">
                      <StackPanel Orientation="Horizontal" Spacing="12">
                          <ic:SymbolIcon Symbol="Delete" Foreground="White" FontSize="20"/> 
                          <TextBlock Text="Onay Gerekiyor" FontWeight="Bold" FontSize="15" Foreground="White" VerticalAlignment="Center"/>
                      </StackPanel>
                  </Border>

                  <StackPanel Grid.Row="1" Margin="30" Spacing="25">
                      <ic:SymbolIcon Symbol="Warning" Foreground="#FF416C" FontSize="48" HorizontalAlignment="Center"/> 
                      <StackPanel Spacing="8">
                          <TextBlock Text="{Binding ConfirmTitle}" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" FontSize="18"/>
                          <TextBlock Text="{Binding ConfirmMessage}" Foreground="#BBB" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" FontSize="13"/>
                      </StackPanel>
                      
                      <Grid ColumnDefinitions="*,*" Margin="0,10,0,0">
                          <Button Grid.Column="0" Classes="SideButton Danger" Command="{Binding ConfirmYesCommand}" Margin="0,0,5,0" Height="45">
                              <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                  <ic:SymbolIcon Symbol="Checkmark" FontSize="18" VerticalAlignment="Center"/> 
                                  <TextBlock Text="EVET, SİL" FontWeight="Bold" VerticalAlignment="Center" FontSize="12"/>
                              </StackPanel>
                          </Button>
                          <Button Grid.Column="1" Classes="SideButton Secondary" Command="{Binding ConfirmNoCommand}" Margin="5,0,0,0" Height="45">
                               <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                  <ic:SymbolIcon Symbol="Dismiss" FontSize="18" VerticalAlignment="Center"/> 
                                  <TextBlock Text="VAZGEÇ" FontWeight="Bold" VerticalAlignment="Center" FontSize="12"/>
                               </StackPanel>
                          </Button>
                      </Grid>
                  </StackPanel>
             </Grid>
         </Border>
    </Grid>

    <!-- REUSABLE CEK ENTRY FORM -->
    <views:CekEntryView DataContext="{Binding}" Grid.RowSpan="2" Grid.ColumnSpan="2"/>
  </Grid>
</UserControl>
