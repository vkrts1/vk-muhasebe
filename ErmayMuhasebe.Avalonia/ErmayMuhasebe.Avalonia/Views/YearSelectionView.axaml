<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ErmayMuhasebe.Avalonia.ViewModels"
             xmlns:ic="clr-namespace:FluentIcons.Avalonia.Fluent;assembly=FluentIcons.Avalonia.Fluent"
             xmlns:conv="clr-namespace:ErmayMuhasebe.Avalonia.Converters"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="ErmayMuhasebe.Avalonia.Views.YearSelectionView"
             x:DataType="vm:YearSelectionViewModel">

    <UserControl.Resources>
        <conv:ObjectIsNullConverter x:Key="ObjectIsNotNullConverter" Inverted="True" />
    </UserControl.Resources>

    <Border Background="{DynamicResource BackgroundBrush}">
        <Grid>


            <StackPanel VerticalAlignment="Center" Spacing="40" MaxWidth="500" HorizontalAlignment="Center">
                
                <StackPanel Spacing="15">
                    <Border Background="#103B82F6" Width="100" Height="100" CornerRadius="30" HorizontalAlignment="Center">
                        <ic:SymbolIcon Symbol="History" FontSize="60" Foreground="#3B82F6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    
                    <StackPanel Spacing="8">
                        <TextBlock Text="Çalışma Yılı Seçimi" 
                                   FontSize="36" 
                                   FontWeight="Black" 
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextBrush}"/>
                        
                        <TextBlock Text="Devam etmek için aşağıdaki listeden bir yıl seçiniz" 
                                   FontSize="16" 
                                   Opacity="0.6"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   Foreground="{DynamicResource TextBrush}"/>
                    </StackPanel>
                </StackPanel>

                <Border Background="{DynamicResource CardBackgroundBrush}" 
                        CornerRadius="24" 
                        BorderThickness="1" 
                        BorderBrush="{DynamicResource BorderBrush}"
                        BoxShadow="0 15 40 0 #30000000"
                        Margin="0,10">
                    <ListBox ItemsSource="{Binding Years}" 
                             SelectedItem="{Binding SelectedYear}"
                             Background="Transparent"
                             Padding="20"
                             MaxHeight="400">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="12"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="x:Int32">
                                <Border Padding="25,20" CornerRadius="15">
                                    <Grid ColumnDefinitions="Auto, *, Auto">
                                        <ic:SymbolIcon Symbol="Calendar" FontSize="32" Foreground="#3B82F6" Grid.Column="0"/>
                                        <TextBlock Text="{Binding}" 
                                                 FontSize="26" 
                                                 FontWeight="ExtraBold" 
                                                 Margin="25,0,0,0"
                                                 VerticalAlignment="Center"
                                                 Grid.Column="1"/>
                                        <ic:SymbolIcon Symbol="ChevronRight" FontSize="20" Opacity="0.4" Grid.Column="2"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <ControlTemplate>
                                        <ContentPresenter Name="PART_ContentPresenter"
                                                          Background="{TemplateBinding Background}"
                                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                                          Content="{TemplateBinding Content}"
                                                          Padding="{TemplateBinding Padding}"
                                                          CornerRadius="15"/>
                                    </ControlTemplate>
                                </Setter>
                            </Style>
                            <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                <Setter Property="Background" Value="#3B82F6"/>
                                <Setter Property="TextBlock.Foreground" Value="White"/>
                            </Style>
                            <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                <Setter Property="Background" Value="#153B82F6"/>
                            </Style>
                            <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter">
                                <Setter Property="Background" Value="#2563EB"/>
                            </Style>
                        </ListBox.Styles>
                    </ListBox>
                </Border>

                <StackPanel Spacing="15">
                    <Button Command="{Binding SelectYearCommand}" 
                            Content="Uygulamayı Başlat" 
                            Background="#2563EB" 
                            Foreground="White" 
                            Height="65"
                            CornerRadius="20"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            FontSize="20"
                            FontWeight="Black"
                            IsEnabled="{Binding SelectedYear, Converter={StaticResource ObjectIsNotNullConverter}}">
                        <Button.Styles>
                            <Style Selector="Button:pointerover">
                                <Setter Property="RenderTransform" Value="scale(1.01)"/>
                            </Style>
                            <Style Selector="Button:pressed">
                                <Setter Property="RenderTransform" Value="scale(0.99)"/>
                            </Style>
                        </Button.Styles>
                    </Button>
                    
                    <TextBlock Text="Yeni yıl devir işlemleri artık Ayarlar menüsü altından yönetilebilir." 
                               FontSize="13" 
                               Opacity="0.4" 
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextBrush}"/>
                </StackPanel>
            </StackPanel>

            <!-- Loading Overlay -->
            <Panel IsVisible="{Binding IsBusy}" ZIndex="10">
                <Border Background="{DynamicResource BackgroundBrush}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                <StackPanel Spacing="30" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border Background="#103B82F6" Width="100" Height="100" CornerRadius="30" HorizontalAlignment="Center">
                        <ic:SymbolIcon Symbol="History" FontSize="60" Foreground="#3B82F6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ProgressBar IsIndeterminate="True" 
                               Width="250" 
                               Height="4" 
                               Foreground="#3B82F6"
                               Background="#40FFFFFF"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding StatusMessage}" 
                             Foreground="{DynamicResource TextBrush}" 
                             FontSize="20"
                             FontWeight="Black"
                             HorizontalAlignment="Center"/>
                </StackPanel>
            </Panel>
        </Grid>
    </Border>

</UserControl>
