<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ErmayMuhasebe.Avalonia.ViewModels;assembly=ErmayMuhasebe.Avalonia"
             xmlns:ic="using:FluentIcons.Avalonia.Fluent"
             xmlns:models="clr-namespace:ErmayMuhasebe.Models;assembly=ErmayMuhasebe.Shared"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
             x:Class="ErmayMuhasebe.Avalonia.Views.BankaDetayView"
             x:DataType="vm:BankaDetayViewModel"
             x:Name="root">

  <Grid RowDefinitions="Auto, *" Margin="25">
    <!-- Header -->
    <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Margin="0,0,0,25">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="15">
            <Button Command="{Binding GoBackCommand}" 
                    Classes="SideButton Secondary" Width="40" Height="40" Padding="0">
                <ic:SymbolIcon Symbol="ArrowLeft" FontSize="20"/> 
            </Button>
            <Border Background="{StaticResource FluidBlueGradient}" Width="48" Height="48" CornerRadius="12">
                <ic:SymbolIcon Symbol="BuildingBank" Foreground="White" FontSize="24" HorizontalAlignment="Center"/> 
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding BankaAdi}" FontSize="20" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Hesap Hareketleri ve Havale/EFT İşlemleri" FontSize="12" Foreground="#88FFFFFF"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="20" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,20,0">
                <Button Command="{Binding OpenAddTransactionDialogCommand}" CommandParameter="TAHSİLAT"
                        Classes="SideButton Success" Height="40">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ic:SymbolIcon Symbol="Add" FontSize="18"/>
                        <TextBlock Text="Tahsilat (Giriş)"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding OpenAddTransactionDialogCommand}" CommandParameter="ÖDEME"
                        Classes="SideButton Danger" Height="40">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ic:SymbolIcon Symbol="Subtract" FontSize="18"/>
                        <TextBlock Text="Ödeme (Çıkış)"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            
            <StackPanel HorizontalAlignment="Right">
                <TextBlock Text="Güncel Bakiye" FontSize="12" Foreground="#88FFFFFF" HorizontalAlignment="Right"/>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding GuncelBakiye, StringFormat='N2'}" 
                               FontSize="28" FontWeight="ExtraBold" 
                               Foreground="{Binding GuncelBakiye, Converter={StaticResource BakiyeToColorConverter}}"/>
                    <TextBlock Text="{Binding DovizTuru}" FontSize="14" VerticalAlignment="Bottom" Margin="0,0,0,6" Opacity="0.5"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Grid>

    <!-- Content Area -->
    <Grid Grid.Row="1">
        <!-- Empty State -->
        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="20" 
                IsVisible="{Binding NoHareketler}" BorderBrush="#22FFFFFF" BorderThickness="1">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="20">
                <Border Width="80" Height="80" Background="#08FFFFFF" CornerRadius="40">
                    <ic:SymbolIcon Symbol="History" FontSize="40" Foreground="{StaticResource SecondaryTextBrush}" Opacity="0.3"/>
                </Border>
                <StackPanel Spacing="5" HorizontalAlignment="Center">
                    <TextBlock Text="Henüz İşlem Bulunmuyor" FontSize="18" FontWeight="Bold" Opacity="0.8" HorizontalAlignment="Center"/>
                    <TextBlock Text="Bu hesaba ait Havale/EFT kaydı bulunmamaktadır." FontSize="13" Opacity="0.5" HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="15" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <Button Command="{Binding OpenAddTransactionDialogCommand}" CommandParameter="TAHSİLAT"
                            Classes="SideButton Success" Height="40" Padding="20,0">
                         <StackPanel Orientation="Horizontal" Spacing="8">
                            <ic:SymbolIcon Symbol="Add" FontSize="18"/>
                            <TextBlock Text="Tahsilat Ekle"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding OpenAddTransactionDialogCommand}" CommandParameter="ÖDEME"
                            Classes="SideButton Danger" Height="40" Padding="20,0">
                         <StackPanel Orientation="Horizontal" Spacing="8">
                            <ic:SymbolIcon Symbol="Subtract" FontSize="18"/>
                            <TextBlock Text="Ödeme Ekle"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Data Area -->
        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="20" 
                IsVisible="{Binding HasHareketler}" BorderBrush="#22FFFFFF" BorderThickness="1" Padding="5">
          <DataGrid ItemsSource="{Binding Hareketler}" 
                    SelectedItem="{Binding SelectedHareket}"
                    AutoGenerateColumns="False" IsReadOnly="True"
                    GridLinesVisibility="Horizontal" Background="Transparent"
                    BorderThickness="0" RowHeight="50"
                    DoubleTapped="OnDoubleTapped">
            <DataGrid.Styles>
                <Style Selector="DataGridColumnHeader">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Height" Value="45"/>
                    <Setter Property="Padding" Value="15,0"/>
                </Style>
                <Style Selector="DataGridRow">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Transitions">
                        <Transitions>
                            <BrushTransition Property="Background" Duration="0:0:0.2"/>
                        </Transitions>
                    </Setter>
                    <Setter Property="ContextMenu">
                        <Setter.Value>
                            <ContextMenu>
                                <MenuItem Header="İşlem Detayları" 
                                          Command="{ReflectionBinding #root.DataContext.ViewTransactionDetailCommand}" 
                                          CommandParameter="{Binding}">
                                    <MenuItem.Icon><ic:SymbolIcon Symbol="Info"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Düzenle" 
                                          Command="{ReflectionBinding #root.DataContext.OpenEditTransactionDialogCommand}" 
                                          CommandParameter="{Binding}">
                                    <MenuItem.Icon><ic:SymbolIcon Symbol="Edit"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Sil" 
                                          Command="{ReflectionBinding #root.DataContext.DeleteHareketCommand}" 
                                          CommandParameter="{Binding}">
                                    <MenuItem.Icon><ic:SymbolIcon Symbol="Delete" Foreground="#e74c3c"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Aktar (Tedarikçi)" 
                                          IsVisible="{Binding Giren}"
                                          Command="{ReflectionBinding #root.DataContext.TransferTransactionCommand}" 
                                          CommandParameter="{Binding}">
                                    <MenuItem.Icon><ic:SymbolIcon Symbol="Send" Foreground="#3498db"/></MenuItem.Icon>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="Makbuz İşlemleri">
                                    <MenuItem.Icon><ic:SymbolIcon Symbol="Print"/></MenuItem.Icon>
                                    <MenuItem Header="Makbuzu Görüntüle" 
                                              Command="{ReflectionBinding #root.DataContext.ViewMakbuzCommand}" 
                                              CommandParameter="{Binding}">
                                        <MenuItem.Icon><ic:SymbolIcon Symbol="Eye"/></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Makbuzu Kaydet" 
                                              Command="{ReflectionBinding #root.DataContext.PrintMakbuzCommand}" 
                                              CommandParameter="{Binding}">
                                        <MenuItem.Icon><ic:SymbolIcon Symbol="Save"/></MenuItem.Icon>
                                    </MenuItem>
                                </MenuItem>
                            </ContextMenu>
                        </Setter.Value>
                    </Setter>
                </Style>
                <Style Selector="DataGridRow:pointerover">
                    <Setter Property="Background" Value="#08FFFFFF"/>
                </Style>
                <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
                    <Setter Property="Fill" Value="#154A90E2"/>
                </Style>
            </DataGrid.Styles>
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="Tarih" Width="150">
                  <DataTemplate>
                      <StackPanel VerticalAlignment="Center" Margin="15,0">
                          <TextBlock Text="{Binding Tarih, StringFormat='dd.MM.yyyy'}" FontWeight="SemiBold"/>
                          <TextBlock Text="{Binding Tarih, StringFormat='HH:mm'}" FontSize="11" Opacity="0.5"/>
                      </StackPanel>
                  </DataTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="İşlem Türü" Width="160">
                  <DataTemplate>
                     <Border Padding="14,0" CornerRadius="999" Height="28" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0"
                             Background="{Binding IslemTuru, Converter={StaticResource IslemTuruToBrushConverter}}">
                         <TextBlock Text="{Binding IslemTuru}" 
                                    FontSize="13" FontWeight="Medium" Foreground="White"
                                    VerticalAlignment="Center" HorizontalAlignment="Center"/>
                     </Border>
                  </DataTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Cari / Açıklama" Binding="{Binding Aciklama}" Width="*"/>
              <DataGridTemplateColumn Header="Tutar" Width="140">
                  <DataTemplate>
                      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,20,0">
                          <TextBlock Text="{Binding Giren, StringFormat='N2'}" Foreground="#2ecc71" FontWeight="Bold" IsVisible="{Binding Giren}"/>
                          <TextBlock Text="{Binding Cikan, StringFormat='N2'}" Foreground="#e74c3c" FontWeight="Bold" IsVisible="{Binding Cikan}"/>
                          <TextBlock Text="{ReflectionBinding #root.DataContext.DovizTuru}" FontSize="10" Opacity="0.3" HorizontalAlignment="Right"/>
                      </StackPanel>
                  </DataTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="İşlemler" Width="160">
                  <DataTemplate>
                      <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                          <Button Command="{ReflectionBinding #root.DataContext.TransferTransactionCommand}"
                                  CommandParameter="{Binding}" Classes="SideButton Info" 
                                  Width="32" Height="32" Padding="0"
                                  ToolTip.Tip="Tedarikçiye Aktar"
                                  IsVisible="{Binding Giren}">
                              <ic:SymbolIcon Symbol="Send" FontSize="16" Foreground="White"/> 
                          </Button>
                          <Button Command="{ReflectionBinding #root.DataContext.OpenEditTransactionDialogCommand}"
                                  CommandParameter="{Binding}" Classes="SideButton Secondary" 
                                  Width="32" Height="32" Padding="0">
                              <ic:SymbolIcon Symbol="Edit" FontSize="16" Foreground="White"/> 
                          </Button>
                          <Button Command="{ReflectionBinding #root.DataContext.DeleteHareketCommand}" 
                                  CommandParameter="{Binding}" Classes="SideButton Danger" 
                                  Width="32" Height="32" Padding="0">
                              <ic:SymbolIcon Symbol="Delete" FontSize="16" Foreground="White"/> 
                          </Button>
                      </StackPanel>
                  </DataTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </Border>
    </Grid>

    <!-- Transaction Edit Dialog / Detail View -->
    <Grid Grid.RowSpan="2" IsVisible="{Binding IsTransactionDialogVisible}">
        <Border Background="#CC000000" IsVisible="{Binding IsTransactionDialogVisible}"/>
        <Border Background="{DynamicResource SurfaceBrush}" 
                Width="500" VerticalAlignment="Center" HorizontalAlignment="Center" 
                CornerRadius="24" Padding="0"
                BorderBrush="#44FFFFFF" BorderThickness="1"
                BoxShadow="0 10 30 0 #66000000">
            <Grid RowDefinitions="Auto, *, Auto">
                <!-- Header -->
                <Border Grid.Row="0" Background="#11FFFFFF" Padding="25,20" CornerRadius="24,24,0,0">
                    <StackPanel Spacing="5">
                        <TextBlock Text="{Binding TransactionTitle}" FontSize="20" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="İşlem kayıtlarını aşağıdan inceleyebilirsiniz" FontSize="12" Opacity="0.5" IsVisible="{Binding IsDetailMode}"/>
                        <TextBlock Text="İşlem kayıtlarını güvenli bir şekilde güncelleyin" FontSize="12" Opacity="0.5" IsVisible="{Binding IsEditMode}"/>
                    </StackPanel>
                </Border>

                <!-- Form (Editing) -->
                <ScrollViewer Grid.Row="1" IsVisible="{Binding IsEditMode}">
                <Border Padding="30">
                    <StackPanel Spacing="20">
                        <Grid ColumnDefinitions="*, Auto">
                             <StackPanel Spacing="8" Margin="0,0,10,0">
                                 <TextBlock Text="CARİ HESAP (KİMDEN / KİME)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SystemAccentColor}" Opacity="0.8" Margin="2,0"/>
                                 <TextBox Text="{Binding TransactionCariUnvan}" 
                                          Watermark="Cari Seçiniz..."
                                          IsReadOnly="True"
                                          MinHeight="45" VerticalContentAlignment="Center"
                                          Classes="Modern"/>
                             </StackPanel>
                             <Button Grid.Column="1" Command="{Binding SelectCariForTransactionCommand}"
                                     Classes="SideButton Primary" Height="45" Width="45" Padding="0" VerticalAlignment="Bottom">
                                 <ic:SymbolIcon Symbol="Search" FontSize="20" Foreground="White"/>
                             </Button>
                        </Grid>

                        <StackPanel Spacing="8">
                            <TextBlock Text="AÇIKLAMA" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SystemAccentColor}" Opacity="0.8" Margin="2,0"/>
                            <TextBox Text="{Binding TransactionDescription}" 
                                     Watermark="İşlem detaylarını buraya girin..."
                                     MinHeight="45" VerticalContentAlignment="Center"
                                     Classes="Modern"/>
                        </StackPanel>
                        
                        <Grid ColumnDefinitions="*, *">
                            <StackPanel Grid.Column="0" Margin="0,0,15,0" Spacing="8">
                                <TextBlock Text="İŞLEM TARİHİ" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SystemAccentColor}" Opacity="0.8" Margin="2,0"/>
                                <DatePicker SelectedDate="{Binding TransactionDate}" 
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Center"
                                            Height="45"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="8">
                                <TextBlock Text="TUTAR" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SystemAccentColor}" Opacity="0.8" Margin="2,0"/>
                                <NumericUpDown Value="{Binding TransactionAmount}" 
                                             HorizontalAlignment="Stretch"
                                             Height="45"
                                             FormatString="N2"/>
                            </StackPanel>
                        </Grid>
                        
                        <!-- File Upload -->
                        <Grid ColumnDefinitions="*, Auto">
                             <StackPanel Spacing="8" Margin="0,0,10,0">
                                 <TextBlock Text="DEKONT EKİ" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SystemAccentColor}" Opacity="0.8" Margin="2,0"/>
                                 <TextBox Text="{Binding TransactionDekontPath}" 
                                          Watermark="Dosya yolu..."
                                          IsReadOnly="True"
                                          MinHeight="45" VerticalContentAlignment="Center"
                                          Classes="Modern"/>
                             </StackPanel>
                             <Button Grid.Column="1" Command="{Binding UploadDekontForTransactionCommand}"
                                     Classes="SideButton Secondary" Height="45" Width="45" Padding="0" VerticalAlignment="Bottom">
                                 <ic:SymbolIcon Symbol="Attach" FontSize="20" Foreground="White"/>
                             </Button>
                        </Grid>
                        
                        <Border Background="#08FFFFFF" Padding="15" CornerRadius="12">
                            <StackPanel Orientation="Horizontal" Spacing="15">
                                 <Border Background="{DynamicResource SystemAccentColor}" Opacity="0.2" Width="40" Height="40" CornerRadius="8">
                                     <ic:SymbolIcon Symbol="Tag" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                 </Border>
                                 <StackPanel VerticalAlignment="Center">
                                     <TextBlock Text="İşlem Türü" FontSize="11" Opacity="0.5"/>
                                     <TextBlock Text="{Binding TransactionType}" FontWeight="SemiBold" FontSize="14"/>
                                 </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
                </ScrollViewer>

                <!-- Detail View (ReadOnly) -->
                <Border Grid.Row="1" Padding="30" IsVisible="{Binding IsDetailMode}">
                    <StackPanel Spacing="25">
                        <Border Background="#11FFFFFF" Padding="25" CornerRadius="20" BorderBrush="#22FFFFFF" BorderThickness="1">
                            <Grid RowDefinitions="Auto, Auto, Auto">
                                <!-- Top: Icon and Type -->
                                <Grid ColumnDefinitions="Auto, *" Margin="0,0,0,20">
                                    <Border Grid.Column="0" Background="{StaticResource FluidBlueGradient}" Width="56" Height="56" CornerRadius="16">
                                        <ic:SymbolIcon Symbol="Receipt" Foreground="White" FontSize="28" HorizontalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="15,0">
                                        <TextBlock Text="{Binding TransactionType}" FontSize="24" FontWeight="Bold" Foreground="White"/>
                                        <TextBlock Text="Banka İşlem Detay Kaydı" FontSize="12" Opacity="0.5"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Middle: Amount Box -->
                                <Border Grid.Row="1" Background="#08FFFFFF" Padding="20" CornerRadius="16" Margin="0,0,0,20">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="TOPLAM TUTAR" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SystemAccentColor}" Opacity="0.8"/>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding TransactionAmount, StringFormat='N2'}" FontSize="28" FontWeight="Bold" Foreground="#2ecc71"/>
                                                <TextBlock Text="{Binding DovizTuru}" FontSize="14" Opacity="0.6" VerticalAlignment="Bottom" Margin="0,0,0,5"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="#112ecc71" Padding="12,6" CornerRadius="8" VerticalAlignment="Center">
                                            <TextBlock Text="İŞLENDİ" FontSize="12" FontWeight="Bold" Foreground="#2ecc71"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Bottom: Info Grid -->
                                <Grid Grid.Row="2" ColumnDefinitions="*, *" RowDefinitions="Auto, Auto, Auto" Margin="5,0">
                                    <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2" Margin="0,0,0,15">
                                        <TextBlock Text="TARİH" FontSize="11" Opacity="0.4" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding TransactionDate, StringFormat='dd MMMM yyyy'}" FontSize="14" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Spacing="2" Margin="0,0,0,15">
                                        <TextBlock Text="SAAT" FontSize="11" Opacity="0.4" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding TransactionDate, StringFormat='HH:mm'}" FontSize="14" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Spacing="2">
                                        <TextBlock Text="AÇIKLAMA" FontSize="11" Opacity="0.4" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding TransactionDescription}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Opacity="0.9"/>
                                    </StackPanel>
                                     <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Spacing="2" Margin="0,15,0,0" IsVisible="{Binding TransactionDekontPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                         <TextBlock Text="EKLİ DEKONT" FontSize="11" Opacity="0.4" FontWeight="SemiBold"/>
                                         <StackPanel Orientation="Horizontal" Spacing="5">
                                             <ic:SymbolIcon Symbol="Attach" FontSize="14"/>
                                             <TextBlock Text="{Binding TransactionDekontPath}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                         </StackPanel>
                                     </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <Grid ColumnDefinitions="*, *">
                            <Button Grid.Column="0" Command="{Binding ViewMakbuzCommand}" 
                                    Margin="0,0,10,0" Height="48"
                                    Classes="SideButton Info">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <ic:SymbolIcon Symbol="Eye" FontSize="18"/>
                                    <TextBlock Text="Görüntüle"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="1" Command="{Binding PrintMakbuzCommand}" 
                                    Height="48" Classes="SideButton Secondary">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <ic:SymbolIcon Symbol="Save" FontSize="18"/>
                                    <TextBlock Text="PDF Kaydet"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                        
                        <Button Command="{Binding CloseTransactionDialogCommand}" 
                                Content="Kapat" Height="48"
                                HorizontalAlignment="Stretch"
                                Classes="SideButton Secondary"
                                Opacity="0.8"/>
                    </StackPanel>
                </Border>

                <!-- Footer (Only for Editing) -->
                <Border Grid.Row="2" Background="#08FFFFFF" Padding="25,20" CornerRadius="0,0,24,24" IsVisible="{Binding IsEditMode}">
                    <Grid ColumnDefinitions="*, *">
                        <Button Grid.Column="0" Content="İptal" Command="{Binding CloseTransactionDialogCommand}" 
                                HorizontalAlignment="Stretch" Margin="0,0,10,0"
                                Height="45"
                                Classes="SideButton Secondary"/>
                        <Button Grid.Column="1" Content="Değişiklikleri Kaydet" Command="{Binding SaveTransactionCommand}" 
                                HorizontalAlignment="Stretch"
                                Height="45"
                                Classes="SideButton Info"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>

    <!-- Cari Selection Overlay -->
    <Grid Grid.Row="0" Grid.RowSpan="2" IsVisible="{Binding IsCariSecimVisible}">
         <Border Background="#CC000000"/>
         <Border Width="500" Height="600" Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Padding="20">
             <Grid RowDefinitions="Auto, Auto, *, Auto">
                 <TextBlock Text="Cari Hesap Seçimi" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>
                 
                 <Grid Grid.Row="1" ColumnDefinitions="*, Auto" Margin="0,0,0,10">
                     <TextBox Text="{Binding CariSearchText}" Watermark="Cari Ara..." Classes="Modern" Margin="0,0,10,0" VerticalContentAlignment="Center"/>
                     <Button Command="{Binding SearchCariCommand}" Classes="SideButton Primary">
                         <ic:SymbolIcon Symbol="Search"/>
                     </Button>
                 </Grid>
                 
                 <ListBox Grid.Row="2" ItemsSource="{Binding CariListesi}" SelectedItem="{Binding SelectedCariForSelection}" 
                           Background="Transparent" DoubleTapped="OnCariDoubleTapped">
                     <ListBox.ItemTemplate>
                         <DataTemplate>
                             <StackPanel Spacing="2">
                                 <TextBlock Text="{Binding Unvan}" FontWeight="Bold"/>
                                 <TextBlock Text="{Binding VergiNo}" FontSize="12" Opacity="0.7"/>
                             </StackPanel>
                         </DataTemplate>
                     </ListBox.ItemTemplate>
                 </ListBox>
                 
                 <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,20,0,0">
                     <Button Content="İptal" Command="{Binding CancelCariSelectionCommand}" Classes="SideButton Secondary"/>
                     <Button Content="Seç" Command="{Binding ConfirmCariSelectionCommand}" Classes="SideButton Success"/>
                 </StackPanel>
             </Grid>
         </Border>
    </Grid>
  </Grid>
</UserControl>
