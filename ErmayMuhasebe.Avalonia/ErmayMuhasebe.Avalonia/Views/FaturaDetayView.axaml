<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ErmayMuhasebe.Avalonia.ViewModels;assembly=ErmayMuhasebe.Avalonia"
             xmlns:ic="using:FluentIcons.Avalonia.Fluent"
             xmlns:System="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
             x:Class="ErmayMuhasebe.Avalonia.Views.FaturaDetayView"
             x:DataType="vm:FaturaDetayViewModel"
             FontFamily="Netflix Sans, Inter, Roboto, Segoe UI"
             Background="{DynamicResource BackgroundBrush}">

  <UserControl.Styles>
    <!-- Base styles for this view specifically to match the retro look -->
    <!-- Removed forced light mode styles -->
  </UserControl.Styles>

  <Grid RowDefinitions="Auto, *">
    
    <!-- MOBILE BACK BUTTON -->
    <Button Grid.Row="0" Command="{Binding CloseFaturaCommand}" 
            Classes="IconButton" Background="Transparent" 
            HorizontalAlignment="Left" Margin="5" Padding="10,5">
        <StackPanel Orientation="Horizontal" Spacing="5">
            <ic:SymbolIcon Symbol="ArrowLeft" FontSize="20" Foreground="{DynamicResource TextBrush}"/>
            <TextBlock Text="Geri Dön" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
        </StackPanel>
    </Button>

    <Grid Grid.Row="1" RowDefinitions="Auto, *, Auto, Auto" Margin="2">

      <!-- ROW 0: TOP SECTION (Cari, Fatura, Header) -->
      <Grid Grid.Row="0" Margin="0,0,0,5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3.5*"/> <!-- Cari Bilgileri -->
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="2*"/>   <!-- Fatura Bilgileri -->
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="2.5*"/> <!-- Header & Settings -->
        </Grid.ColumnDefinitions>

        <!-- CARI BILGILERI -->
        <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SystemBaseMediumLowColor}" BorderThickness="1">
            <Grid RowDefinitions="Auto, *">
                <!-- Header -->
                <Border Grid.Row="0" Classes="HeaderPanel">
                    <TextBlock Text="Cari Bilgileri"/>
                </Border>
                <!-- Content -->
                <Grid Grid.Row="1" ColumnDefinitions="Auto, *, Auto, *, Auto" RowDefinitions="Auto, Auto, Auto, Auto, Auto" Margin="5">
                    
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Ünvan" Margin="0,0,5,5"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Cari.Unvan}" Margin="0,0,5,5"/>
                    
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Vergi Dairesi" Margin="0,0,5,5"/>
                    <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding Cari.VergiDairesi}" Margin="0,0,5,5"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Yetkili" Margin="0,0,5,5"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Cari.Yetkili}" Margin="0,0,5,5"/>

                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Vergi No" Margin="0,0,5,5"/>
                    <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding Cari.VergiNo}" Margin="0,0,5,5"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Grid.RowSpan="2" Text="Adres" Margin="0,0,5,5" VerticalAlignment="Top"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Grid.RowSpan="2" Text="{Binding Cari.Adres}" Height="68" AcceptsReturn="True" Margin="0,0,5,5"/>

                    <TextBlock Grid.Row="2" Grid.Column="2" Text="İl" Margin="0,0,5,5" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding Cari.Il}" Margin="0,0,5,5"/>
                    
                    <TextBlock Grid.Row="3" Grid.Column="2" Text="İlçe" Margin="0,0,5,5" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="3" Grid.Column="3" Text="{Binding Cari.Ilce}" Margin="0,0,5,5"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="E-Mail" Margin="0,0,5,0" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Cari.Email}" Margin="0,0,5,0"/>
                    
                    <TextBlock Grid.Row="4" Grid.Column="2" Text="Ülke" Margin="0,0,5,0" VerticalAlignment="Center"/>
                    <ComboBox Grid.Row="4" Grid.Column="3" SelectedIndex="0" Margin="0,0,5,0" HorizontalAlignment="Stretch">
                        <ComboBoxItem>Türkiye</ComboBoxItem>
                    </ComboBox>

                    <!-- Cari Sec Button -->
                    <Button Grid.Row="0" Grid.Column="4" Grid.RowSpan="2" 
                            Command="{Binding OpenCariSecimCommand}" 
                            Width="60" Height="44" 
                            Padding="0" 
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Margin="10,0,0,5"
                            Background="#1A60A5FA" BorderBrush="#4060A5FA" BorderThickness="1"
                            CornerRadius="10">
                       <StackPanel VerticalAlignment="Center" Spacing="0">
                          <ic:SymbolIcon Symbol="PeopleSearch" Foreground="#60A5FA" FontSize="18" HorizontalAlignment="Center"/> 
                          <TextBlock Text="Cari Seç" Foreground="White" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                       </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <!-- FATURA BILGILERI -->
        <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SystemBaseMediumLowColor}" BorderThickness="1">
            <Grid RowDefinitions="Auto, *">
                <!-- Header -->
                 <Grid Grid.Row="0">
                     <Grid.ColumnDefinitions>
                         <ColumnDefinition Width="*"/>
                         <ColumnDefinition Width="Auto"/>
                     </Grid.ColumnDefinitions>
                     <Border Grid.Column="0" Padding="5,0">
                         <TextBlock Text="Firma Bilgileri" FontWeight="Bold" HorizontalAlignment="Left"/>
                     </Border>

                 </Grid>
                
                <!-- Content -->
                <Grid Grid.Row="1" ColumnDefinitions="Auto, *" RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, Auto" Margin="5">
                    <TextBlock Grid.Row="0" Text="Fatura Tarihi" Margin="0,0,5,5"/>
                    <CalendarDatePicker Grid.Row="0" Grid.Column="1" SelectedDate="{Binding Tarih}" SelectedDateFormat="Custom" CustomDateFormatString="dd.MM.yyyy" Watermark="GG.AA.YYYY" HorizontalAlignment="Stretch" Margin="0,0,0,5"/>

                    <TextBlock Grid.Row="1" Text="Sevk Tarihi" Margin="0,0,5,5"/>
                    <CalendarDatePicker Grid.Row="1" Grid.Column="1" SelectedDate="{Binding VadeTarihi}" SelectedDateFormat="Custom" CustomDateFormatString="dd.MM.yyyy" Watermark="GG.AA.YYYY" HorizontalAlignment="Stretch" Margin="0,0,0,5"/>

                    <TextBlock Grid.Row="2" Text="Saat" Margin="0,0,5,5"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Source={x:Static System:DateTime.Now}, StringFormat='{}{0:HH:mm}'}" IsReadOnly="True" Margin="0,0,0,5" />

                    <TextBlock Grid.Row="3" Text="Fatura No" Margin="0,0,5,5"/>
                     <Grid Grid.Row="3" Grid.Column="1" ColumnDefinitions="*, Auto" Margin="0,0,0,5">
                        <TextBox Grid.Column="0" Text="{Binding FaturaNo}"/>
                        <Button Grid.Column="1" Content="+" Padding="5,0" Width="25"  Foreground="White" />
                     </Grid>
                     
                     <TextBlock Grid.Row="4" Text="Ödeme Şekli" Margin="0,0,5,5"/>
                     <ComboBox Grid.Row="4" Grid.Column="1" SelectedItem="{Binding OdemeSekli}" HorizontalAlignment="Stretch" Margin="0,0,0,5">
                         <System:String>Açık Hesap</System:String>
                         <System:String>Nakit</System:String>
                         <System:String>Kredi Kartı</System:String>
                     </ComboBox>

                     <TextBlock Grid.Row="5" Text="Kasa" Margin="0,0,5,5" IsVisible="{Binding IsKasaVisible}"/>
                     <ComboBox Grid.Row="5" Grid.Column="1" HorizontalAlignment="Stretch" Margin="0,0,0,5"
                               IsVisible="{Binding IsKasaVisible}"
                               ItemsSource="{Binding Kasalar}"
                               SelectedValue="{Binding SelectedKasaId}"
                               SelectedValueBinding="{Binding Id}"
                               DisplayMemberBinding="{Binding BankaAdi}"/>

                     <TextBlock Grid.Row="6" Text="Banka" Margin="0,0,5,5" IsVisible="{Binding IsBankaVisible}"/>
                     <ComboBox Grid.Row="6" Grid.Column="1" HorizontalAlignment="Stretch" Margin="0,0,0,5"
                               IsVisible="{Binding IsBankaVisible}"
                               ItemsSource="{Binding Bankalar}"
                               SelectedValue="{Binding SelectedBankaId}"
                               SelectedValueBinding="{Binding Id}"
                               DisplayMemberBinding="{Binding BankaAdi}"/>

                    <!-- Ozel Alanlar & Proje Secimi Removed -->
                </Grid>
            </Grid>
        </Border>

        <!-- BAŞLIK ve AYARLAR -->
        <Grid Grid.Column="4" RowDefinitions="Auto, *">
            <!-- Header Red Box -->
            <Border Grid.Row="0" Background="{Binding HeaderColor}" Padding="10" Margin="0,0,0,5">
                <TextBlock Text="{Binding HeaderTitle}" FontSize="26" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
            </Border>

            <!-- Checkboxes -->
            <Grid Grid.Row="1" ColumnDefinitions="*, *" RowDefinitions="Auto, Auto" Margin="0,5,0,0">
                <CheckBox Grid.Row="0" Grid.Column="0" Content="Alış Fiyatını Stoklara İşle" FontSize="11" IsChecked="{Binding SettStokFiyat}"/>
                <CheckBox Grid.Row="0" Grid.Column="1" Content="BİLGİ FİŞİ YAZDIR" FontSize="11" IsChecked="{Binding SettBilgiFisi}"/>
                
                <CheckBox Grid.Row="1" Grid.Column="0" Content="Cariye İşle" FontSize="11" IsChecked="{Binding SettCariIsle}"/>
                <CheckBox Grid.Row="1" Grid.Column="1" Content="Stoğa İşle" FontSize="11" IsChecked="{Binding SettStokIsle}"/>
            </Grid>
        </Grid>
    </Grid>

    <!-- ROW 1: MIDDLE SECTION (Grid & Actions) -->
    <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="220"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT: DataGrid and Input -->
        <Grid Grid.Column="0" RowDefinitions="Auto, *">
            <!-- DataGrid -->
             <DataGrid Grid.Row="1" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" AutoGenerateColumns="False" 
                       CanUserResizeColumns="True"
                       GridLinesVisibility="All"
                       BorderThickness="1" BorderBrush="#A0A0A0">
                <DataGrid.Styles>
                    <Style Selector="DataGridColumnHeader">
                        <Setter Property="Padding" Value="5"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    </Style>
                </DataGrid.Styles>
                
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Ad" Binding="{Binding Ad}" Width="*"/>
                    
                    <DataGridTemplateColumn Header="Miktar" Width="80">
                        <DataTemplate>
                             <NumericUpDown Value="{Binding Miktar}"  ShowButtonSpinner="False" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Right"/>
                        </DataTemplate>
                    </DataGridTemplateColumn>


                    <DataGridTextColumn Header="Birim" Binding="{Binding Birim}" Width="70"/>

                    <DataGridTemplateColumn Header="Birim Fiyatı" Width="110">
                        <DataTemplate>
                             <NumericUpDown Value="{Binding BirimFiyat}"  ShowButtonSpinner="False" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Right"/>
                        </DataTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="KDV" Width="80">
                        <DataTemplate>
                             <ComboBox SelectedValue="{Binding KdvOrani}" HorizontalAlignment="Stretch" BorderThickness="0" Background="Transparent">
                                <System:Decimal>0</System:Decimal>
                                <System:Decimal>10</System:Decimal>
                                <System:Decimal>20</System:Decimal>
                             </ComboBox>
                        </DataTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Toplam" Binding="{Binding Tutar, StringFormat='N2'}" Width="90"/>
                    <DataGridTextColumn Header="Genel Toplam" Binding="{Binding GenelToplam, StringFormat='N2'}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

         <!-- RIGHT: Product Actions and Settings -->
         <Border Grid.Column="1" Background="{DynamicResource PanelBrush}" CornerRadius="12" Padding="12" Margin="5,0,0,0">
            <Grid RowDefinitions="Auto, *">
               <StackPanel Spacing="8">
                  <TextBlock Text="ÜRÜN İŞLEMLERİ" FontSize="10" FontWeight="Bold" Foreground="#666" HorizontalAlignment="Center" Margin="0,2,0,6"/>
                  
                  <Button Command="{Binding OpenStokSecimCommand}" Classes="SideButton Info">
                     <StackPanel Orientation="Horizontal" Spacing="8">
                        <ic:SymbolIcon Symbol="Search" FontSize="16"/> 
                        <TextBlock Text="Ürün Ekle (F2)" FontSize="11" FontWeight="SemiBold"/>
                     </StackPanel>
                  </Button>
                  
                  <Button Classes="SideButton Warning">
                     <StackPanel Orientation="Horizontal" Spacing="8">
                        <ic:SymbolIcon Symbol="Edit" FontSize="16"/> 
                        <TextBlock Text="Ürün Düzelt (F3)" FontSize="11" FontWeight="SemiBold"/>
                     </StackPanel>
                  </Button>

                  <Button Command="{Binding RemoveSelectedItemCommand}" Classes="SideButton Danger">
                     <StackPanel Orientation="Horizontal" Spacing="8">
                        <ic:SymbolIcon Symbol="Delete" FontSize="16"/> 
                        <TextBlock Text="Ürünü Sil" FontSize="11" FontWeight="SemiBold"/>
                     </StackPanel>
                  </Button>

                  <Button Classes="SideButton Secondary">
                     <StackPanel Orientation="Horizontal" Spacing="8">
                        <ic:SymbolIcon Symbol="ArrowSort" FontSize="16"/> 
                        <TextBlock Text="MİKTAR DEĞİŞTİR (F10)" FontSize="10" FontWeight="SemiBold"/>
                     </StackPanel>
                  </Button>
               </StackPanel>
            </Grid>
         </Border>
    </Grid>

    <!-- ROW 2: BOTTOM SECTION (Totals & Save) -->
    <Grid Grid.Row="2" Margin="0,5,0,0">
        <!-- Main Totals Panel with Integrated Buttons -->
        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource SystemBaseMediumLowColor}" BorderThickness="1" Padding="5">
            <Grid ColumnDefinitions="300, Auto, *, 250">
                <!-- Big Total -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="GENEL TOPLAM" Foreground="#A50909" FontWeight="Bold" FontSize="18" Margin="0,0,0,2"/>
                    <Border Background="{DynamicResource SystemAccentColor}" BorderBrush="#A0A0A0" BorderThickness="1" Height="60">
                         <TextBlock Text="{Binding GenelToplam, StringFormat='N2'}" 
                                    Foreground="White" FontSize="36" FontWeight="Bold" 
                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>

                <!-- Status and Error Messages -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="5" Margin="10,0">
                    <TextBlock Text="{Binding StatusMessage}" 
                               Foreground="#A50909" HorizontalAlignment="Center"
                               FontWeight="Bold" FontSize="14" TextWrapping="Wrap"
                               IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    <TextBlock Text="{Binding ErrorMessage}" 
                               Foreground="#EF4444" HorizontalAlignment="Center"
                               FontWeight="Bold" FontSize="14" TextWrapping="Wrap"
                               IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    <TextBlock Text="{Binding WarningMessage}" 
                               Foreground="#FFA500" HorizontalAlignment="Center"
                               FontWeight="Bold" FontSize="14" TextWrapping="Wrap"
                               IsVisible="{Binding WarningMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                </StackPanel>

                <!-- Buttons Integrated Here (Column 3) -->
                <StackPanel Grid.Column="3" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="10,0,0,0" Spacing="5">
                    <Button Command="{Binding PrintFaturaCommand}" IsEnabled="{Binding !IsSaving}" 
                             Classes="Info" Width="120" Height="34">
                         <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                             <ic:SymbolIcon Symbol="Print" Foreground="White" FontSize="15"/> 
                             <TextBlock Text="Yazdır" Foreground="White" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                         </StackPanel>
                     </Button>
                     
                    <Button Command="{Binding SaveFaturaCommand}" IsEnabled="{Binding !IsSaving}" 
                             Classes="SaveButton" Width="120" Height="34">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ic:SymbolIcon Symbol="Save" Foreground="White" FontSize="15"/> 
                            <TextBlock Text="Kaydet (F4)" Foreground="White" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    
                     <Button Classes="Secondary" Command="{Binding CancelCommand}" IsEnabled="{Binding !IsSaving}" 
                             Width="120" Height="34">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ic:SymbolIcon Symbol="Dismiss" Foreground="White" FontSize="15"/> 
                            <TextBlock Text="Vazgeç (ESC)" Foreground="White" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>

    <!-- STOK SECIM DIALOG (FIXED LAYOUT & OPAQUE BACKGROUND) -->
    <Grid Grid.Row="0" Grid.RowSpan="4" IsVisible="{Binding IsStokSecimVisible}" Background="#E6000000">
       <Border Background="#080A0C" BorderBrush="#33FFFFFF" BorderThickness="1" 
               BoxShadow="0 10 40 0 #AA000000"
               CornerRadius="12" Width="980" Height="680" VerticalAlignment="Center" HorizontalAlignment="Center">
          <Grid RowDefinitions="Auto, Auto, *, Auto">
             
             <!-- Header -->
             <Border Grid.Row="0" Background="#991D2126" Padding="25,15" CornerRadius="12,12,0,0">
                <Grid ColumnDefinitions="*, Auto">
                   <StackPanel Orientation="Horizontal" Spacing="15">
                       <ic:SymbolIcon Symbol="Archive" FontSize="24" Foreground="#60A5FA"/> 
                      <TextBlock Text="Stok Seçim Listesi" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                   </StackPanel>
                   <Button Grid.Column="1" Command="{Binding CloseStokSecimCommand}" 
                           Background="Transparent" Width="32" Height="32" Padding="0">
                      <ic:SymbolIcon Symbol="Dismiss" FontSize="18" Foreground="#88FFFFFF"/> 
                   </Button>
                </Grid>
             </Border>
             
             <!-- Search Section -->
             <Border Grid.Row="1" Background="#11FFFFFF" Margin="20,15,20,5" Padding="15" CornerRadius="8">
                <Grid ColumnDefinitions="*, Auto">
                   <TextBox Grid.Column="0" Text="{Binding StokSearchText}" 
                            Watermark="Stok Adı ve Stok Kodu ile Ara..." 
                            Height="40" CornerRadius="20" Padding="15,5"
                            VerticalContentAlignment="Center"/>
                   <Button Grid.Column="1" Command="{Binding SearchStokCommand}" 
                           Classes="SideButton Info" Width="120" Margin="10,0,0,0">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                         <ic:SymbolIcon Symbol="Search" FontSize="16"/> 
                         <TextBlock Text="ARA" FontWeight="Bold"/>
                      </StackPanel>
                   </Button>
                </Grid>
             </Border>
             
             <!-- List Section -->
             <Border Grid.Row="2" Margin="20,10" Background="#0AFFFFFF" CornerRadius="8" BorderBrush="#22FFFFFF" BorderThickness="1">
                <DataGrid ItemsSource="{Binding StokListesi}" SelectedItem="{Binding SelectedStokForAdd}"
                          AutoGenerateColumns="False" IsReadOnly="True" 
                          Background="Transparent" BorderThickness="0"
                          GridLinesVisibility="Horizontal" RowBackground="Transparent"
                          DoubleTapped="OnStokDoubleTapped">
                   <DataGrid.Columns>
                      <DataGridTextColumn Header="Stok Kodu" Binding="{Binding StokKodu}" Width="120"/>
                      <DataGridTextColumn Header="Stok Adı" Binding="{Binding StokAdi}" Width="*"/>
                      <DataGridTextColumn Header="Satış Fiyatı" Binding="{Binding SatisFiyati, StringFormat='N2'}" Width="120"/>
                      <DataGridTextColumn Header="Miktar" Binding="{Binding Miktar}" Width="80"/>
                   </DataGrid.Columns>
                </DataGrid>
             </Border>
             
             <!-- Footer -->
             <Border Grid.Row="3" Background="#0AFFFFFF" Padding="20,15" CornerRadius="0,0,12,12">
                <Grid ColumnDefinitions="*, Auto, Auto">
                   <Button Grid.Column="1" Command="{Binding CloseStokSecimCommand}" 
                           Classes="SideButton Danger" Width="130" Margin="0,0,10,0">
                      <TextBlock Text="İPTAL" FontWeight="Bold"/>
                   </Button>
                   <Button Grid.Column="2" Command="{Binding AddStokToGridCommand}" 
                           Classes="SideButton Success" Width="200">
                      <StackPanel Orientation="Horizontal" Spacing="10">
                          <ic:SymbolIcon Symbol="Add" FontSize="18"/> 
                         <TextBlock Text="SEÇ VE EKLE" FontWeight="Bold"/>
                      </StackPanel>
                   </Button>
                </Grid>
             </Border>
          </Grid>
       </Border>
    </Grid>

     <!-- CARI SECIM DIALOG -->
    <Grid Grid.Row="0" Grid.RowSpan="4" IsVisible="{Binding IsCariSecimVisible}" Background="#E6000000">
       <Border Background="#080A0C" BorderBrush="#33FFFFFF" BorderThickness="1" 
               BoxShadow="0 10 40 0 #AA000000"
               CornerRadius="12" Width="800" Height="600" VerticalAlignment="Center" HorizontalAlignment="Center">
          <Grid RowDefinitions="Auto, Auto, *, Auto">
             <Border Grid.Row="0" Background="#991D2126" Padding="25,12" CornerRadius="12,12,0,0">
                <Grid ColumnDefinitions="*, Auto">
                   <StackPanel Orientation="Horizontal" Spacing="15">
                       <ic:SymbolIcon Symbol="People" FontSize="24" Foreground="#60A5FA"/> 
                       <TextBlock Text="Cari Hesap Seçimi" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                   </StackPanel>
                   
                   <Button Grid.Column="1" Command="{Binding CloseCariSecimCommand}" 
                           Background="Transparent" Width="36" Height="36" Padding="5"
                           VerticalAlignment="Center" HorizontalAlignment="Right">
                       <ic:SymbolIcon Symbol="Dismiss" FontSize="20" Foreground="#88FFFFFF"/> 
                   </Button>
                </Grid>
             </Border>
             <Border Grid.Row="1" Background="#11FFFFFF" Margin="20,15,20,5" Padding="15" CornerRadius="8">
                <Grid ColumnDefinitions="*, Auto">
                   <TextBox Grid.Column="0" Text="{Binding CariSearchText}" Watermark="Cari Ünvan ile ara..." Height="40" CornerRadius="20" Padding="15,5" VerticalContentAlignment="Center"/>
                   <Button Grid.Column="1" Command="{Binding SearchCariCommand}" Classes="SideButton Info" Width="120" Margin="10,0,0,0">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                         <ic:SymbolIcon Symbol="Search" FontSize="16"/> 
                         <TextBlock Text="ARA" FontWeight="Bold"/>
                      </StackPanel>
                   </Button>
                </Grid>
             </Border>
             <Border Grid.Row="2" Margin="20,10" Background="#0AFFFFFF" CornerRadius="8" BorderBrush="#22FFFFFF" BorderThickness="1">
                <DataGrid ItemsSource="{Binding CariListesi}" SelectedItem="{Binding SelectedCariForAdd}" 
                          AutoGenerateColumns="False" IsReadOnly="True" 
                          Background="Transparent" GridLinesVisibility="Horizontal"
                          DoubleTapped="OnCariDoubleTapped">
                   <DataGrid.Columns>
                      <DataGridTextColumn Header="Grup" Binding="{Binding Grup}" Width="100"/>
                      <DataGridTextColumn Header="Ünvan" Binding="{Binding Unvan}" Width="*"/>
                      <DataGridTextColumn Header="Bakiye" Binding="{Binding Bakiye, StringFormat='N2'}" Width="120"/>
                   </DataGrid.Columns>
                </DataGrid>
             </Border>
             <Border Grid.Row="3" Background="#0AFFFFFF" Padding="20,15" CornerRadius="0,0,12,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                   <Button Command="{Binding CloseCariSecimCommand}" Classes="SideButton Danger" Width="130" Content="İPTAL"/>
                   <Button Command="{Binding SelectCariCommand}" Classes="SideButton Success" Width="200">
                      <StackPanel Orientation="Horizontal" Spacing="10">
                          <ic:SymbolIcon Symbol="Checkmark" FontSize="18"/> 
                          <TextBlock Text="SEÇ" FontWeight="Bold"/>
                      </StackPanel>
                   </Button>
                </StackPanel>
             </Border>
          </Grid>
       </Border>
    </Grid>

  </Grid>
  </Grid>
</UserControl>
