<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ErmayMuhasebe.Avalonia.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="ErmayMuhasebe.Avalonia.Views.SiparisAciklamaView"
             x:DataType="vm:SiparisAciklamaViewModel">

    <Border Background="{StaticResource SolidPanelBrush}" BorderBrush="{StaticResource SurfaceBrush}" BorderThickness="1"
            CornerRadius="16" Padding="30" BoxShadow="0 20 50 0 #60000000"
            HorizontalAlignment="Center" VerticalAlignment="Center" Width="900" Height="650">
        <Grid RowDefinitions="Auto, *, Auto">
            
            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,25">
                <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextBrush}" LetterSpacing="0.5"/>
                <TextBlock Text="Ürünlere özel açıklamalar ekleyin. Bu açıklamalar faturaya aktarılmaz." 
                           FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,8,0,0"/>
            </StackPanel>

            <!-- Grid -->
            <Border Grid.Row="1" CornerRadius="12" ClipToBounds="True" Background="#05FFFFFF" BorderBrush="{StaticResource SurfaceBrush}" BorderThickness="1" Margin="0,0,0,25" MinHeight="400">
                <DataGrid ItemsSource="{Binding Items}" AutoGenerateColumns="False"
                          CanUserSortColumns="True" CanUserResizeColumns="True"
                          GridLinesVisibility="Horizontal" Background="Transparent" RowBackground="Transparent"
                          Padding="0" HeadersVisibility="Column">
                    
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Ürün Adı" Binding="{Binding StokAdi}" IsReadOnly="True" Width="2*" Foreground="{StaticResource TextBrush}"/>
                        
                        <DataGridTextColumn Header="Miktar" Binding="{Binding Miktar}" IsReadOnly="True" Width="80" Foreground="{StaticResource SecondaryTextBrush}"/>

                        <DataGridTemplateColumn Header="Miktar Açıklaması" Width="2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding MiktarAciklama}" VerticalAlignment="Center" Margin="11,0" Foreground="{StaticResource SecondaryTextBrush}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding MiktarAciklama}" Background="#20FFFFFF" Foreground="White" BorderThickness="0"
                                             VerticalContentAlignment="Center" HorizontalContentAlignment="Stretch" CornerRadius="4" Margin="4"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Ürün Açıklaması" Width="2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Aciklama}" VerticalAlignment="Center" Margin="11,0" Foreground="{StaticResource SecondaryTextBrush}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding Aciklama}" Background="#20FFFFFF" Foreground="White" BorderThickness="0"
                                             VerticalContentAlignment="Center" HorizontalContentAlignment="Stretch" CornerRadius="4" Margin="4"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="15">
                <Button Command="{Binding CancelCommand}" Content="İptal" Classes="Secondary" Width="120"/>
                <Button Command="{Binding SaveCommand}" Content="Kaydet" Classes="Success" Width="150" FontWeight="Bold"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
