<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ErmayMuhasebe.Avalonia.ViewModels"
             xmlns:ic="clr-namespace:FluentIcons.Avalonia.Fluent;assembly=FluentIcons.Avalonia.Fluent"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="500"
             x:Class="ErmayMuhasebe.Avalonia.Views.LoginView"
             x:DataType="vm:LoginViewModel">

    <Border Background="{DynamicResource BackgroundBrush}" Padding="40">
        <StackPanel VerticalAlignment="Center" Spacing="20" MaxWidth="350">

            
            <!-- Logo -->
            <Image Source="avares://ErmayMuhasebe.Avalonia/Assets/app_icon.png" 
                   Width="110" 
                   Height="110" 
                   HorizontalAlignment="Center" 
                   Margin="0,0,0,5"/>
            
            <TextBlock Text="BAWSAQ" 
                       FontSize="28" 
                       FontWeight="ExtraBold" 
                       LetterSpacing="2"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextBrush}"/>
            
            <TextBlock Text="Ön Muhasebe &amp; Finans Yönetimi" 
                       FontSize="13" 
                       Opacity="0.7"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextBrush}"/>

            <!-- Giriş Formu Alanı -->
            <StackPanel Spacing="10" Margin="0,15,0,0" IsVisible="{Binding !ShowResetPasswordPanel}">
                <TextBlock Text="Kullanıcı Adı" FontWeight="SemiBold" FontSize="12" Opacity="0.8"/>
                <TextBox Text="{Binding Username}" 
                         Watermark="Kullanıcı adınızı girin"
                         Height="40"
                         VerticalContentAlignment="Center"/>
                
                <TextBlock Text="Şifre" FontWeight="SemiBold" FontSize="12" Opacity="0.8" Margin="0,10,0,0"/>
                <TextBox Text="{Binding Password}" 
                         PasswordChar="*"
                         Watermark="••••••••"
                         Height="40"
                         VerticalContentAlignment="Center"
                         KeyDown="Password_KeyDown"/>

                <Grid ColumnDefinitions="*, Auto" Margin="0,8,0,10" VerticalAlignment="Center">
                    <CheckBox Grid.Column="0" Content="Beni Hatırla" 
                              IsChecked="{Binding RememberMe}"
                              FontSize="13" 
                              VerticalAlignment="Center"
                              Foreground="{DynamicResource TextBrush}"/>
                    
                    <Button Grid.Column="1" Command="{Binding ForgotPasswordCommand}"
                            Background="Transparent" 
                            BorderThickness="0"
                            Padding="8,4"
                            CornerRadius="6"
                            Cursor="Hand"
                            VerticalAlignment="Center">
                        <TextBlock Text="Şifremi Unuttum?" 
                                   FontSize="13" 
                                   FontWeight="Medium" 
                                   Foreground="#3B82F6"/>
                        <Button.Styles>
                            <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="#1E293B"/>
                            </Style>
                            <Style Selector="Button:pointerover TextBlock">
                                <Setter Property="Foreground" Value="#60A5FA"/>
                            </Style>
                        </Button.Styles>
                    </Button>
                </Grid>
            </StackPanel>

            <!-- Şifre Kurtarma Paneli (E-posta + Telegram) -->
            <StackPanel Spacing="15" Margin="0,20,0,0" IsVisible="{Binding ShowResetPasswordPanel}">
                <TextBlock Text="Şifre Kurtarma / Sıfırlama" FontSize="16" FontWeight="Bold" Foreground="#F43F5E" HorizontalAlignment="Center"/>
                
                <!-- Aşama 1: Kullanıcı Adı Girme ve Kod İsteme -->
                <StackPanel Spacing="10" IsVisible="{Binding !IsResetCodeSent}">
                    <TextBlock Text="Kullanıcı adınızı girip E-posta veya Telegram ile 6 haneli doğrulama kodu talep edebilirsiniz." FontSize="12" Foreground="#94a3b8" TextWrapping="Wrap" TextAlignment="Center"/>
                    <TextBox Text="{Binding ResetUsername}" Watermark="Kullanıcı Adı (örn: admin)" Height="40" CornerRadius="8"/>

                    <Grid ColumnDefinitions="*, 10, *">
                        <Button Grid.Column="0" Command="{Binding SendResetCodeCommand}" Content="E-posta ile Gönder" Classes="Primary" Height="40" CornerRadius="8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                        <Button Grid.Column="2" Command="{Binding SendResetCodeViaTelegramCommand}" Content="Telegram ile Gönder" Classes="Primary" Height="40" CornerRadius="8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    </Grid>
                </StackPanel>

                <!-- Aşama 2: 6 Haneli Doğrulama Kodunu Girme ve Doğrulama -->
                <StackPanel Spacing="10" IsVisible="{Binding ShowVerifyResetCodePanel}">
                    <TextBlock Text="Cihazınıza gönderilen 6 haneli doğrulama kodunu girin." FontSize="12" Foreground="#94a3b8" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                    <TextBox Text="{Binding ResetVerificationCode}" Watermark="6 Haneli Kod" Height="40" CornerRadius="8"/>
                    <Button Command="{Binding VerifyResetCodeCommand}" Content="Kodu Doğrula" Classes="Warning" Height="40" CornerRadius="8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                </StackPanel>

                <!-- Aşama 3: Tek Kullanımlık Şifre (OTP) ve Yeni Şifre Tanımlama -->
                <StackPanel Spacing="10" IsVisible="{Binding IsResetCodeVerified}">
                    <TextBlock Text="Doğrulama başarılı! Telegram botunuz üzerinden gönderilen tek kullanımlık şifreyi girerek yeni şifrenizi tanımlayın." FontSize="12" Foreground="#4ADE80" TextWrapping="Wrap" TextAlignment="Center"/>
                    
                    <TextBox Text="{Binding ResetOneTimePassword}" Watermark="Telegram'dan gelen OTP şifre" Height="40" CornerRadius="8"/>
                    <TextBox PasswordChar="*" Text="{Binding ResetNewPassword}" Watermark="Yeni Şifre Belirleyin" Height="40" CornerRadius="8"/>

                    <Button Command="{Binding ConfirmResetPasswordCommand}" Content="Şifreyi Güncelle" Classes="Danger" Height="40" CornerRadius="8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                </StackPanel>

                <!-- Giriş Ekranına Dön Butonu -->
                <Button Command="{Binding ForgotPasswordCommand}" Content="← Giriş Ekranına Dön" Background="Transparent" BorderThickness="0" HorizontalAlignment="Center" Foreground="#60A5FA">
                    <Button.Styles>
                        <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="#93C5FD"/>
                        </Style>
                    </Button.Styles>
                </Button>
            </StackPanel>

            <TextBlock Text="{Binding ErrorMessage}" 
                       Foreground="#EF4444" 
                       FontSize="12" 
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

            <TextBlock Text="{Binding SuccessMessage}" 
                       Foreground="#4ADE80" 
                       FontSize="12" 
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"
                       IsVisible="{Binding SuccessMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

            <Button Command="{Binding LoginCommand}" 
                    Content="Giriş Yap" 
                    Background="#2563EB" 
                    Foreground="White" 
                    Height="45"
                    CornerRadius="8"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    FontWeight="Bold"
                    IsVisible="{Binding !ShowResetPasswordPanel}"
                    IsEnabled="{Binding !IsBusy}">
                <Button.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
                    </Transitions>
                </Button.Transitions>
            </Button>

            <!-- VEYA Ayracı & Google ile Giriş Butonu (Cursor Tasarımı) -->
            <StackPanel Spacing="12" IsVisible="{Binding !ShowResetPasswordPanel}">
                <Grid ColumnDefinitions="*, Auto, *" Margin="0,5">
                    <Rectangle Grid.Column="0" Height="1" Fill="#334155" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="VEYA" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="12,0"/>
                    <Rectangle Grid.Column="2" Height="1" Fill="#334155" VerticalAlignment="Center"/>
                </Grid>

                <Button Command="{Binding LoginWithGoogleCommand}"
                        Background="#1E293B"
                        BorderBrush="#334155"
                        BorderThickness="1"
                        Height="45"
                        CornerRadius="8"
                        HorizontalAlignment="Stretch"
                        Cursor="Hand"
                        IsEnabled="{Binding !IsBusy}">
                    <Grid ColumnDefinitions="Auto, *" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- Google "G" İkonu -->
                        <TextBlock Grid.Column="0" Text="G" 
                                   FontWeight="Black" 
                                   FontSize="16" 
                                   Foreground="#EA4335" 
                                   Margin="0,0,10,0"
                                   VerticalAlignment="Center"/>
                        
                        <TextBlock Grid.Column="1" 
                                   Text="Google ile Giriş Yap" 
                                   FontWeight="SemiBold" 
                                   FontSize="13" 
                                   Foreground="#F8FAFC" 
                                   VerticalAlignment="Center"/>
                    </Grid>
                    <Button.Styles>
                        <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                            <Setter Property="Background" Value="#334155"/>
                            <Setter Property="BorderBrush" Value="#475569"/>
                        </Style>
                    </Button.Styles>
                </Button>
            </StackPanel>

            <ProgressBar IsIndeterminate="True" 
                         IsVisible="{Binding IsBusy}" 
                         Height="2" 
                         Margin="0,-5,0,0"/>
        </StackPanel>
    </Border>
</UserControl>
