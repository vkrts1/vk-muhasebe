<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ErmayMuhasebe.Avalonia.ViewModels;assembly=ErmayMuhasebe.Avalonia"
             xmlns:ic="using:FluentIcons.Avalonia.Fluent"
             x:Class="ErmayMuhasebe.Avalonia.Views.FaturaTasarimView"
             x:DataType="vm:FaturaTasarimViewModel">
  <Grid RowDefinitions="Auto, *" Margin="30">
    <StackPanel Spacing="10" Margin="0,0,0,25">
      <StackPanel Orientation="Horizontal" Spacing="15">
        <Border Width="50" Height="50" CornerRadius="15" Background="#26EC4899">
          <ic:SymbolIcon Symbol="Print" Foreground="#EC4899" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/> 
        </Border>
        <TextBlock Text="Fatura Tasarım Sihirbazı" FontSize="28" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
      </StackPanel>
      <TextBlock Text="Fatura çıktılarınızın döküm düzenini ve görünecek alanlarını yapılandırın." FontSize="15" Foreground="#9CA3AF" Margin="65,0,0,0"/>
    </StackPanel>

    <Grid Grid.Row="1" ColumnDefinitions="350, *">
      <!-- Settings -->
      <Border Grid.Column="0" Background="{DynamicResource PanelBrush}" CornerRadius="20" Padding="25" BorderBrush="#22FFFFFF" BorderThickness="1" Margin="0,0,20,0" VerticalAlignment="Top">
        <StackPanel Spacing="20">
          <TextBlock Text="Bileşen Ayarları" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
          
          <CheckBox IsChecked="{Binding ShowLogo}" Content="Şirket Logosu Göster" Foreground="White"/>
          <CheckBox IsChecked="{Binding ShowBirim}" Content="Birim Kolonu Göster" Foreground="White"/>
          <CheckBox IsChecked="{Binding ShowKdv}" Content="KDV Detaylarını Göster" Foreground="White"/>
          <CheckBox IsChecked="{Binding ShowAraToplam}" Content="Ara Toplam Göster" Foreground="White"/>
          <CheckBox IsChecked="{Binding ShowAciklama}" Content="Açıklama Alanını Göster" Foreground="White"/>

          <Separator Background="#15FFFFFF"/>

          <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
            <StackPanel Grid.Column="0" Spacing="8">
              <TextBlock Text="Kağıt Boyutu" Foreground="#9CA3AF" FontSize="12"/>
              <ComboBox ItemsSource="{Binding FaturaSizeOptions}" SelectedItem="{Binding FaturaSize}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="8">
              <TextBlock Text="Yön" Foreground="#9CA3AF" FontSize="12"/>
              <ComboBox ItemsSource="{Binding FaturaOrientationOptions}" SelectedItem="{Binding FaturaOrientation}"/>
            </StackPanel>
          </Grid>

          <Separator Background="#15FFFFFF"/>

          <StackPanel Spacing="8">
            <TextBlock Text="Fatura Başlığı" Foreground="#9CA3AF" FontSize="12"/>
            <TextBox Text="{Binding BaslikText}"/>
          </StackPanel>

          <StackPanel Spacing="8">
            <TextBlock Text="Alt Bilgi (Notlar)" Foreground="#9CA3AF" FontSize="12"/>
            <TextBox Text="{Binding AltBilgi}" Height="80" AcceptsReturn="True" TextWrapping="Wrap"/>
          </StackPanel>

          <Button Command="{Binding KaydetCommand}" Classes="SideButton Info" Height="50" HorizontalAlignment="Stretch" Background="#EC4899">
             <TextBlock Text="TASARIMI KAYDET" FontWeight="Bold"/>
          </Button>
        </StackPanel>
      </Border>

      <!-- Preview -->
      <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="40" VerticalAlignment="Stretch">
        <Grid RowDefinitions="Auto, Auto, *, Auto">
            <!-- Header -->
            <Grid Grid.Row="0" ColumnDefinitions="*, Auto">
                <StackPanel Spacing="5">
                   <Border Width="100" Height="40" Background="#EEE" IsVisible="{Binding ShowLogo}">
                      <TextBlock Text="LOGO" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#999"/>
                   </Border>
                   <TextBlock Text="ERMAY MUHASEBE VE YAZILIM" Foreground="Black" FontWeight="Bold"/>
                   <TextBlock Text="İstanbul, Türkiye" Foreground="Black" FontSize="10"/>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                   <TextBlock Text="{Binding BaslikText}" Foreground="Black" FontSize="20" FontWeight="Black"/>
                   <TextBlock Text="FATURA NO: ABC2026000001" Foreground="Black" FontSize="12"/>
                </StackPanel>
            </Grid>

            <!-- Info -->
            <Grid Grid.Row="1" ColumnDefinitions="*, *" Margin="0,30">
                <StackPanel Spacing="2">
                   <TextBlock Text="SAYIN," Foreground="Black" FontSize="10" FontWeight="Bold"/>
                   <TextBlock Text="ÖRNEK MÜŞTERİ TİC. LTD. ŞTİ." Foreground="Black"/>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                   <TextBlock Text="TARİH: 04.01.2026" Foreground="Black"/>
                </StackPanel>
            </Grid>

            <!-- Table -->
            <Border Grid.Row="2" BorderBrush="Black" BorderThickness="0,1" Margin="0,10">
                <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="*, Auto, Auto, Auto, Auto">
                    <TextBlock Grid.Column="0" Text="AÇIKLAMA" Foreground="Black" FontWeight="Bold" Margin="0,10"/>
                    <TextBlock Grid.Column="1" Text="MİKTAR" Foreground="Black" FontWeight="Bold" Margin="20,10" IsVisible="{Binding ShowBirim}"/>
                    <TextBlock Grid.Column="2" Text="BİRİM" Foreground="Black" FontWeight="Bold" Margin="20,10" IsVisible="{Binding ShowBirim}"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Yazılım Hizmet Bedeli" Foreground="Black"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="1.00" Foreground="Black" HorizontalAlignment="Right" IsVisible="{Binding ShowBirim}"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Adet" Foreground="Black" Margin="20,0" IsVisible="{Binding ShowBirim}"/>
                </Grid>
            </Border>

            <!-- Footer -->
            <StackPanel Grid.Row="3" HorizontalAlignment="Right" Spacing="5" Margin="0,20,0,0">
                <StackPanel Orientation="Horizontal" Spacing="20" IsVisible="{Binding ShowAraToplam}">
                   <TextBlock Text="ARA TOPLAM:" Foreground="Black" FontWeight="Bold"/>
                   <TextBlock Text="1.000,00 TL" Foreground="Black"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="20" IsVisible="{Binding ShowKdv}">
                   <TextBlock Text="TOPLAM KDV (%20):" Foreground="Black" FontWeight="Bold"/>
                   <TextBlock Text="200,00 TL" Foreground="Black"/>
                </StackPanel>
                <Border Background="Black" Padding="15,5" Margin="0,10,0,0">
                   <StackPanel Orientation="Horizontal" Spacing="20">
                      <TextBlock Text="GENEL TOPLAM:" Foreground="White" FontWeight="Bold"/>
                      <TextBlock Text="1.200,00 TL" Foreground="White" FontWeight="Black"/>
                   </StackPanel>
                </Border>
                <TextBlock Text="{Binding AltBilgi}" Foreground="#666" FontSize="9" TextWrapping="Wrap" MaxWidth="300" Margin="0,20,0,0" IsVisible="{Binding ShowAciklama}"/>
            </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
