<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ErmayMuhasebe.Avalonia.ViewModels;assembly=ErmayMuhasebe.Avalonia"
             xmlns:ic="using:FluentIcons.Avalonia.Fluent"
             xmlns:models="using:ErmayMuhasebe.Models"
             xmlns:conv="using:ErmayMuhasebe.Avalonia.Converters"
             x:Class="ErmayMuhasebe.Avalonia.Views.BarkodTasarimView"
             x:DataType="vm:BarkodTasarimViewModel">
  <Grid RowDefinitions="Auto, *" Margin="30">
    <!-- Header -->
    <StackPanel Spacing="10" Margin="0,0,0,25">
      <StackPanel Orientation="Horizontal" Spacing="15">
        <Border Width="50" Height="50" CornerRadius="15" Background="#266366F1">
          <ic:SymbolIcon Symbol="BarcodeScanner" Foreground="#6366F1" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/> 
        </Border>
        <TextBlock Text="Barkod ve Etiket Tasarımcısı" FontSize="28" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
      </StackPanel>
      <TextBlock Text="Ürünleriniz için profesyonel barkod etiketleri tasarlayın ve yazdırın." FontSize="15" Foreground="#9CA3AF" Margin="65,0,0,0"/>
    </StackPanel>

    <Grid Grid.Row="1" ColumnDefinitions="350, *">
      <!-- Settings -->
      <Border Grid.Column="0" Background="{DynamicResource PanelBrush}" CornerRadius="20" Padding="25" BorderBrush="#22FFFFFF" BorderThickness="1" Margin="0,0,20,0">
        <ScrollViewer>
            <StackPanel Spacing="20">
                <TextBlock Text="Etiket Ayarları" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
                
                <StackPanel Spacing="8" x:CompileBindings="False">
                    <TextBlock Text="Ürün Seçimi" Foreground="#9CA3AF" FontSize="13"/>
                    <AutoCompleteBox ItemsSource="{Binding Stoklar}" 
                                     SelectedItem="{Binding SeciliStok}"
                                     Watermark="Ürün Ara..."
                                     FilterMode="Contains"
                                     MinimumPrefixLength="1">
                        <AutoCompleteBox.ItemTemplate>
                            <DataTemplate x:DataType="models:StokKart">
                                <TextBlock Text="{Binding StokAdi}"/>
                            </DataTemplate>
                        </AutoCompleteBox.ItemTemplate>
                    </AutoCompleteBox>
                </StackPanel>

                <Separator Background="#15FFFFFF"/>

                <Grid ColumnDefinitions="*, *">
                    <StackPanel Spacing="8" Grid.Column="0" Margin="0,0,5,0">
                        <TextBlock Text="Genişlik (mm)" Foreground="#9CA3AF" FontSize="13"/>
                        <NumericUpDown Value="{Binding EtiketGenislik}" Minimum="10" Maximum="200"/>
                    </StackPanel>
                    <StackPanel Spacing="8" Grid.Column="1" Margin="5,0,0,0">
                        <TextBlock Text="Yükseklik (mm)" Foreground="#9CA3AF" FontSize="13"/>
                        <NumericUpDown Value="{Binding EtiketYukseklik}" Minimum="10" Maximum="200"/>
                    </StackPanel>
                </Grid>

                <Separator Background="#15FFFFFF"/>

                <TextBlock Text="Görünürlük" Foreground="#9CA3AF" FontSize="13" Margin="0,5,0,0"/>
                <CheckBox IsChecked="{Binding ShowStokAdi}" Content="Ürün Adı Göster" Foreground="White"/>
                <CheckBox IsChecked="{Binding ShowFiyat}" Content="Fiyat Göster" Foreground="White"/>
                <CheckBox IsChecked="{Binding ShowBarkodNo}" Content="Barkod No Göster" Foreground="White"/>

                <Button Command="{Binding YazdirCommand}" Classes="SideButton Info" Height="50" HorizontalAlignment="Stretch" Margin="0,10,0,0" Background="#6366F1">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <ic:SymbolIcon Symbol="Print" FontSize="20"/> 
                        <TextBlock Text="YAZDIR" FontWeight="Bold"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </ScrollViewer>
      </Border>

      <!-- Preview -->
      <Border Grid.Column="1" Background="{DynamicResource PanelBrush}" CornerRadius="20" BorderBrush="#22FFFFFF" BorderThickness="1" Padding="40">
        <Grid>
            <TextBlock Text="ÖNİZLEME" HorizontalAlignment="Center" VerticalAlignment="Top" Opacity="0.3" FontWeight="Bold"/>
            
            <Viewbox MaxHeight="400">
                <Border Background="White" 
                        Width="{Binding EtiketGenislik, Converter={StaticResource MathMultiplyConverter}, ConverterParameter=3.78}" 
                        Height="{Binding EtiketYukseklik, Converter={StaticResource MathMultiplyConverter}, ConverterParameter=3.78}"
                        BoxShadow="0 10 30 0 #40000000">
                    <Grid>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="5">
                            <TextBlock Text="{Binding SeciliStok.StokAdi, FallbackValue='Ürün Adı Buraya Gelecek'}" 
                                       IsVisible="{Binding ShowStokAdi}"
                                       Foreground="Black" FontSize="12" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap"/>
                            
                            <!-- Placeholder Barcode -->
                            <StackPanel Spacing="2">
                                <Border Background="Black" Height="30" Width="100"/>
                                <TextBlock Text="{Binding SeciliStok.Barkod, FallbackValue='869000000000'}" 
                                           IsVisible="{Binding ShowBarkodNo}"
                                           Foreground="Black" FontSize="8" TextAlignment="Center"/>
                            </StackPanel>

                            <TextBlock Text="{Binding SeciliStok.SatisFiyati, FallbackValue='0.00 TL', StringFormat={}{0:N2} TL}" 
                                       IsVisible="{Binding ShowFiyat}"
                                       Foreground="Black" FontSize="14" FontWeight="Black" TextAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Viewbox>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
