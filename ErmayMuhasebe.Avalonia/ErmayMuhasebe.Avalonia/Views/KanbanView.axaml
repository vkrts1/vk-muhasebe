<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ErmayMuhasebe.Avalonia.ViewModels;assembly=ErmayMuhasebe.Avalonia"
             xmlns:ic="using:FluentIcons.Avalonia.Fluent"
             x:Class="ErmayMuhasebe.Avalonia.Views.KanbanView"
             x:DataType="vm:KanbanViewModel">
  <Grid RowDefinitions="Auto, *" Margin="30">
    <StackPanel Spacing="10" Margin="0,0,0,25">
      <StackPanel Orientation="Horizontal" Spacing="15">
        <Border Width="50" Height="50" CornerRadius="15" Background="#266366F1">
          <ic:SymbolIcon Symbol="Board" Foreground="#6366F1" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/> 
        </Border>
        <TextBlock Text="Görev ve İş Takip Panosu (Kanban)" FontSize="28" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
      </StackPanel>
      <TextBlock Text="Ekibinizin günlük işlerini ve önceliklerini görsel bir pano üzerinden yönetin." FontSize="15" Foreground="#9CA3AF" Margin="65,0,0,0"/>
    </StackPanel>

    <Grid Grid.Row="1" ColumnDefinitions="*, *, *">
       <!-- Todo -->
       <Border Grid.Column="0" Background="{DynamicResource PanelBrush}" CornerRadius="16" Padding="15" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
          <Grid RowDefinitions="Auto, *">
             <StackPanel Grid.Row="0" Margin="0,0,0,15" Spacing="10">
                 <TextBlock Text="YAPILACAKLAR" FontSize="14" FontWeight="Bold" Foreground="#9CA3AF" HorizontalAlignment="Center" LetterSpacing="1"/>
                 
                  <Border Background="#15FFFFFF" CornerRadius="8" Padding="2" BorderBrush="#33FFFFFF" BorderThickness="1">
                      <Grid ColumnDefinitions="*, Auto">
                         <TextBox Text="{Binding NewTaskTitle}" 
                                  Watermark="Yeni görev ekle..." 
                                  BorderThickness="0"
                                  Background="Transparent"
                                  VerticalContentAlignment="Center"
                                  Height="38"/>
                         <Button Grid.Column="1" Command="{Binding AddNewTaskCommand}" 
                                 Background="#6366F1" Width="34" Height="34" 
                                 Padding="0" CornerRadius="6" Margin="2">
                            <ic:SymbolIcon Symbol="Add" FontSize="18" Foreground="White"/>
                         </Button>
                      </Grid>
                  </Border>
             </StackPanel>

             <ScrollViewer Grid.Row="1">
                <ItemsControl ItemsSource="{Binding Todo}">
                   <ItemsControl.ItemTemplate>
                      <DataTemplate>
                         <Border Background="{DynamicResource PanelBrush}" CornerRadius="10" Padding="12" Margin="0,0,0,10" BoxShadow="0 2 8 0 #15000000" BorderBrush="#20FFFFFF" BorderThickness="1">
                            <StackPanel Spacing="8">
                               <SelectableTextBlock Text="{Binding Title}" Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap" FontSize="13"/>
                               
                               <Grid ColumnDefinitions="*, Auto">
                                  <TextBlock Text="{Binding User}" FontSize="10" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                                  <Border Grid.Column="1" Background="{Binding Color}" Opacity="0.2" CornerRadius="4" Padding="6,2">
                                     <TextBlock Text="{Binding Priority}" FontSize="9" Foreground="{Binding Color}" FontWeight="Bold"/>
                                  </Border>
                               </Grid>

                               <Grid ColumnDefinitions="Auto, *, Auto" Margin="0,5,0,0">
                                   <!-- Delete -->
                                   <Button Grid.Column="0" Command="{Binding $parent[UserControl].DataContext.DeleteConfirmCommand}" CommandParameter="{Binding}" 
                                           Background="Transparent" BorderThickness="0" Padding="5" Width="25" Height="25">
                                       <ic:SymbolIcon Symbol="Delete" FontSize="14" Foreground="#EF4444"/> 
                                   </Button>
                                   
                                   <!-- Move Next -->
                                   <Button Grid.Column="2" Command="{Binding $parent[UserControl].DataContext.MoveToNextCommand}" CommandParameter="{Binding}" 
                                           Background="Transparent" BorderThickness="0" Padding="5" Width="25" Height="25">
                                        <ic:SymbolIcon Symbol="ArrowRight" FontSize="14" Foreground="#10B981"/>
                                   </Button>
                               </Grid>
                            </StackPanel>
                         </Border>
                      </DataTemplate>
                   </ItemsControl.ItemTemplate>
                </ItemsControl>
             </ScrollViewer>
          </Grid>
       </Border>

       <!-- In Progress -->
       <Border Grid.Column="1" Background="{DynamicResource PanelBrush}" CornerRadius="16" Padding="15" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Margin="15,0">
          <Grid RowDefinitions="Auto, *">
             <TextBlock Grid.Row="0" Text="DEVAM EDENLER" FontSize="14" FontWeight="Bold" Foreground="#F59E0B" HorizontalAlignment="Center" LetterSpacing="1" Margin="0,0,0,15"/>

             <ScrollViewer Grid.Row="1">
                <ItemsControl ItemsSource="{Binding InProgress}">
                   <ItemsControl.ItemTemplate>
                      <DataTemplate>
                         <Border Background="{DynamicResource PanelBrush}" CornerRadius="10" Padding="12" Margin="0,0,0,10" BoxShadow="0 2 8 0 #15000000" BorderBrush="#20FFFFFF" BorderThickness="1">
                            <StackPanel Spacing="8">
                               <SelectableTextBlock Text="{Binding Title}" Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap" FontSize="13"/>
                               
                               <Grid ColumnDefinitions="*, Auto">
                                  <TextBlock Text="{Binding User}" FontSize="10" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                                  <Border Grid.Column="1" Background="{Binding Color}" Opacity="0.2" CornerRadius="4" Padding="6,2">
                                     <TextBlock Text="{Binding Priority}" FontSize="9" Foreground="{Binding Color}" FontWeight="Bold"/>
                                  </Border>
                               </Grid>

                               <Grid ColumnDefinitions="Auto, *, Auto" Margin="0,5,0,0">
                                   <!-- Delete -->
                                   <Button Grid.Column="0" Command="{Binding $parent[UserControl].DataContext.DeleteConfirmCommand}" CommandParameter="{Binding}" 
                                           Background="Transparent" BorderThickness="0" Padding="5" Width="25" Height="25">
                                       <ic:SymbolIcon Symbol="Delete" FontSize="14" Foreground="#EF4444"/> 
                                   </Button>
                                   
                                   <!-- Move Next (Complete) -->
                                   <Button Grid.Column="2" Command="{Binding $parent[UserControl].DataContext.MoveToNextCommand}" CommandParameter="{Binding}" 
                                           Background="Transparent" BorderThickness="0" Padding="5" Width="25" Height="25">
                                        <ic:SymbolIcon Symbol="Checkmark" FontSize="14" Foreground="#10B981"/>
                                   </Button>
                               </Grid>
                            </StackPanel>
                         </Border>
                      </DataTemplate>
                   </ItemsControl.ItemTemplate>
                </ItemsControl>
             </ScrollViewer>
          </Grid>
       </Border>

       <!-- Done -->
       <Border Grid.Column="2" Background="{DynamicResource PanelBrush}" CornerRadius="16" Padding="15" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
          <Grid RowDefinitions="Auto, *">
             <TextBlock Grid.Row="0" Text="TAMAMLANANLAR" FontSize="14" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Center" LetterSpacing="1" Margin="0,0,0,15"/>

             <ScrollViewer Grid.Row="1">
                <ItemsControl ItemsSource="{Binding Done}">
                   <ItemsControl.ItemTemplate>
                      <DataTemplate>
                         <Border Background="{DynamicResource PanelBrush}" CornerRadius="10" Padding="12" Margin="0,0,0,10" Opacity="0.6" BorderBrush="#20FFFFFF" BorderThickness="1">
                            <Grid ColumnDefinitions="*, Auto">
                                <StackPanel Spacing="5">
                                   <SelectableTextBlock Text="{Binding Title}" Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap" TextDecorations="Strikethrough" FontSize="13"/>
                                   <TextBlock Text="{Binding User}" FontSize="10" Foreground="#9CA3AF"/>
                                </StackPanel>
                                
                                <Button Grid.Column="1" Command="{Binding $parent[UserControl].DataContext.DeleteConfirmCommand}" CommandParameter="{Binding}" 
                                        Background="Transparent" BorderThickness="0" Padding="5" Width="25" Height="25" VerticalAlignment="Center">
                                   <ic:SymbolIcon Symbol="Delete" FontSize="14" Foreground="#EF4444"/> 
                                </Button>
                            </Grid>
                         </Border>
                      </DataTemplate>
                   </ItemsControl.ItemTemplate>
                </ItemsControl>
             </ScrollViewer>
          </Grid>
       </Border>
    </Grid>

    <!-- DELETE/ACTION CONFIRMATION OVERLAY -->
    <Grid Grid.RowSpan="2" Background="#E6000000" IsVisible="{Binding IsConfirmVisible}">
         <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="16" Width="400" VerticalAlignment="Center" HorizontalAlignment="Center" BoxShadow="0 20 60 0 #CC000000" ClipToBounds="True">
             <Grid RowDefinitions="Auto, *">
                  <Border Grid.Row="0" Background="#26FF416C" Padding="20,12">
                      <StackPanel Orientation="Horizontal" Spacing="12">
                          <ic:SymbolIcon Symbol="Delete" Foreground="White" FontSize="20"/> 
                          <TextBlock Text="Onay Gerekiyor" FontWeight="Bold" FontSize="15" Foreground="White" VerticalAlignment="Center"/>
                      </StackPanel>
                  </Border>

                  <StackPanel Grid.Row="1" Margin="30" Spacing="25">
                      <ic:SymbolIcon Symbol="Warning" Foreground="#FF416C" FontSize="48" HorizontalAlignment="Center"/> 
                      <StackPanel Spacing="8">
                          <TextBlock Text="{Binding ConfirmTitle}" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" FontSize="18"/>
                          <TextBlock Text="{Binding ConfirmMessage}" Foreground="#BBB" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" FontSize="13"/>
                      </StackPanel>
                      
                      <Grid ColumnDefinitions="*,*" Margin="0,10,0,0">
                          <Button Grid.Column="0" Classes="SideButton Danger" Command="{Binding ConfirmYesCommand}" Margin="0,0,5,0" Height="45">
                              <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                  <ic:SymbolIcon Symbol="Checkmark" FontSize="18" VerticalAlignment="Center"/> 
                                  <TextBlock Text="EVET, SİL" FontWeight="Bold" VerticalAlignment="Center" FontSize="12"/>
                              </StackPanel>
                          </Button>
                          <Button Grid.Column="1" Classes="SideButton Secondary" Command="{Binding ConfirmNoCommand}" Margin="5,0,0,0" Height="45">
                               <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                  <ic:SymbolIcon Symbol="Dismiss" FontSize="18" VerticalAlignment="Center"/> 
                                  <TextBlock Text="VAZGEÇ" FontWeight="Bold" VerticalAlignment="Center" FontSize="12"/>
                               </StackPanel>
                          </Button>
                      </Grid>
                  </StackPanel>
             </Grid>
         </Border>
    </Grid>
  </Grid>
</UserControl>
