<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ErmayMuhasebe.Avalonia.ViewModels;assembly=ErmayMuhasebe.Avalonia"
             xmlns:ic="using:FluentIcons.Avalonia.Fluent"
             xmlns:conv="using:ErmayMuhasebe.Avalonia.Converters"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="500"
             x:Class="ErmayMuhasebe.Avalonia.Views.CariSelectionDialog"
             x:DataType="vm:CariListViewModel">

    <UserControl.Resources>
        <conv:BakiyeToColorConverter x:Key="BakiyeToColorConverter"/>
    </UserControl.Resources>

     <Grid Background="#CC000000">
         <Border Background="#080A0C" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="12"
                 Width="600" Height="500" VerticalAlignment="Center" HorizontalAlignment="Center" ClipToBounds="True">
             <Grid RowDefinitions="Auto, *, Auto">
                 <!-- Header -->
                 <Border Grid.Row="0" Background="#050607" Padding="20,15">
                     <Grid ColumnDefinitions="*, Auto">
                         <StackPanel Orientation="Horizontal" Spacing="10">
                             <ic:SymbolIcon Symbol="PeopleSearch" FontSize="20" Foreground="#60A5FA"/>
                             <TextBlock Text="Hesap Seçimi" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                         </StackPanel>
                         <Button Grid.Column="1" Command="{Binding CloseCariSelectionCommand}" 
                                 Background="#0E1113" CornerRadius="15" Width="30" Height="30" Padding="0">
                             <ic:SymbolIcon Symbol="Dismiss" FontSize="14" Foreground="#DDD"/>
                         </Button>
                     </Grid>
                 </Border>
                 
                 <!-- List -->
                 <DataGrid Grid.Row="1" ItemsSource="{Binding FilteredCarilerForSelection}" AutoGenerateColumns="False" 
                           IsReadOnly="True" GridLinesVisibility="Horizontal" Height="360"
                           Background="#151515" RowBackground="Transparent" HeadersVisibility="Column"
                           DoubleTapped="OnDoubleTapped">
                     <DataGrid.Columns>
                         <DataGridTemplateColumn Header="Tipi" Width="90">
                             <DataTemplate>
                                 <Border CornerRadius="4" Padding="6,2" VerticalAlignment="Center" HorizontalAlignment="Left" Background="{Binding Grup, Converter={StaticResource CariTurToBrushConverter}}">
                                     <TextBlock Text="{Binding Grup}" FontSize="10" Foreground="White" FontWeight="SemiBold"/>
                                 </Border>
                             </DataTemplate>
                         </DataGridTemplateColumn>
                         <DataGridTemplateColumn Header="Ünvan" Width="*">
                            <DataTemplate>
                                <TextBlock Text="{Binding Unvan}" VerticalAlignment="Center" Margin="5,0" FontWeight="Medium"/>
                            </DataTemplate>
                         </DataGridTemplateColumn>
                         <DataGridTemplateColumn Header="Bakiye" Width="120">
                            <DataTemplate>
                                <TextBlock Text="{Binding Bakiye, StringFormat='N2'}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                                           Foreground="{Binding Bakiye, Converter={StaticResource BakiyeToColorConverter}}" FontWeight="Bold"/>
                            </DataTemplate>
                         </DataGridTemplateColumn>
                         <DataGridTemplateColumn Width="90">
                             <DataTemplate>
                                 <Button Command="{Binding DataContext.SelectCariForTransactionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                         CommandParameter="{Binding .}"
                                         Content="Seç" Padding="15,5" FontSize="11" CornerRadius="15" Height="30"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                         Background="Transparent" BorderBrush="#60A5FA" BorderThickness="1" Foreground="#60A5FA">
                                      <Button.Styles>
                                          <Style Selector="Button:pointerover">
                                              <Setter Property="Background" Value="#1A60A5FA"/>
                                          </Style>
                                      </Button.Styles>
                                 </Button>
                             </DataTemplate>
                         </DataGridTemplateColumn>
                     </DataGrid.Columns>
                 </DataGrid>
                 
                 <!-- Footer -->
                 <Border Grid.Row="2" Background="#11FFFFFF" Padding="15">
                     <Button Command="{Binding CloseCariSelectionCommand}" Content="Vazgeç" HorizontalAlignment="Right" Classes="SideButton Secondary" Width="100" Height="36" FontSize="12"/>
                 </Border>
             </Grid>
         </Border>
     </Grid>
</UserControl>
