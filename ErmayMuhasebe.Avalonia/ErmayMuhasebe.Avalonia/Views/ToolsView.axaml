<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ErmayMuhasebe.Avalonia.ViewModels;assembly=ErmayMuhasebe.Avalonia"
             xmlns:ic="using:FluentIcons.Avalonia.Fluent"
             xmlns:conv="using:ErmayMuhasebe.Avalonia.Converters"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="ErmayMuhasebe.Avalonia.Views.ToolsView"
             x:DataType="vm:ToolsViewModel">
    
    <UserControl.Resources>
      <conv:SymbolIconConverter x:Key="SymbolIconConverter"/>
    </UserControl.Resources>


    <Grid Background="{DynamicResource BackgroundBrush}">
        <Grid RowDefinitions="Auto, *" Margin="30">
            <!-- Header Section -->
            <Border Grid.Row="0" Margin="0,0,0,30">
                <Grid ColumnDefinitions="*, Auto">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="20">
                            <Border Width="55" Height="55" CornerRadius="16" Background="rgba(96, 165, 250, 0.15)">
                                <ic:SymbolIcon Symbol="Wrench" Foreground="#60A5FA" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/> 
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Araçlar ve Modüller" FontSize="30" FontWeight="Black" Foreground="White"/>
                                <TextBlock Text="İşletmenizin dijital dönüşümünde size yardımcı olacak interaktif araçlar." FontSize="15" Foreground="#9CA3AF"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Tools Grid -->
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Tools}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ToolItem">
                            <Button Command="{Binding $parent[UserControl].DataContext.OpenToolCommand}" 
                                    CommandParameter="{Binding}"
                                    Background="Transparent" 
                                    BorderThickness="0" 
                                    Padding="0" 
                                    Width="370" 
                                    Height="220" 
                                    Margin="0,0,10,10"
                                    Theme="{x:Null}">
                                <Button.Styles>
                                    <Style Selector="Button">
                                        <Setter Property="Template">
                                            <ControlTemplate>
                                                <Panel>
                                                    <ContentPresenter Name="PART_ContentPresenter"
                                                                      Background="{TemplateBinding Background}"
                                                                      BorderBrush="{TemplateBinding BorderBrush}"
                                                                      BorderThickness="{TemplateBinding BorderThickness}"
                                                                      CornerRadius="{TemplateBinding CornerRadius}"
                                                                      Content="{TemplateBinding Content}"
                                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                      Padding="{TemplateBinding Padding}"
                                                                      HorizontalContentAlignment="Stretch"
                                                                      VerticalContentAlignment="Stretch"/>
                                                </Panel>
                                            </ControlTemplate>
                                        </Setter>
                                    </Style>
                                    <Style Selector="Button:pointerover /template/ ContentPresenter">
                                        <Setter Property="Background" Value="Transparent"/>
                                    </Style>
                                    <Style Selector="Button:pressed /template/ ContentPresenter">
                                        <Setter Property="Background" Value="Transparent"/>
                                    </Style>
                                    <Style Selector="Button:pointerover Border#CardBorder">
                                        <Setter Property="BorderBrush" Value="{Binding Color}"/>
                                        <Setter Property="RenderTransform" Value="scale(1.02)"/>
                                    </Style>
                                </Button.Styles>
                                <Border Name="CardBorder" Margin="10" Background="{DynamicResource PanelBrush}" 
                                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="1.5" 
                                        CornerRadius="20" Padding="24">
                                    <Border.Transitions>
                                        <Transitions>
                                            <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2"/>
                                            <BrushTransition Property="Background" Duration="0:0:0.2"/>
                                            <BrushTransition Property="BorderBrush" Duration="0:0:0.2"/>
                                        </Transitions>
                                    </Border.Transitions>
                                    <Grid RowDefinitions="Auto, *, Auto">
                                        <!-- Top Icon and Badge -->
                                        <Grid Grid.Row="0" ColumnDefinitions="Auto, *">
                                            <Panel Grid.Column="0">
                                                <Border Width="48" Height="48" CornerRadius="14" Background="{Binding Color}" Opacity="0.15"/>
                                                <ic:SymbolIcon Symbol="{Binding Icon, Converter={StaticResource SymbolIconConverter}}" 
                                                               Foreground="{Binding Color}" FontSize="24" 
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/> 
                                            </Panel>
                                            
                                            <Border Grid.Column="1" IsVisible="{Binding IsImplemented}" 
                                                    Background="{DynamicResource FluidGreenGradient}" CornerRadius="8" Padding="6,2" 
                                                    HorizontalAlignment="Right" VerticalAlignment="Top">
                                                <TextBlock Text="AKTİF" FontSize="10" FontWeight="Black" Foreground="White"/>
                                            </Border>
                                        </Grid>
                                        
                                        <!-- Main Content -->
                                        <StackPanel Grid.Row="1" Margin="0,15,0,0" Spacing="5">
                                            <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="Bold" Foreground="White" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#9CA3AF" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <!-- Footer Status -->
                                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Bottom" Margin="0,10,0,0">
                                            <Ellipse Width="7" Height="7" Fill="{Binding Color}"/>
                                            <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding Color}" Opacity="0.8"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

    </Grid>
</UserControl>
