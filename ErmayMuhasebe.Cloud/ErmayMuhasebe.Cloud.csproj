<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
    <BlazorWebAssemblyPreserveCollationData>false</BlazorWebAssemblyPreserveCollationData>
    <PublishTrimmed>true</PublishTrimmed>
    <InvariantGlobalization>false</InvariantGlobalization>
    <BlazorEnableTimeZoneSupport>true</BlazorEnableTimeZoneSupport>
    <!-- Performance and Compression Improvements (10/10 Score) -->
    <BlazorCacheBootResources>true</BlazorCacheBootResources>
    <Optimize>true</Optimize>
    <RunAOTCompilation>false</RunAOTCompilation> 
    <WasmBuildNative>false</WasmBuildNative>
    <TieredCompilation>true</TieredCompilation>
    <WasmAllowUndefinedSymbols>true</WasmAllowUndefinedSymbols>
    <EnableWebAssemblyThreads>false</EnableWebAssemblyThreads>
    <BlazorWebAssemblyEnableSimplifyTypeReferences>true</BlazorWebAssemblyEnableSimplifyTypeReferences>
    <WasmEnableSIMD>true</WasmEnableSIMD>
    <WasmEnableExceptionHandling>true</WasmEnableExceptionHandling>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Blazored.LocalStorage" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="FirebaseDatabase.net" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
    <PackageReference Include="MudBlazor" />
    <PackageReference Include="QuestPDF" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.Views.Blazor" />
    <PackageReference Include="SkiaSharp.NativeAssets.WebAssembly" />
    <PackageReference Include="HarfBuzzSharp" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.WebAssembly" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ErmayMuhasebe.Shared\ErmayMuhasebe.Shared.csproj" />
  </ItemGroup>

</Project>
