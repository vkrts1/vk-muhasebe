@page "/belge-arsiv"
@using MudBlazor
@using ErmayMuhasebe.Models
@using ErmayMuhasebe.Repositories
@using System.IO
@inject ISnackbar Snackbar
@inject IUnitOfWork Uow
@inject IJSRuntime JSRuntime

<div class="dms-container fade-in @(_selectedDoc != null ? "with-preview" : "")" 
     @ondragover:preventDefault @ondragover="HandleDragOver" @ondragleave="HandleDragLeave" @ondrop:preventDefault @ondrop="HandleDrop">
    
    @if (_isDragging)
    {
        <div class="drag-overlay">
            <div class="drag-box">
                <MudIcon Icon="@Icons.Material.Filled.CloudUpload" Style="font-size: 64px; color: #8B5CF6;" />
                <span class="mt-4">Dosyayı Buraya Bırakın</span>
            </div>
        </div>
    }

    <!-- Header Area -->
    <div class="dms-header mb-6">
        <div class="d-flex align-center gap-4">
            <div class="header-icon-box">
                <MudIcon Icon="@Icons.Material.Filled.FolderZip" Style="font-size: 26px; color: white;" />
            </div>
            <div>
                <h2 class="dms-title">Belge Arşivleme (DMS)</h2>
                <p class="dms-subtitle">Fatura, dekont ve diğer tüm resmi evraklarınızı dijital ortamda saklayın.</p>
            </div>
        </div>
    </div>

    <!-- Toolbar Area -->
    <div class="dms-toolbar mb-4">
        <div class="search-wrapper">
            <MudIcon Icon="@Icons.Material.Filled.Search" Class="search-icon" />
            <input type="text" placeholder="Belge adında ara..." @bind-value="_searchString" @bind-value:event="oninput" @onkeyup="ApplyFilter" class="dms-search-input" />
        </div>
        
        <div class="dms-stats-box">
            <span>Toplam: @_allDocs.Count Belge</span>
            <span class="mx-2">|</span>
            <span>Alan: @CalculateTotalSize() MB</span>
        </div>

        <MudFileUpload T="IBrowserFile" FilesChanged="OnFilesChanged" Accept=".pdf,.jpg,.jpeg,.png,.doc,.docx,.txt" Class="flex-grow-0">
            <ActivatorContent>
                <button class="dms-upload-btn">
                    <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" Class="me-1" />
                    YENİ BELGE YÜKLE
                </button>
            </ActivatorContent>
        </MudFileUpload>
    </div>

    <!-- Content Table Panel -->
    <div class="dms-table-panel glass-morphism">
        <table class="dms-table">
            <thead>
                <tr>
                    <th style="width: 40px;"></th>
                    <th>Belge Adı</th>
                    <th style="width: 100px;">Tür</th>
                    <th style="width: 120px;">Boyut</th>
                    <th style="width: 180px;">Kayıt Tarihi</th>
                    <th style="width: 100px;" class="text-center">İşlem</th>
                </tr>
            </thead>
            <tbody>
                @if (!_filteredDocs.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center p-8 opacity-50">Kayıtlı belge bulunamadı.</td>
                    </tr>
                }
                @foreach (var doc in _filteredDocs)
                {
                    <tr class="dms-row @(_selectedDoc == doc ? "selected" : "")" @onclick="() => _selectedDoc = doc" style="cursor: pointer;">
                        <td class="text-center">
                            <MudIcon Icon="@GetDocIcon(doc.Tur)" Style="font-size: 18px; color: #8B5CF6;" />
                        </td>
                        <td class="doc-name">@doc.Ad</td>
                        <td class="doc-type">@((doc.Tur ?? "UNK").ToUpper())</td>
                        <td class="doc-size">@doc.Boyut</td>
                        <td class="doc-date">@doc.Tarih.ToString("dd.MM.yyyy HH:mm:ss")</td>
                        <td>
                            <div class="d-flex justify-center gap-3">
                                <button class="dms-action-btn view" title="Görüntüle" @onclick="() => DownloadDoc(doc, false)">
                                    <MudIcon Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small" />
                                </button>
                                <button class="dms-action-btn download" title="İndir" @onclick="() => DownloadDoc(doc, true)">
                                    <MudIcon Icon="@Icons.Material.Filled.FileDownload" Size="Size.Small" />
                                </button>
                                <button class="dms-action-btn delete" title="Sil" @onclick="() => DeleteDoc(doc)">
                                    <MudIcon Icon="@Icons.Material.Filled.Delete" Size="Size.Small" />
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Preview Sidebar -->
    @if (_selectedDoc != null)
    {
        <div class="dms-preview-sidebar">
            <div class="preview-header">
                <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="() => _selectedDoc = null" Size="Size.Small" />
                <span class="preview-title">Belge Önizleme</span>
            </div>
            <div class="preview-body">
                @if (IsImage(_selectedDoc.Tur))
                {
                    <img src="@GetBase64Src(_selectedDoc)" style="width: 100%; border-radius: 12px;" />
                }
                else if (_selectedDoc.Tur?.ToLower() == "pdf")
                {
                    <iframe src="@GetBase64Src(_selectedDoc)" style="width: 100%; height: 500px; border: none; border-radius: 12px;"></iframe>
                }
                else
                {
                    <div class="no-preview">
                        <MudIcon Icon="@GetDocIcon(_selectedDoc.Tur)" Style="font-size: 64px; opacity: 0.2;" />
                        <span>Bu belge türü için önizleme desteklenmiyor.</span>
                    </div>
                }

                <div class="preview-info mt-6">
                    <div class="info-row"><span>Belge Adı:</span> <strong>@_selectedDoc.Ad</strong></div>
                    <div class="info-row"><span>Kategori:</span> <strong>@_selectedDoc.Kategori</strong></div>
                    <div class="info-row"><span>Tarih:</span> <strong>@_selectedDoc.Tarih.ToString("f")</strong></div>
                </div>
            </div>
            <div class="preview-footer">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" OnClick="() => DownloadDoc(_selectedDoc, true)">DOSYAYI İNDİR</MudButton>
            </div>
        </div>
    }
</div>

@code {
    private List<BelgeArsiv> _allDocs = new();
    private List<BelgeArsiv> _filteredDocs = new();
    private string _searchString = "";
    private BelgeArsiv? _selectedDoc;
    private bool _isDragging = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadDocs();
    }

    private async Task LoadDocs()
    {
        _allDocs = await Uow.BelgeArsiv.GetAllAsync();
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        if (string.IsNullOrWhiteSpace(_searchString))
        {
            _filteredDocs = _allDocs;
        }
        else
        {
            _filteredDocs = _allDocs.Where(x => (x.Ad ?? "").Contains(_searchString, StringComparison.OrdinalIgnoreCase)).ToList();
        }
        StateHasChanged();
    }

    private string CalculateTotalSize()
    {
        try
        {
            // Simple parsing of "1.23 MB" strings
            double totalMb = 0;
            foreach (var doc in _allDocs)
            {
                if (string.IsNullOrEmpty(doc.Boyut)) continue;
                var clean = doc.Boyut.Replace(" MB", "").Replace(" KB", "").Replace(" Bytes", "").Trim();
                if (double.TryParse(clean, out double val))
                {
                    if (doc.Boyut.Contains("KB")) totalMb += val / 1024.0;
                    else if (doc.Boyut.Contains("Bytes")) totalMb += val / 1024.0 / 1024.0;
                    else totalMb += val;
                }
            }
            return totalMb.ToString("N2");
        }
        catch { return "0,00"; }
    }

    private string GetDocIcon(string? type) => (type?.ToLower()) switch {
        "pdf" => Icons.Material.Filled.PictureAsPdf,
        "png" or "jpg" or "jpeg" => Icons.Material.Filled.Image,
        "doc" or "docx" => Icons.Material.Filled.Description,
        "txt" => Icons.Material.Filled.Article,
        _ => Icons.Material.Filled.InsertDriveFile
    };

    private async Task OnFilesChanged(IBrowserFile file)
    {
        if (file == null) return;

        try
        {
            if (file.Size > 10 * 1024 * 1024)
            {
                Snackbar.Add("Dosya boyutu 10MB'dan büyük olamaz.", Severity.Warning);
                return;
            }

            var buffer = new byte[(int)file.Size];
            await file.OpenReadStream(10 * 1024 * 1024).ReadAsync(buffer);
            var base64Data = Convert.ToBase64String(buffer);

            var newDoc = new BelgeArsiv
            {
                Ad = file.Name,
                Tur = Path.GetExtension(file.Name)?.Replace(".", "") ?? "unk",
                Boyut = GetFriendlySize(file.Size),
                Kategori = "Genel",
                Tarih = DateTime.Now,
                Veri = base64Data
            };

            await Uow.BelgeArsiv.SaveAsync(newDoc);
            Snackbar.Add("Belge başarıyla yüklendi.", Severity.Success);
            await LoadDocs();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Yükleme hatası: {ex.Message}", Severity.Error);
        }
    }

    private string GetFriendlySize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} Bytes";
        if (bytes < 1024 * 1024) return $"{(bytes / 1024.0):N0} KB";
        return $"{(bytes / 1024.0 / 1024.0):N2} MB";
    }

    private async Task DownloadDoc(BelgeArsiv doc, bool forceDownload)
    {
        if (string.IsNullOrEmpty(doc.Veri))
        {
            Snackbar.Add("Dosya verisi bulunamadı.", Severity.Error);
            return;
        }

        try
        {
            var fileName = doc.Ad ?? "belge";
            var contentType = GetContentType(doc.Tur);
            await JSRuntime.InvokeVoidAsync("downloadFile", fileName, contentType, doc.Veri);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Hata: {ex.Message}", Severity.Error);
        }
    }

    private async Task DeleteDoc(BelgeArsiv doc)
    {
        bool? confirm = await JSRuntime.InvokeAsync<bool>("confirm", $"{doc.Ad} kalıcı olarak silinecektir. Emin misiniz?");
        if (confirm == true)
        {
            await Uow.BelgeArsiv.DeleteAsync(doc);
            Snackbar.Add("Belge silindi.", Severity.Info);
            await LoadDocs();
        }
    }

    private string GetContentType(string? ext) => (ext?.ToLower()) switch {
        "pdf" => "application/pdf",
        "png" => "image/png",
        "jpg" or "jpeg" => "image/jpeg",
        "txt" => "text/plain",
        "doc" or "docx" => "application/msword",
        _ => "application/octet-stream"
    };

    private bool IsImage(string? ext) => new[] { "jpg", "jpeg", "png", "gif" }.Contains(ext?.ToLower());
    private string GetBase64Src(BelgeArsiv doc) => $"data:{GetContentType(doc.Tur)};base64,{doc.Veri}";

    private void HandleDragOver() => _isDragging = true;
    private void HandleDragLeave() => _isDragging = false;
    private async Task HandleDrop(DragEventArgs e)
    {
        _isDragging = false;
        // Drag-drop for files in Blazor Server/WASM needs careful JS interop or MudFileUpload 
        // For simplicity in this demo, we notify user that they should use the upload button
        // Or if I had more time, I'd implement the JS interop for InputFile drop.
        Snackbar.Add("Lütfen 'YENİ BELGE YÜKLE' butonunu veya sürükle-bırak alanını kullanın.", Severity.Info);
    }
}

<style>
    .dms-container {
        padding: 30px 40px 30px 60px !important;
        background: #0B0D12;
        min-height: 100vh;
        color: white;
        font-family: 'Inter', sans-serif;
    }

    .header-icon-box {
        width: 48px;
        height: 48px;
        background: rgba(139, 92, 246, 0.2);
        border: 1px solid rgba(139, 92, 246, 0.4);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .dms-title { font-size: 24px; font-weight: 800; color: white; margin: 0; }
    .dms-subtitle { font-size: 14px; color: #9CA3AF; margin-top: 2px; }

    .dms-toolbar {
        display: flex;
        align-items: center;
        gap: 20px;
        margin-top: 30px;
    }

    .search-wrapper {
        position: relative;
        flex: 1;
        max-width: 500px;
    }

    .dms-search-input {
        width: 100%;
        height: 44px;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 22px;
        padding: 0 20px 0 45px;
        color: white;
        font-size: 14px;
        outline: none;
        transition: all 0.2s;
    }

    .dms-search-input:focus {
        background: rgba(255, 255, 255, 0.06);
        border-color: #8B5CF6;
    }

    .search-icon {
        position: absolute;
        left: 15px;
        top: 50%;
        transform: translateY(-50%);
        color: #6B7280;
        font-size: 20px;
    }

    .dms-stats-box {
        font-size: 13px;
        color: #9CA3AF;
        background: rgba(255, 255, 255, 0.02);
        padding: 8px 16px;
        border-radius: 10px;
    }

    .dms-upload-btn {
        background: #8B5CF6;
        color: white;
        height: 44px;
        padding: 0 24px;
        border: none;
        border-radius: 22px;
        font-weight: 700;
        font-size: 13px;
        display: flex;
        align-items: center;
        transition: all 0.2s;
        box-shadow: 0 4px 15px rgba(139, 92, 246, 0.3);
    }

    .dms-upload-btn:hover {
        background: #7C3AED;
        transform: translateY(-2px);
    }

    .glass-morphism {
        background: rgba(26, 31, 44, 0.4);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.05);
        border-radius: 16px;
        overflow: hidden;
    }

    .dms-table {
        width: 100%;
        border-collapse: collapse;
    }

    .dms-table th {
        background: rgba(0, 0, 0, 0.2);
        padding: 14px 20px;
        text-align: left;
        font-size: 12px;
        font-weight: 600;
        color: #9CA3AF;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .dms-row {
        border-bottom: 1px solid rgba(255, 255, 255, 0.03);
        transition: background 0.1s;
    }

    .dms-row:hover {
        background: rgba(255, 255, 255, 0.02);
    }

    .dms-table td {
        padding: 16px 20px;
        font-size: 14px;
    }

    .doc-name { font-weight: 500; color: #E5E7EB; }
    .doc-type { color: #9CA3AF; font-size: 12px; }
    .doc-size { color: #9CA3AF; font-size: 12px; }
    .doc-date { color: #6B7280; font-size: 12px; }

    .dms-action-btn {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        border: none;
        background: rgba(255, 255, 255, 0.05);
        color: #9CA3AF;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s;
    }

    .dms-action-btn:hover {
        background: rgba(255, 255, 255, 0.1);
        color: white;
    }

    .dms-action-btn.view:hover { color: #3B82F6; background: rgba(59, 130, 246, 0.1); }
    .dms-action-btn.download:hover { color: #10B981; background: rgba(16, 189, 129, 0.1); }
    .dms-action-btn.delete:hover { color: #EF4444; background: rgba(239, 68, 68, 0.1); }

    .fade-in {
        animation: fadeIn 0.4s ease-out;
    }

    @@keyframes fadeIn {
        to { opacity: 1; transform: translateY(0); }
    }

    /* Preview Sidebar Styles */
    .with-preview { padding-right: 440px !important; }
    
    .dms-preview-sidebar {
        position: fixed;
        top: 0;
        right: 0;
        bottom: 0;
        width: 400px;
        background: #141824;
        border-left: 1px solid rgba(255,255,255,0.1);
        z-index: 100;
        display: flex;
        flex-direction: column;
        box-shadow: -20px 0 50px rgba(0,0,0,0.5);
        animation: slideInRight 0.3s ease-out;
    }

    .preview-header {
        padding: 20px;
        display: flex;
        align-items: center;
        gap: 15px;
        border-bottom: 1px solid rgba(255,255,255,0.05);
    }

    .preview-title { font-weight: 800; color: white; font-size: 16px; }

    .preview-body { flex: 1; padding: 25px; overflow-y: auto; }

    .preview-footer { padding: 20px; border-top: 1px solid rgba(255,255,255,0.05); }

    .info-row { display: flex; justify-content: space-between; margin-bottom: 8px; font-size: 13px; color: rgba(255,255,255,0.6); }

    .dms-row.selected { background: rgba(139, 92, 246, 0.1) !important; }

    .drag-overlay {
        position: absolute;
        inset: 0;
        background: rgba(139, 92, 246, 0.1);
        border: 4px dashed #8B5CF6;
        z-index: 1000;
        display: flex;
        align-items: center;
        justify-content: center;
        backdrop-filter: blur(4px);
    }
    .drag-box { text-align: center; }

    @@keyframes slideInRight {
        from { transform: translateX(100%); }
        to { transform: translateX(0); }
    }
</style>
