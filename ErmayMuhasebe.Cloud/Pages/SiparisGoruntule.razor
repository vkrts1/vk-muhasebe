@page "/siparis-goruntule/{Id:int}"
@layout EmptyLayout
@using MudBlazor
@using ErmayMuhasebe.Models
@using ErmayMuhasebe.Cloud.Services
@inject ClientDatabaseService DbService
@inject NavigationManager NavManager
@inject IJSRuntime JS

<div class="invoice-wrapper pa-10">
    <div class="no-print d-flex gap-2 mb-6">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="PrintWindow" StartIcon="@Icons.Material.Filled.Print">Yazdır / PDF</MudButton>
        <MudButton Variant="Variant.Outlined" OnClick="GoBack" StartIcon="@Icons.Material.Filled.ArrowBack">Geri Dön</MudButton>
    </div>

    @if (_loading)
    {
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
    }
    else if (_siparis == null)
    {
        <MudAlert Severity="Severity.Error">Sipariş verisi yüklenemedi.</MudAlert>
    }
    else
    {
        <div class="invoice-box">
            <table cellpadding="0" cellspacing="0" style="width: 100%;">
                <tr class="top">
                    <td colspan="2">
                        <table>
                            <tr>
                                <td class="title">
                                    @if (!string.IsNullOrEmpty(_firma?.LogoUrl))
                                    {
                                        <img src="@_firma.LogoUrl" style="width: 100%; max-width: 200px" />
                                    }
                                    else
                                    {
                                        <MudText Typo="Typo.h4" Class="font-weight-bold" Style="color: #3b82f6;">ERMAY CLOUD</MudText>
                                    }
                                </td>
                                <td style="text-align: right;">
                                    <MudText Typo="Typo.h5" Class="font-weight-bold">SİPARİŞ FORMU</MudText>
                                    <MudText Typo="Typo.body2">No: <b>@_siparis.SiparisNo</b></MudText>
                                    <MudText Typo="Typo.body2">Tarih: <b>@_siparis.Tarih.ToString("dd.MM.yyyy")</b></MudText>
                                    <MudText Typo="Typo.body2">Durum: <b>@_siparis.Durum</b></MudText>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>

                <tr class="information">
                    <td colspan="2">
                        <table>
                            <tr>
                                <td>
                                    <MudText Typo="Typo.subtitle2" Class="font-weight-bold">TEDARİKÇİ / FİRMA:</MudText>
                                    <MudText Typo="Typo.body2">@(_firma?.FirmaAdi ?? "Ermay Yazılım Ltd.")</MudText>
                                    <MudText Typo="Typo.body2">@(_firma?.Adres ?? "İstanbul, Türkiye")</MudText>
                                    <MudText Typo="Typo.body2">@(_firma?.VergiDairesi) / @(_firma?.VergiNo)</MudText>
                                </td>
                                <td style="text-align: right;">
                                    <MudText Typo="Typo.subtitle2" Class="font-weight-bold">MÜŞTERİ:</MudText>
                                    <MudText Typo="Typo.body2">@_siparis.CariUnvan</MudText>
                                    <MudText Typo="Typo.body2">Teslimat Tarihi: @(_siparis.TeslimatTarihi?.ToString("dd.MM.yyyy") ?? "-")</MudText>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>

                <tr class="heading">
                    <td>Ürün / Hizmet</td>
                    <td style="text-align: right;">Birim Fiyat</td>
                    <td style="text-align: right;">Miktar</td>
                    <td style="text-align: right;">Toplam</td>
                </tr>

                @foreach (var item in _detaylar)
                {
                    <tr class="item">
                        <td>@item.StokAdi</td>
                        <td style="text-align: right;">@item.BirimFiyat.ToString("N2") ₺</td>
                        <td style="text-align: right;">@item.Miktar @item.Birim</td>
                        <td style="text-align: right;">@item.Tutar.ToString("N2") ₺</td>
                    </tr>
                }

                <tr class="total">
                    <td colspan="3"></td>
                    <td style="text-align: right; padding-top: 20px;">
                        <MudText Typo="Typo.h5" Class="font-weight-bold mt-2">GENEL TOPLAM: @_siparis.GenelToplam.ToString("N2") ₺</MudText>
                    </td>
                </tr>
            </table>

            <div class="footer-msg mt-10 pa-4" style="border-top: 1px solid #eee; text-align: center;">
                <MudText Typo="Typo.caption" Color="Color.Secondary">Bu form Ermay Muhasebe Cloud tarafından sipariş takip amacıyla üretilmiştir.</MudText>
            </div>
        </div>
    }
</div>

<style>
    .invoice-wrapper { background: #f1f5f9; min-height: 100vh; }
    .invoice-box { max-width: 800px; margin: auto; padding: 30px; border: 1px solid #eee; box-shadow: 0 0 10px rgba(0, 0, 0, .15); font-size: 16px; line-height: 24px; color: #555; background: white; }
    .invoice-box table { width: 100%; line-height: inherit; text-align: left; }
    .invoice-box table td { padding: 5px; vertical-align: top; }
    .invoice-box table tr.top table td { padding-bottom: 20px; }
    .invoice-box table tr.heading td { background: #eee; border-bottom: 1px solid #ddd; font-weight: bold; }
    .invoice-box table tr.item td { border-bottom: 1px solid #eee; }
    @@media print {
        .no-print { display: none !important; }
        .invoice-wrapper { background: white !important; padding: 0 !important; }
        .invoice-box { box-shadow: none !important; border: none !important; max-width: 100% !important; margin: 0 !important; }
    }
</style>

@code {
    [Parameter] public int Id { get; set; }
    private Siparis? _siparis;
    private List<SiparisDetay> _detaylar = new();
    private FirmaProfili? _firma;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        try {
            _siparis = await DbService.GetSiparisAsync(Id);
            if (_siparis != null) {
                _detaylar = await DbService.GetSiparisDetaylarAsync(Id);
                _firma = await DbService.GetFirmaProfiliAsync();
            }
        } finally { _loading = false; }
    }

    private async Task PrintWindow() => await JS.InvokeVoidAsync("window.print");
    private void GoBack() => NavManager.NavigateTo($"/siparis-detay/{Id}");
}
