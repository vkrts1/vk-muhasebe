@using MudBlazor
@using ErmayMuhasebe.Models
@using ErmayMuhasebe.Cloud.Services
@inject ClientDatabaseService DbService
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudGrid>
            <MudItem xs="12">
                <MudSelect T="string" Label="Hesap Türü" @bind-Value="Model.KartTuru" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter" TransformOrigin="Origin.TopCenter">
                    <MudSelectItem Value='@("Kasa")'>Kasa</MudSelectItem>
                    <MudSelectItem Value='@("Banka")'>Banka</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12">
                <MudTextField T="string" Label="Kasa/Banka Adı" @bind-Value="Model.BankaAdi" Variant="Variant.Outlined" Required="true" />
            </MudItem>
            @if (Model.KartTuru == "Banka")
            {
                <MudItem xs="6">
                    <MudTextField T="string" Label="Şube Adı" @bind-Value="Model.SubeAdi" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="6">
                     <MudTextField T="string" Label="IBAN" @bind-Value="Model.IBAN" Variant="Variant.Outlined" />
                </MudItem>
            }
            <MudItem xs="6">
                <MudSelect T="string" Label="Döviz Türü" @bind-Value="Model.DovizTuru" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter" TransformOrigin="Origin.TopCenter">
                    <MudSelectItem Value='@("TL")'>TL</MudSelectItem>
                    <MudSelectItem Value='@("USD")'>USD</MudSelectItem>
                    <MudSelectItem Value='@("EUR")'>EUR</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="6">
                <MudNumericField T="decimal" Label="Açılış Bakiyesi" @bind-Value="Model.GuncelBakiye" Variant="Variant.Outlined" HideSpinButtons="true" />
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">İptal</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">Kaydet</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public BankaKart Model { get; set; } = new BankaKart { KartTuru = "Kasa", DovizTuru = "TL" };

    private void Cancel() => MudDialog.Cancel();

    private async Task Submit()
    {
        if (string.IsNullOrWhiteSpace(Model.BankaAdi))
        {
            Snackbar.Add("Ad alanı boş olamaz.", Severity.Warning);
            return;
        }

        await DbService.SaveBankaAsync(Model);
        Snackbar.Add("Hesap kartı kaydedildi.", Severity.Success);
        MudDialog.Close(DialogResult.Ok(true));
    }
}
