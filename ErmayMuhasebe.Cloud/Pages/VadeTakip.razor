@page "/vade-takip"
@using ErmayMuhasebe.Models
@using ErmayMuhasebe.Cloud.ViewModels
@inject VadeTakipViewModel ViewModel
@inject ISnackbar Snackbar

<style>
    /* Specific overrides for Vade Takip table pixel parity */
    .vade-grid-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
    }
    .vade-grid-table th {
        text-align: left;
        padding: 12px 16px;
        color: rgba(255,255,255,0.5);
        font-size: 11px;
        font-weight: 600;
        border-bottom: 1px solid rgba(255,255,255,0.08);
        border-top: 1px solid rgba(255,255,255,0.08);
    }
    .vade-grid-table td {
        padding: 14px 16px;
        color: white;
        font-size: 13px;
        border-bottom: 1px solid rgba(255,255,255,0.05);
        vertical-align: middle;
    }
    .vade-grid-table tbody tr:hover {
        background: rgba(255,255,255,0.02);
    }
    .radio-circle {
        width: 18px;
        height: 18px;
        border-radius: 50%;
        border: 1px solid rgba(255,255,255,0.3);
        display: inline-block;
        vertical-align: middle;
    }
    .action-circle-btn {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        border: 1px solid rgba(245, 158, 11, 0.4);
        color: #FBBF24;
        display: flex;
        align-items: center;
        justify-content: center;
        background: transparent;
        cursor: pointer;
        transition: all 0.2s;
    }
    .action-circle-btn:hover {
        background: rgba(245, 158, 11, 0.1);
        border-color: #FBBF24;
    }
    
    .action-capsule-hover:hover {
        background: rgba(56, 189, 248, 0.1) !important;
        border-color: #38BDF8 !important;
    }
    .action-btn-hover-orange:hover {
        background: rgba(245, 158, 11, 0.1) !important;
        border-color: #FBBF24 !important;
    }
    .action-btn-hover-cyan:hover {
        background: rgba(56, 189, 248, 0.1) !important;
        border-color: #38BDF8 !important;
    }
</style>

<div class="fade-in d-flex flex-grow-1 flex-column vade-page-container" style="overflow: hidden; height: 100%; min-height: 0; padding: 20px;">
    
    <div class="desktop-panel d-flex flex-column flex-grow-1" style="padding: 24px; min-height: 0; display: flex; flex-direction: column;">
        
        <!-- 1. Header Area -->
        <div style="display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 24px; flex-shrink: 0;">
            <div class="d-flex align-items-center gap-4">
                <div style="background: rgba(30, 41, 59, 0.5); border: 1px solid rgba(255, 255, 255, 0.05); color: #60A5FA; width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; border-radius: 12px;">
                    <MudIcon Icon="@Icons.Material.Filled.EventNote" Size="Size.Medium" />
                </div>
                <div>
                    <h2 style="font-size: 18px; font-weight: 700; color: white; margin: 0; padding-bottom: 4px; letter-spacing: 0.5px;">Vade Takip ve Finansal Planlama</h2>
                    <div style="color: rgba(255,255,255,0.4); font-size: 13px; font-weight: 500;">Gelecek ödemeler ve beklenen tahsilatların merkezi takibi</div>
                </div>
            </div>
            <button style="border: 1px solid rgba(56, 189, 248, 0.4); color: #38BDF8; background: transparent; height: 36px; padding: 0 16px; border-radius: 18px; display: flex; align-items: center; gap: 8px; font-weight: 600; font-size: 13px; cursor: pointer; transition: all 0.2s;" class="action-capsule-hover" @onclick="ViewModel.LoadVadelerAsync">
                <MudIcon Icon="@Icons.Material.Filled.Sync" Size="Size.Small" /> <span>Yenile</span>
            </button>
        </div>

        @if (!string.IsNullOrEmpty(ViewModel.ErrorMessage))
        {
            <div style="background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.2); color: #F87171; font-size: 12px; font-weight: 700; padding: 12px; border-radius: 8px; margin-bottom: 24px; flex-shrink: 0;">
                <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Size="Size.Small" Style="margin-right: 6px; vertical-align: middle;" /> @ViewModel.ErrorMessage
            </div>
        }

        <!-- 2. KPI Cards -->
        <div class="vade-kpi-grid" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-bottom: 24px; flex-shrink: 0;">
            <!-- Green Panel -->
            <div style="background: linear-gradient(135deg, rgba(16, 185, 129, 0.1) 0%, transparent 100%); border: 1px solid rgba(16, 185, 129, 0.15); border-radius: 12px; padding: 20px; height: 104px; display: flex; flex-direction: column; justify-content: center;">
                <div style="color: #34D399; font-size: 11px; font-weight: 800; letter-spacing: 0.5px; margin-bottom: 8px;">BEKLENEN TAHSİLAT</div>
                <div style="color: white; font-size: 28px; font-weight: 800; line-height: 1;">@ViewModel.ToplamAlacak.ToString("N2") <span style="font-size: 22px; margin-left: 2px;">₺</span></div>
            </div>

            <!-- Red Panel -->
            <div style="background: linear-gradient(135deg, rgba(239, 68, 68, 0.1) 0%, transparent 100%); border: 1px solid rgba(239, 68, 68, 0.15); border-radius: 12px; padding: 20px; height: 104px; display: flex; flex-direction: column; justify-content: center;">
                <div style="color: #F87171; font-size: 11px; font-weight: 800; letter-spacing: 0.5px; margin-bottom: 8px;">GELECEK ÖDEMELER</div>
                <div style="color: white; font-size: 28px; font-weight: 800; line-height: 1;">@ViewModel.ToplamBorc.ToString("N2") <span style="font-size: 22px; margin-left: 2px;">₺</span></div>
            </div>

            <!-- Yellow Panel -->
            <div style="background: linear-gradient(135deg, rgba(245, 158, 11, 0.1) 0%, transparent 100%); border: 1px solid rgba(245, 158, 11, 0.15); border-radius: 12px; padding: 20px; height: 104px; display: flex; flex-direction: column; justify-content: center;">
                <div style="color: #FBBF24; font-size: 11px; font-weight: 800; letter-spacing: 0.5px; margin-bottom: 8px;">GECİKMİŞ VADELER</div>
                <div style="color: white; font-size: 28px; font-weight: 800; line-height: 1;">@ViewModel.GecikmisAdet <span style="font-size: 22px; margin-left: 2px;">Adet</span></div>
            </div>
        </div>

        <!-- 3. Toolbar Area -->
        <div class="vade-toolbar" style="display: flex; gap: 12px; margin-bottom: 20px; align-items: center; flex-shrink: 0;">
            <div class="d-flex align-center gap-2 p-1" style="background: rgba(255,255,255,0.05); border-radius: 20px;">
                <button class="@(_viewMode == "List" ? "active-toggle" : "inactive-toggle")" @onclick='() => _viewMode = "List"'>
                    <MudIcon Icon="@Icons.Material.Filled.List" Size="Size.Small" /> <span>Liste</span>
                </button>
                <button class="@(_viewMode == "Calendar" ? "active-toggle" : "inactive-toggle")" @onclick='() => _viewMode = "Calendar"'>
                    <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Size="Size.Small" /> <span>Takvim</span>
                </button>
            </div>

            <div style="flex-grow: 1; height: 40px; border: 1px solid rgba(255,255,255,0.15); border-radius: 20px; display: flex; align-items: center; padding: 0 16px; background: transparent;">
                <MudIcon Icon="@Icons.Material.Outlined.Search" Size="Size.Small" Style="color: rgba(255,255,255,0.4);" />
                <input type="text" placeholder="Cari veya Tür Ara..." style="width: 100%; height: 100%; background: transparent; border: none; color: white; outline: none; padding-left: 10px; font-size: 13px;" />
            </div>
            
            <button style="height: 40px; padding: 0 20px; border-radius: 20px; border: 1px solid rgba(245, 158, 11, 0.5); color: #FBBF24; background: transparent; display: flex; align-items: center; gap: 8px; font-weight: 600; font-size: 13px; cursor: pointer; transition: all 0.2s;" class="action-btn-hover-orange">
                <MudIcon Icon="@Icons.Material.Outlined.FileDownload" Size="Size.Small" /> <span>Excel</span>
            </button>
        </div>

        <!-- 4. Data Table / Calendar -->
        <div class="d-flex flex-column flex-grow-1" style="min-height: 0; overflow-y: auto; overflow-x: auto; padding-right: 4px;">
            @if (_viewMode == "List")
            {
                <table class="vade-grid-table" style="min-width: 800px;">
                    <thead style="position: sticky; top: 0; background: var(--mud-palette-surface); z-index: 1;">
                        <tr>
                            <th style="width: 50px; text-align: center; border-left: none;"></th>
                            <th style="width: 15%">Tür</th>
                            <th>Cari / Muhatap</th>
                            <th style="width: 12%">Vade Tarihi</th>
                            <th style="width: 15%">Tutar</th>
                            <th style="width: 15%">Durum</th>
                            <th style="width: 80px; text-align: center; border-right: none;">İşlem</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (ViewModel.IsLoading)
                        {
                            @for(int i=0; i<5; i++) {
                                <tr>
                                    <td colspan="7"><div class="skeleton" style="height: 35px; margin: 4px 0; border-radius: 4px;"></div></td>
                                </tr>
                            }
                        }
                        else if (!ViewModel.Vadeler.Any())
                        {
                            <tr>
                                <td colspan="7" style="padding: 40px; text-align: center; color: rgba(255,255,255,0.4);">
                                    Herhangi bir vade kaydı bulunamadı.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in ViewModel.Vadeler)
                            {
                                <tr>
                                    <td style="text-align: center;">
                                        <div class="radio-circle"></div>
                                    </td>
                                    <td>
                                        <span style="color: @(item.Tur.Contains("Borç") ? "#F87171" : "#34D399"); font-weight: 500; font-size: 13px;">@item.Tur</span>
                                    </td>
                                    <td>
                                        <MudLink Href="@($"/cariler?selectId={item.CariId}")" Style="color: #60A5FA; font-weight: 600; font-size: 13px; text-decoration: none;">
                                            @item.CariAdi
                                        </MudLink>
                                    </td>
                                    <td style="color: rgba(255,255,255,0.7); font-size: 13px; font-weight: 500;">@item.VadeTarihi.ToString("dd.MM.yyyy")</td>
                                    <td style="color: white; font-weight: 800; font-size: 14px;">@item.Tutar.ToString("N2") <span style="font-size: 12px; font-weight: 700; opacity: 0.9; margin-left: 2px;">₺</span></td>
                                    <td>
                                        <div style="display: flex; align-items: center; gap: 8px;">
                                            <div style="width: 8px; height: 8px; border-radius: 50%; background: @(item.RenkliUyari ? "#EF4444" : "#10B981");"></div>
                                            <span style="color: @(item.RenkliUyari ? "#EF4444" : "#10B981"); font-size: 11px; font-weight: 800; text-transform: uppercase;">@item.KalanGunText</span>
                                        </div>
                                    </td>
                                    <td style="text-align: center;">
                                        <button class="action-circle-btn"><MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small"/></button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="vade-calendar-grid">
                    <div class="calendar-header">
                        <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" OnClick="PrevMonth" />
                        <span class="month-title">@_calendarDate.ToString("MMMM yyyy").ToUpper()</span>
                        <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" OnClick="NextMonth" />
                    </div>
                    
                    <div class="calendar-days-header">
                        <span>Pzt</span><span>Sal</span><span>Çar</span><span>Per</span><span>Cum</span><span>Cmt</span><span>Paz</span>
                    </div>

                    <div class="calendar-body">
                        @foreach (var day in GetCalendarDays())
                        {
                            var dailyVadeler = ViewModel.Vadeler.Where(x => x.VadeTarihi.Date == day.Date).ToList();
                            <div class="calendar-cell @(day.Month != _calendarDate.Month ? "other-month" : "") @(day.Date == DateTime.Today ? "is-today" : "")">
                                <span class="day-num">@day.Day</span>
                                <div class="cell-content">
                                    @foreach (var v in dailyVadeler.Take(3))
                                    {
                                        <div class="vade-tag @(v.Tur.Contains("Borç") ? "borc" : "alacak")" title="@v.CariAdi">
                                            @v.Tutar.ToString("N0")
                                        </div>
                                    }
                                    @if(dailyVadeler.Count > 3) { <div class="vade-tag-more">+@(dailyVadeler.Count - 3)</div> }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .active-toggle { background: #38BDF8; color: white; border: none; border-radius: 16px; padding: 4px 14px; font-size: 12px; font-weight: 800; display: flex; align-items: center; gap: 6px; }
    .inactive-toggle { background: transparent; color: rgba(255,255,255,0.4); border: none; border-radius: 16px; padding: 4px 14px; font-size: 12px; font-weight: 600; display: flex; align-items: center; gap: 6px; }
    
    .vade-calendar-grid { background: rgba(15, 23, 42, 0.4); border-radius: 20px; padding: 20px; border: 1px solid rgba(255,255,255,0.05); }
    .calendar-header { display: flex; align-items: center; justify-content: center; gap: 40px; margin-bottom: 25px; }
    .month-title { font-size: 20px; font-weight: 900; color: white; letter-spacing: 2px; }
    .calendar-days-header { display: grid; grid-template-columns: repeat(7, 1fr); text-align: center; margin-bottom: 10px; }
    .calendar-days-header span { font-size: 11px; font-weight: 800; color: rgba(255,255,255,0.3); text-transform: uppercase; }
    .calendar-body { display: grid; grid-template-columns: repeat(7, 1fr); border-top: 1px solid rgba(255,255,255,0.05); border-left: 1px solid rgba(255,255,255,0.05); }
    .calendar-cell { height: 100px; border-right: 1px solid rgba(255,255,255,0.05); border-bottom: 1px solid rgba(255,255,255,0.05); padding: 8px; display: flex; flex-direction: column; gap: 4px; transition: background 0.2s; position: relative; }
    .calendar-cell:hover { background: rgba(56, 189, 248, 0.05); }
    .calendar-cell.other-month { opacity: 0.2; }
    .calendar-cell.is-today { background: rgba(56, 189, 248, 0.1); }
    .day-num { font-size: 12px; font-weight: 700; color: rgba(255,255,255,0.5); }
    .is-today .day-num { color: #38BDF8; }
    .cell-content { display: flex; flex-direction: column; gap: 3px; }
    .vade-tag { font-size: 10px; font-weight: 800; padding: 2px 5px; border-radius: 4px; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
    .vade-tag.borc { background: rgba(239, 68, 68, 0.2); color: #F87171; border: 1px solid rgba(239, 68, 68, 0.2); }
    .vade-tag.alacak { background: rgba(16, 185, 129, 0.2); color: #34D399; border: 1px solid rgba(16, 185, 129, 0.2); }
    .vade-tag-more { font-size: 9px; font-weight: 900; color: #38BDF8; text-align: center; }
</style>

@code {
    private string _viewMode = "List";
    private DateTime _calendarDate = DateTime.Today;

    protected override void OnInitialized()
    {
        ViewModel.PropertyChanged += (s, e) => StateHasChanged();
        ViewModel.OnNavigatedTo();
    }

    private void NextMonth() { _calendarDate = _calendarDate.AddMonths(1); StateHasChanged(); }
    private void PrevMonth() { _calendarDate = _calendarDate.AddMonths(-1); StateHasChanged(); }

    private List<DateTime> GetCalendarDays()
    {
        var days = new List<DateTime>();
        var firstDay = new DateTime(_calendarDate.Year, _calendarDate.Month, 1);
        int offset = ((int)firstDay.DayOfWeek + 6) % 7;
        var startDate = firstDay.AddDays(-offset);
        for(int i=0; i<42; i++) days.Add(startDate.AddDays(i));
        return days;
    }
}


