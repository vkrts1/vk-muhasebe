@using ErmayMuhasebe.Models
@using ErmayMuhasebe.Repositories
@using ErmayMuhasebe.Services
@inject IUnitOfWork UnitOfWork
@inject ClientDatabaseService DbService
@inject ISnackbar Snackbar
@inject ExternalApiService ExternalApi

<MudDialog Gutters="false" Class="cari-dialog-root">
    <DialogContent>
        <div class="cari-dialog-container">
            <div class="cari-dialog-header">
                <div class="header-title-box">
                    <div class="header-icon">
                        <MudIcon Icon="@Icons.Material.Filled.PersonAdd" Color="MudBlazor.Color.Inherit" Size="Size.Medium" />
                    </div>
                    <span style="font-size: 18px; font-weight: 800; letter-spacing: 0.5px;">Yeni Cari Kart</span>
                </div>
                <MudIconButton Icon="@Icons.Material.Filled.Close" Color="MudBlazor.Color.Inherit" OnClick="Cancel" />
            </div>

            <div class="dialog-content-body">
                <!-- Sidebar (Temel Bilgiler) -->
                <div class="cari-dialog-sidebar">
                    <div class="sidebar-section-title">TEMEL BİLGİLER</div>
                    
                    <div class="form-group">
                        <label class="form-label">Cari Tipi</label>
                        <select class="custom-select" @bind="Model.Grup">
                            <option value="Müşteri">Müşteri</option>
                            <option value="Tedarikçi">Tedarikçi</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Yetkili Kişi</label>
                        <input type="text" class="custom-input" placeholder="Ad Soyad" @bind="Model.Yetkili" />
                    </div>

                    <div class="form-group">
                        <label class="form-label">Hesap / Firma Adı</label>
                        <textarea class="custom-textarea" placeholder="Firma Ünvanı" @bind="Model.Unvan" style="height: 100px;"></textarea>
                    </div>

                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
                        <div class="form-group">
                            <label class="form-label">Vade Günü</label>
                            <input type="number" class="custom-input" @bind="Model.VadeGunu" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Risk Limiti</label>
                            <input type="number" class="custom-input" @bind="Model.RiskLimiti" />
                        </div>
                    </div>

                    <div class="form-group" style="flex: 1;">
                        <label class="form-label">Cari Kart Açıklaması</label>
                        <textarea class="custom-textarea" style="flex: 1; min-height: 150px;" placeholder="Genel notlar..." @bind="Model.Aciklama"></textarea>
                    </div>
                </div>

                <!-- Main Content (Adres / Risk) -->
                <div class="cari-dialog-main">
                    <div class="tab-header-row">
                        <div class="tab-item @(activeTab == "Adres" ? "active" : "")" @onclick='() => activeTab = "Adres"'>İletişim & Adres</div>
                        <div class="tab-item @(activeTab == "Risk" ? "active" : "")" @onclick='() => activeTab = "Risk"'>Risk & Limit</div>
                    </div>

                    <div class="tab-content-container">
                        @if (activeTab == "Adres")
                        {
                            <div class="animate-fade">
                                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
                                    <div class="form-group">
                                        <label class="form-label">Telefon</label>
                                        <div style="display: flex; gap: 8px;">
                                            <input type="text" class="custom-input" placeholder="Sabit Hat" @bind="Model.Telefon" />
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label class="form-label">Cep Telefonu</label>
                                        <input type="text" class="custom-input" placeholder="Mobil Hat" @bind="Model.CepTelefon" />
                                    </div>
                                </div>

                                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 16px;">
                                    <div class="form-group">
                                        <label class="form-label">E-Mail</label>
                                        <div style="display: flex; gap: 8px;">
                                            <input type="email" class="custom-input" placeholder="iletisim@firma.com" @bind="Model.Email" />
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label class="form-label">IBAN</label>
                                        <div style="display: flex; gap: 8px;">
                                            <input type="text" class="custom-input" placeholder="TR..." @bind="Model.IBAN" />
                                        </div>
                                    </div>
                                </div>

                                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 16px;">
                                    <div class="form-group">
                                        <label class="form-label">Vergi Dairesi</label>
                                        <input type="text" class="custom-input" placeholder="Daire Adı" @bind="Model.VergiDairesi" />
                                    </div>
                                    <div class="form-group">
                                        <label class="form-label">Vergi No / T.C.</label>
                                        <div style="display: flex; gap: 8px;">
                                            <input type="text" class="custom-input" placeholder="VKN/TCKN" @bind="Model.VergiNo" />
                                        </div>
                                    </div>
                                </div>

                                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 16px;">
                                    <div class="form-group">
                                        <label class="form-label">Ülke</label>
                                        <MudAutocomplete T="string" @bind-Value="Model.Ulke" SearchFunc="@SearchCountries" 
                                                       Variant="Variant.Outlined" Margin="Margin.Dense"
                                                       AnchorOrigin="Origin.BottomCenter" TransformOrigin="Origin.TopCenter" Dense="true"
                                                       PopOverClass="cari-autocomplete-popover"
                                                       Style="background: rgba(0,0,0,0.3); color: white;" />
                                    </div>
                                    <div class="form-group">
                                        <label class="form-label">İl</label>
                                        <MudAutocomplete T="string" @bind-Value="Model.Il" SearchFunc="@SearchCities" 
                                                       Variant="Variant.Outlined" Margin="Margin.Dense"
                                                       AnchorOrigin="Origin.BottomCenter" TransformOrigin="Origin.TopCenter" Dense="true"
                                                       PopOverClass="cari-autocomplete-popover"
                                                       Style="background: rgba(0,0,0,0.3); color: white;" />
                                    </div>
                                </div>

                                <div class="form-group" style="margin-top: 16px;">
                                    <label class="form-label">İlçe</label>
                                    <input type="text" class="custom-input" placeholder="İlçe" @bind="Model.Ilce" />
                                </div>

                                <div class="form-group" style="margin-top: 16px;">
                                    <label class="form-label">Cari Hesap Kodu</label>
                                    <input type="text" class="custom-input" style="background: rgba(0,0,0,0.4); border-style: dashed;" @bind="Model.CariKod" readonly />
                                </div>

                                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 16px;">
                                    <div class="form-group">
                                        <label class="form-label">Ana Adres</label>
                                        <textarea class="custom-textarea" placeholder="Açık Adres" @bind="Model.Adres" style="height: 100px;"></textarea>
                                    </div>
                                    <div class="form-group">
                                        <label class="form-label">Sevk Adresi</label>
                                        <textarea class="custom-textarea" placeholder="Gönderim Adresi" @bind="Model.SevkAdresi" style="height: 100px;"></textarea>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="risk-card animate-fade">
                                <div class="risk-subtitle">FİNANSAL RİSK PARAMETRELERİ</div>
                                
                                <div class="checkbox-row" @onclick="() => Model.RiskTakibiYapilsin = !Model.RiskTakibiYapilsin">
                                    <div class="custom-checkbox @(Model.RiskTakibiYapilsin ? "checked" : "")">
                                        <MudIcon Icon="@Icons.Material.Filled.Check" Class="check-icon" />
                                    </div>
                                    <span style="font-size: 14px; font-weight: 500;">Risk Takibi Yapılsın (Limiti Aşınca Uyar)</span>
                                </div>

                                <div class="checkbox-row" @onclick="() => Model.VadeGecmisteEngelle = !Model.VadeGecmisteEngelle">
                                    <div class="custom-checkbox @(Model.VadeGecmisteEngelle ? "checked" : "")">
                                        <MudIcon Icon="@Icons.Material.Filled.Check" Class="check-icon" />
                                    </div>
                                    <span style="font-size: 14px; font-weight: 500;">Vadesi Geçmiş Borçlarda İşlem Engelle</span>
                                </div>

                                <div class="checkbox-row" @onclick="() => Model.FaturadaRiskKontrolu = !Model.FaturadaRiskKontrolu">
                                    <div class="custom-checkbox @(Model.FaturadaRiskKontrolu ? "checked" : "")">
                                        <MudIcon Icon="@Icons.Material.Filled.Check" Class="check-icon" />
                                    </div>
                                    <span style="font-size: 14px; font-weight: 500;">Fatura Keserken Risk Kontrolü Yap</span>
                                </div>

                                <div style="margin-top: 24px; padding: 20px; background: rgba(0,0,0,0.2); border-radius: 12px; border: 1px dashed rgba(255,255,255,0.1);">
                                    <div style="color: #60A5FA; font-size: 11px; font-weight: 800; margin-bottom: 12px;">COĞRAFİ KOORDİNATLAR (ISI HARİTASI İÇİN)</div>
                                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px;">
                                        <div class="form-group">
                                            <label class="form-label">Enlem (Lat)</label>
                                            <input type="text" class="custom-input" @bind="Model.Latitude" placeholder="0.0000" />
                                        </div>
                                        <div class="form-group">
                                            <label class="form-label">Boylam (Lon)</label>
                                            <input type="text" class="custom-input" @bind="Model.Longitude" placeholder="0.0000" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="cari-dialog-footer">
                <button class="btn-vazgec" @onclick="Cancel">
                    <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Size="Size.Small" />
                    VAZGEÇ
                </button>

                <div style="display: flex; align-items: center; gap: 32px;">
                    <div style="display: flex; flex-direction: column; align-items: flex-end;">
                        <span style="font-size: 11px; opacity: 0.6; font-weight: 600;">Açılış Bakiyesi</span>
                        <span style="font-size: 18px; font-weight: 900; color: #60A5FA;">0,00 ₺</span>
                    </div>
                    <button class="btn-kaydet" @onclick="Submit" disabled="@isSubmitting">
                        @if (isSubmitting)
                        {
                            <MudProgressCircular Color="MudBlazor.Color.Inherit" Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        }
                        else
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Save" Size="Size.Small" />
                        }
                        KAYDET
                    </button>
                </div>
            </div>
        </div>
    </DialogContent>
</MudDialog>

<style>
    .cari-dialog-root {
        --mud-dialog-content-padding: 0;
        background-color: transparent !important;
        box-shadow: none !important;
    }

    /* Important: Override MudBlazor's default dialog paper */
    .mud-dialog.cari-dialog-root {
        background: transparent !important;
        box-shadow: none !important;
    }

    .cari-dialog-container {
        background: #1A1D21;
        color: white;
        display: flex;
        flex-direction: column;
        width: 1100px;
        max-width: 100%;
        height: 750px;
        max-height: 90vh;
        overflow: hidden;
        border-radius: 20px; /* Added border radius here since we removed it from mud-dialog */
        border: 1px solid rgba(255,255,255,0.1); /* Subtle outline */
    }

    .cari-dialog-header {
        padding: 24px 32px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: rgba(0,0,0,0.2);
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
