@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public CariKart Model { get; set; } = new CariKart();

    private string activeTab = "Adres";
    private bool isSubmitting = false;

    protected override void OnInitialized()
    {
        if (Model.Id == 0)
        {
            Model.AktifMi = true;
            Model.Ulke = "Türkiye";
            Model.VadeGunu = 30;
            Model.Grup = "Müşteri";
            Model.CariKod = "C-" + new Random().Next(1000, 9999); // Placeholder
        }
        else
        {
            // Normalize values for UI editing
            if (Model.Grup == "MÜŞTERİ" || Model.Grup == "Musteri") Model.Grup = "Müşteri";
            else if (Model.Grup == "TEDARİKÇİ" || Model.Grup == "Tedarikci") Model.Grup = "Tedarikçi";

            if (Model.Tur == "Alici" || Model.Tur == "Alıcı" || string.IsNullOrEmpty(Model.Tur))
            {
                Model.Tur = "Alici";
                if (string.IsNullOrEmpty(Model.Grup)) Model.Grup = "Müşteri";
            }
            else if (Model.Tur == "Satici" || Model.Tur == "Satıcı")
            {
                Model.Tur = "Satici";
                if (string.IsNullOrEmpty(Model.Grup)) Model.Grup = "Tedarikçi";
            }
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task Submit()
    {
        // Set Tur based on Grup for consistency with ViewModel filters
        if (Model.Grup == "Müşteri") Model.Tur = "Alici";
        else if (Model.Grup == "Tedarikçi") Model.Tur = "Satici";

        isSubmitting = true;
        try
        {
            await DbService.SaveCariAsync(Model);
            Snackbar.Add("Cari kartı başarıyla kaydedildi.", MudBlazor.Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, MudBlazor.Severity.Error);
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task ValidateEmail()
    {
        if (string.IsNullOrEmpty(Model.Email)) return;
        bool result = await ExternalApi.ValidateEmailAsync(Model.Email);
        if (result) Snackbar.Add("E-posta geçerli ve teslim edilebilir.", Severity.Success);
        else Snackbar.Add("E-posta geçersiz veya ulaşılamaz!", Severity.Error);
    }

    private async Task ValidateVat()
    {
        if (string.IsNullOrEmpty(Model.VergiNo)) return;
        bool result = await ExternalApi.ValidateVatAsync(Model.Ulke == "Türkiye" ? "TR" : "EU", Model.VergiNo);
        if (result) Snackbar.Add("Vergi numarası doğrulandı.", Severity.Success);
        else Snackbar.Add("Vergi numarası geçersiz!", Severity.Error);
    }

    private void ValidatePhone()
    {
        if (string.IsNullOrEmpty(Model.Telefon)) return;
        bool result = ExternalApi.ValidatePhone(Model.Telefon);
        if (result) Snackbar.Add("Telefon formatı geçerli.", Severity.Success);
        else Snackbar.Add("Telefon formatı hatalı!", Severity.Warning);
    }

    private void ValidateIban()
    {
        if (string.IsNullOrEmpty(Model.IBAN)) return;
        bool result = ExternalApi.ValidateIban(Model.IBAN);
        if (result) Snackbar.Add("IBAN geçerli.", Severity.Success);
        else Snackbar.Add("IBAN hatalı!", Severity.Error);
    }

    private Task<IEnumerable<string>> SearchCountries(string value, CancellationToken token)
    {
        var countries = new[] { "Türkiye", "Almanya", "ABD", "İngiltere", "Fransa", "İtalya", "Hollanda", "Azerbaycan" };
        if (string.IsNullOrEmpty(value)) return Task.FromResult<IEnumerable<string>>(countries);
        return Task.FromResult(countries.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase)));
    }

    private Task<IEnumerable<string>> SearchCities(string value, CancellationToken token)
    {
        var cities = new[] { 
            "Adana", "Adıyaman", "Afyonkarahisar", "Ağrı", "Amasya", "Ankara", "Antalya", "Artvin", "Aydın", "Balıkesir", "Bilecik", "Bingöl", "Bitlis", "Bolu", "Burdur", "Bursa", "Çanakkale", "Çankırı", "Çorum", "Denizli", "Diyarbakır", "Edirne", "Elazığ", "Erzincan", "Erzurum", "Eskişehir", "Gaziantep", "Giresun", "Gümüşhane", "Hakkari", "Hatay", "Isparta", "Mersin", "İstanbul", "İzmir", "Kars", "Kastamonu", "Kayseri", "Kırklareli", "Kırşehir", "Kocaeli", "Konya", "Kütahya", "Malatya", "Manisa", "Kahramanmaraş", "Mardin", "Muğla", "Muş", "Nevşehir", "Niğde", "Ordu", "Rize", "Sakarya", "Samsun", "Siirt", "Sinop", "Sivas", "Tekirdağ", "Tokat", "Trabzon", "Tunceli", "Şanlıurfa", "Uşak", "Van", "Yozgat", "Zonguldak", "Aksaray", "Bayburt", "Karaman", "Kırıkkale", "Batman", "Şırnak", "Bartın", "Ardahan", "Iğdır", "Yalova", "Karabük", "Kilis", "Osmaniye", "Düzce"
        };
        if (string.IsNullOrEmpty(value)) return Task.FromResult<IEnumerable<string>>(cities);
        return Task.FromResult(cities.Where(x => x.Contains(value, StringComparison.InvariantCultureIgnoreCase)));
    }

    private async Task FetchCoordinates()
    {
        string addr = $"{Model.Adres} {Model.Ilce} {Model.Il} {Model.Ulke}";
        if (string.IsNullOrWhiteSpace(addr)) return;
        var coords = await ExternalApi.GetCoordinatesAsync(addr);
        if (coords.HasValue)
        {
            Model.Latitude = coords.Value.lat;
            Model.Longitude = coords.Value.lon;
            Snackbar.Add("Koordinatlar başarıyla alındı.", Severity.Info);
        }
        else Snackbar.Add("Konum bulunamadı!", Severity.Warning);
    }
}
