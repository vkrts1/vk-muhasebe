@page "/siparisler"
@using MudBlazor
@using ErmayMuhasebe.Models
@using ErmayMuhasebe.Cloud.Services
@using ErmayMuhasebe.Shared.Components.Dialogs
@using Microsoft.JSInterop
@inject ClientDatabaseService DbService
@inject ClientAuthService AuthService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject UiService UiService
@inject CloudPdfService CloudPdfService
@implements IDisposable

<div class="fade-in d-flex flex-grow-1 flex-column siparis-page-container" style="overflow: hidden; padding: 20px;" @onclick="HideContextMenu">
    
    <div class="desktop-panel d-flex flex-column flex-grow-1" style="padding: 24px; min-height: 0;">
        <!-- Header (Responsive & Wrapped) -->
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-4 mb-6" style="flex-shrink: 0;">
            <div class="d-flex flex-wrap align-items-center gap-4">
                <h2 style="font-size: 20px; font-weight: 800; color: white; margin: 0; white-space: nowrap;">Siparişler</h2>
                <div class="desktop-search-pill" style="width: 100%; max-width: 350px; min-width: 200px;">
                    <MudIcon Icon="@Icons.Material.Outlined.Search" Size="Size.Small" Style="color: rgba(255,255,255,0.4);" />
                    <input type="text" placeholder="Hızlı Ara..." class="desktop-search-input" style="width: 100%; border: none; background: transparent; color: white; outline: none;" @bind-value="searchString" @bind-value:event="oninput" />
                </div>
            </div>
            
            <div class="d-flex align-items-center gap-3">
                <button @onclick="ConvertSelectedToInvoice" disabled="@(selectedItem == null || selectedItem.Durum == "Faturalandırıldı")" style="height: 36px; padding: 0 16px; font-size: 13px; font-weight: 500; border-radius: 18px; border: 1px solid rgba(255,255,255,0.2); background: rgba(255,255,255,0.05); color: white; cursor: pointer; transition: all 0.2s; white-space: nowrap;" class="hover-btn custom-sync-btn">
                    <MudIcon Icon="@Icons.Material.Outlined.Sync" Size="Size.Small" Style="margin-right: 6px; font-size: 16px; margin-bottom: 2px;" /> Faturaya Dönüştür
                </button>
                <button @onclick="OpenNewDialog" style="height: 36px; padding: 0 20px; font-size: 13px; font-weight: 700; border-radius: 18px; border: none; background: #10B981; color: white; cursor: pointer; transition: all 0.2s; box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3); white-space: nowrap;" class="hover-success-btn">
                    <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" Class="mr-1" /> YENİ SİPARİŞ
                </button>
            </div>
        </div>

        <!-- Data Table -->
        <div class="desktop-table-container flex-grow-1" style="overflow-y: auto;">
            <MudHidden Breakpoint="Breakpoint.SmAndDown" Invert="false">
                <table class="desktop-data-table" style="min-width: 1000px;">
                    <thead style="position: sticky; top: 0; background: var(--mud-palette-surface); z-index: 1;">
                        <tr>
                            <th style="width: 15%; text-align: left;">Sipariş No</th>
                            <th style="width: 15%; text-align: left;">Tarih</th>
                            <th style="width: 15%; text-align: left;">Teslimat</th>
                            <th style="width: 25%; text-align: left;">Cari Ünvan</th>
                            <th style="width: 10%;"></th>
                            <th style="width: 10%; text-align: left;">Tutar</th>
                            <th style="width: 10%; text-align: center;">Durum</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (list == null || !list.Any())
                        {
                            <tr>
                                <td colspan="7" class="pa-16 text-center">
                                    <MudText Typo="Typo.body2" Style="color: rgba(255,255,255,0.2);">Herhangi bir sipariş bulunamadı.</MudText>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in GetFilteredList())
                            {
                                <tr class="@(selectedItem?.Id == item.Id ? "selected" : "")" 
                                    @onclick="() => selectedItem = item"
                                    @oncontextmenu="@(e => ShowContextMenu(e, item))"
                                    @oncontextmenu:preventDefault>
                                    <td style="color: rgba(255,255,255,0.7); font-weight: 500;">@item.SiparisNo</td>
                                    <td style="color: white; font-weight: 500;">@item.Tarih.ToString("dd.MM.yyyy")</td>
                                    <td style="color: rgba(255,255,255,0.5); font-weight: 500;">@(item.TeslimatTarihi?.ToString("dd.MM.yyyy") ?? "")</td>
                                    <td style="color: white; font-weight: 500;">@item.CariUnvan</td>
                                    <td></td>
                                    <td class="text-left" style="font-weight: 700; color: white;">
                                        ₺@item.GenelToplam.ToString("N2")
                                    </td>
                                    <td class="text-center">
                                        <MudMenu AnchorOrigin="Origin.BottomCenter" TransformOrigin="Origin.TopCenter" Dense="true">
                                            <ActivatorContent>
                                                <div class="status-badge" style="display: inline-flex; align-items: center; justify-content: center; padding: 4px 12px; border-radius: 4px; font-size: 11px; font-weight: 600; width: 90px; cursor: pointer; transition: all 0.2s; @(GetDurumStyle(item.Durum))">
                                                    @item.Durum
                                                </div>
                                            </ActivatorContent>
                                            <ChildContent>
                                                <MudMenuItem OnClick="@(() => UpdateStatus(item, "Bekliyor"))">Bekliyor</MudMenuItem>
                                                <MudMenuItem OnClick="@(() => UpdateStatus(item, "Onaylandı"))">Onaylandı</MudMenuItem>
                                                <MudMenuItem OnClick="@(() => UpdateStatus(item, "İptal"))" Style="color: #ef4444;">İptal</MudMenuItem>
                                                <MudMenuItem OnClick="@(() => UpdateStatus(item, "Faturalandırıldı"))">Faturalandırıldı</MudMenuItem>
                                            </ChildContent>
                                        </MudMenu>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </MudHidden>

            <MudHidden Breakpoint="Breakpoint.SmAndDown" Invert="true">
                <div class="pa-4 d-flex flex-column gap-3">
                    @foreach (var item in GetFilteredList())
                    {
                        <div class="mobile-card @(selectedItem?.Id == item.Id ? "selected" : "")" @onclick="() => selectedItem = item">
                            <div class="d-flex justify-between mb-2">
                                <span style="color: rgba(255,255,255,0.7); font-weight: 600; font-size: 12px;">#@item.SiparisNo</span>
                                <MudMenu AnchorOrigin="Origin.BottomCenter" TransformOrigin="Origin.TopCenter" Dense="true">
                                    <ActivatorContent>
                                        <div class="status-badge" style="display: inline-flex; align-items: center; justify-content: center; padding: 2px 8px; border-radius: 4px; font-size: 9px; font-weight: 600; cursor: pointer; transition: all 0.2s; @(GetDurumStyle(item.Durum))">
                                            @item.Durum
                                        </div>
                                    </ActivatorContent>
                                    <ChildContent>
                                        <MudMenuItem OnClick="@(() => UpdateStatus(item, "Bekliyor"))">Bekliyor</MudMenuItem>
                                        <MudMenuItem OnClick="@(() => UpdateStatus(item, "Onaylandı"))">Onaylandı</MudMenuItem>
                                        <MudMenuItem OnClick="@(() => UpdateStatus(item, "İptal"))" Style="color: #ef4444;">İptal</MudMenuItem>
                                        <MudMenuItem OnClick="@(() => UpdateStatus(item, "Faturalandırıldı"))">Faturalandırıldı</MudMenuItem>
                                    </ChildContent>
                                </MudMenu>
                            </div>
                            <div class="card-title" style="color: white; font-weight: 600;">@item.CariUnvan</div>
                            <div class="d-flex justify-between align-end mt-2">
                                <span class="card-meta" style="color: rgba(255,255,255,0.4); font-size: 11px;">@item.Tarih.ToString("dd.MM.yyyy") | Teslim: @(item.TeslimatTarihi?.ToString("dd.MM.yyyy") ?? "-")</span>
                                <span style="font-weight: 800; color: white; font-size: 1.1rem;">₺@item.GenelToplam.ToString("N2")</span>
                            </div>
                        </div>
                    }
                </div>
            </MudHidden>
        </div>
    </div>
</div>

<style>
    .status-badge:hover {
        filter: brightness(1.2);
        transform: scale(1.05);
    }
    .hover-btn:hover:not([disabled]) {
        background: rgba(255,255,255,0.05) !important;
    }
    .hover-btn[disabled] {
        opacity: 0.5;
        cursor: not-allowed;
    }
    .hover-success-btn:hover {
        background: #059669 !important; /* darker green hover */
    }
    .desktop-search-input::placeholder {
        color: rgba(255,255,255,0.3);
    }
</style>

@* Simplified with Centralized Context Menu *@

@code {
    private List<Siparis> allList = new List<Siparis>();
    private List<Siparis> list = new List<Siparis>();
    private string searchString = "";
    private Siparis? selectedItem;
    private int activeDateFilter = 30;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
        UiService.OnEscapePressed += HandleEscape;
    }

    private Task<bool> HandleEscape()
    {
        return Task.FromResult(false);
    }

    public void Dispose()
    {
        UiService.OnEscapePressed -= HandleEscape;
    }

    private void ShowContextMenu(MouseEventArgs e, Siparis item)
    {
        selectedItem = item;
        var items = new List<UiService.ContextMenuItem>
        {
            new UiService.ContextMenuItem { Text = "Açıklama Ekle", Icon = Icons.Material.Filled.Notes, Action = async () => await AddDescription(selectedItem) },
            new UiService.ContextMenuItem { Text = "Düzenle", Icon = Icons.Material.Filled.Edit, Action = () => { EditItem(selectedItem); return Task.CompletedTask; } },
            new UiService.ContextMenuItem { Text = "Görüntüle (PDF)", Icon = Icons.Material.Filled.PictureAsPdf, Action = async () => await ViewPdf(selectedItem) },
            new UiService.ContextMenuItem { Text = "Faturaya Dönüştür", Icon = Icons.Material.Filled.Sync, Action = async () => await ConvertSelectedToInvoice() },
            new UiService.ContextMenuItem { IsDivider = true },
            new UiService.ContextMenuItem { Text = "Durum: Bekliyor", Icon = Icons.Material.Filled.HourglassEmpty, Action = async () => await UpdateStatus(item, "Bekliyor") },
            new UiService.ContextMenuItem { Text = "Durum: Onayla", Icon = Icons.Material.Filled.CheckCircle, Action = async () => await UpdateStatus(item, "Onaylandı") },
            new UiService.ContextMenuItem { Text = "Durum: İptal", Icon = Icons.Material.Filled.Cancel, IsDanger = true, Action = async () => await UpdateStatus(item, "İptal") },
            new UiService.ContextMenuItem { IsDivider = true },
            new UiService.ContextMenuItem { Text = "Sil", Icon = Icons.Material.Filled.Delete, IsDanger = true, Action = async () => await ConfirmDelete(selectedItem) }
        };
        UiService.ShowContextMenu(e.ClientX, e.ClientY, items);
    }

    private void HideContextMenu() => UiService.HideContextMenu();

    private async Task AddDescription(Siparis? item)
    {
        HideContextMenu();
        if (item == null) return;

        try
        {
            var details = await DbService.GetSiparisDetaylarAsync(item.Id);
            
            var parameters = new DialogParameters 
            { 
                ["SiparisNo"] = item.SiparisNo, 
                ["Detaylar"] = details 
            };
            
            var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true };
            var dialog = await DialogService.ShowAsync<SiparisSatirAciklamaDialog>(" ", parameters, options);
            var result = await dialog.Result;

            if (result != null && !result.Canceled)
            {
                 await DbService.SaveSiparisWithDetailsAsync(item, details);
                 Snackbar.Add("Sipariş açıklamaları kaydedildi.", Severity.Success);
                 StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Dialog Hatası: {ex.Message}", Severity.Error);
        }
    }

    private async Task ViewPdf(Siparis? item)
    {
        HideContextMenu();
        if (item == null) return;
        
        var snack = Snackbar.Add("PDF hazırlanıyor, lütfen bekleyin...", Severity.Info);
        try 
        {
            Console.WriteLine($"[SiparisList] ViewPdf tetiklendi: {item.SiparisNo}");
            var details = await DbService.GetSiparisDetaylarAsync(item.Id);
            var cari = await DbService.GetCariAsync(item.CariId);
            
            // API üzerinden PDF üret
            var (success, error) = await CloudPdfService.GenerateSiparisPdfAsync(item, details, cari);
            
            if (snack != null) Snackbar.Remove(snack);
            if (!success) 
            {
                Snackbar.Add($"PDF Hata: {error}", Severity.Error);
                Console.WriteLine($"[SiparisList] PDF üretilemedi: {error}");
            }
            else
            {
                Snackbar.Add("PDF başarıyla oluşturuldu ve açılıyor.", Severity.Success);
                Console.WriteLine("[SiparisList] PDF isteği başarıyla tamamlandı.");
            }
        }
        catch (Exception ex)
        {
            if (snack != null) Snackbar.Remove(snack);
            var msg = ex.InnerException != null ? $"{ex.Message} -> {ex.InnerException.Message}" : ex.Message;
            Snackbar.Add($"Sistem Hatası: {msg}", Severity.Error);
            Console.WriteLine($"[SiparisList] KRİTİK HATA: {ex}");
        }
    }

    private async Task LoadData()
    {
        allList = await DbService.GetSiparislerAsync();
        allList = allList.OrderByDescending(x => x.Tarih).ToList();
        ApplyDateFilter();
    }

    private void SetDateFilter(int days)
    {
        activeDateFilter = days;
        ApplyDateFilter();
    }

    private void ApplyDateFilter()
    {
        if (activeDateFilter > 0)
        {
            var cutoff = DateTime.Now.AddDays(-activeDateFilter);
            list = allList.Where(s => s.Tarih >= cutoff).ToList();
        }
        else
        {
            list = allList.ToList();
        }
    }

    private IEnumerable<Siparis> GetFilteredList()
    {
        if (string.IsNullOrWhiteSpace(searchString))
            return list;
        return list.Where(FilterFuncLocal);
    }

    private bool FilterFuncLocal(Siparis element)
    {
        if (string.IsNullOrWhiteSpace(searchString)) return true;
        if (element.SiparisNo?.Contains(searchString, StringComparison.OrdinalIgnoreCase) == true) return true;
        if (element.CariUnvan?.Contains(searchString, StringComparison.OrdinalIgnoreCase) == true) return true;
        if (element.GenelToplam.ToString().Contains(searchString)) return true;
        return false;
    }

    private string GetDurumStyle(string? status)
    {
        return status switch
        {
            "Faturalandırıldı" => "background-color: #3B82F6; color: white;",
            "Faturalandı" => "background-color: #3B82F6; color: white;",
            "Onaylandı" => "background-color: #10B981; color: white;",
            "Bekliyor" => "background-color: #F59E0B; color: white;",
            "İptal" => "background-color: #EF4444; color: white;",
            _ => "background-color: rgba(255,255,255,0.1); color: white;"
        };
    }

    private void OpenNewDialog() => Nav.NavigateTo("/siparis-olustur");
    
    private void EditItem(Siparis? item) 
    {
        HideContextMenu();
        if (item == null) return;
        Nav.NavigateTo($"/siparis-olustur?Id={item.Id}");
    }

    private async Task ConfirmDelete(Siparis? item)
    {
        HideContextMenu();
        if (item == null) return;

        bool confirm = await DialogService.ShowMessageBox(
            "Silme Onayı", 
            $"{item.SiparisNo} numaralı siparişi silmek istediğinize emin misiniz?", 
            yesText:"Sil", cancelText:"Vazgeç") ?? false;

        if (confirm)
        {
            await DbService.DeleteSiparisAsync(item.Id);
            Snackbar.Add("Sipariş başarıyla silindi.", Severity.Success);
            await LoadData();
        }
    }

    private async Task UpdateStatus(Siparis item, string? newStatus)
    {
        if (string.IsNullOrEmpty(newStatus) || item.Durum == newStatus) return;
        
        try
        {
            item.Durum = newStatus;
            var details = await DbService.GetSiparisDetaylarAsync(item.Id);
            await DbService.SaveSiparisWithDetailsAsync(item, details);
            Snackbar.Add("Durum güncellendi.", Severity.Success);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Hata: {ex.Message}", Severity.Error);
        }
    }

    private void SelectItem(Siparis item)
    {
        selectedItem = item;
    }

    private async Task ConvertSelectedToInvoice()
    {
        HideContextMenu();
        if (selectedItem == null)
        {
             Snackbar.Add("Lütfen faturaya dönüştürmek istediğiniz bir siparişi seçiniz.", Severity.Warning);
             return;
        }

        if (selectedItem.Durum == "Faturalandırıldı")
        {
             Snackbar.Add("Bu sipariş zaten faturalandırılmış.", Severity.Info);
             return;
        }

        bool confirm = await DialogService.ShowMessageBox(
            "Faturaya Dönüştür", 
            "Seçili sipariş faturaya dönüştürülsün mü?", 
            yesText:"Evet", cancelText:"Hayır") ?? false;

        if (confirm)
        {
            int newFaturaId = await DbService.ConvertSiparisToFaturaAsync(selectedItem.Id);
            if (newFaturaId > 0)
            {
                Snackbar.Add("Sipariş başarıyla faturaya dönüştürüldü.", Severity.Success);
                await LoadData();
                StateHasChanged();
            }
            else
            {
                Snackbar.Add("Dönüştürme işlemi başarısız oldu.", Severity.Error);
            }
        }
    }
}


