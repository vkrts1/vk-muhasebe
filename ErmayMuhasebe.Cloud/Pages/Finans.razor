    <!-- KREDİ KARTI DİALOG -->
    @if (KrediKartiVm.IsEditDialogVisible)
    {
        <div class="premium-dialog-overlay fade-in">
            <div class="desktop-grid-wrapper" style="width: 600px; background: #111417; border-radius: 24px; padding: 0;">
                <div style="padding: 24px 30px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid rgba(255,255,255,0.05);">
                    <div style="display: flex; align-items: center; gap: 15px;">
                        <div class="icon-box-primary indigo">
                            <MudIcon Icon="@Icons.Material.Filled.CreditCard" />
                        </div>
                        <div>
                            <h2 class="desktop-title">@KrediKartiVm.DialogTitle</h2>
                            <p class="desktop-subtitle">Kredi kartı işlem detayları</p>
                        </div>
                    </div>
                    <button @onclick="KrediKartiVm.CloseDialog" style="width: 36px; height: 36px; background: transparent; border: 1px solid rgba(255,255,255,0.1); border-radius: 50%; color: white; display: flex; align-items: center; justify-content: center; cursor: pointer;">
                        <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" />
                    </button>
                </div>

                <div style="padding: 30px;">
                    <div class="mb-4">
                        <label class="form-label">Müşteri (Tahsil Edilen)</label>
                        <div style="display: flex; gap: 10px;">
                            <input type="text" @bind="KrediKartiVm.EditMusteriUnvan" class="dark-input" readonly style="flex: 1;" />
                            <button class="action-btn-outline" style="width: auto; padding: 0 15px;" @onclick="KrediKartiVm.OpenMusteriSecim">SEÇ</button>
                        </div>
                    </div>

                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;" class="mb-4">
                        <div>
                            <label class="form-label">İşlem Tarihi</label>
                            <input type="text" @bind="KrediKartiVm.EditTarihStr" class="dark-input" />
                        </div>
                        <div>
                            <label class="form-label">İşlem Tutarı</label>
                            <input type="number" @bind="KrediKartiVm.EditTutar" class="dark-input fw-bold" style="color: #60A5FA !important;" />
                        </div>
                    </div>

                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;" class="mb-4">
                        <div>
                            <label class="form-label">Banka</label>
                            <input type="text" @bind="KrediKartiVm.EditBanka" class="dark-input" />
                        </div>
                        <div>
                            <label class="form-label">Onay Kodu / Slip No</label>
                            <input type="text" @bind="KrediKartiVm.EditOnayKodu" class="dark-input" />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label">Yönlendirilen Tedarikçi (Opsiyonel)</label>
                        <div style="display: flex; gap: 10px;">
                            <input type="text" @bind="KrediKartiVm.EditYonlendirilenCariUnvan" class="dark-input" readonly style="flex: 1;" />
                            <button class="action-btn-outline" style="width: auto; padding: 0 15px;" @onclick="KrediKartiVm.OpenTedarikciSecim">SEÇ</button>
                        </div>
                    </div>

                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 30px;">
                        <button @onclick="KrediKartiVm.CloseDialog" class="action-btn-outline">Vazgeç</button>
                        <button @onclick="KrediKartiVm.SaveIslemAsync" class="action-btn-filled">Kaydet</button>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- HAVALE / EFT DİALOG -->
    @if (EftVm.IsEditDialogVisible)
    {
        <div class="premium-dialog-overlay fade-in">
            <div class="desktop-grid-wrapper" style="width: 600px; background: #111417; border-radius: 24px; padding: 0;">
                <div style="padding: 24px 30px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid rgba(255,255,255,0.05);">
                    <div style="display: flex; align-items: center; gap: 15px;">
                        <div class="icon-box-primary indigo">
                            <MudIcon Icon="@Icons.Material.Filled.AccountBalance" />
                        </div>
                        <div>
                            <h2 class="desktop-title">@EftVm.DialogTitle</h2>
                            <p class="desktop-subtitle">Banka havale / EFT detayları</p>
                        </div>
                    </div>
                    <button @onclick="EftVm.CloseDialog" style="width: 36px; height: 36px; background: transparent; border: 1px solid rgba(255,255,255,0.1); border-radius: 50%; color: white; display: flex; align-items: center; justify-content: center; cursor: pointer;">
                        <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" />
                    </button>
                </div>

                <div style="padding: 30px;">
                    <div class="mb-4">
                        <label class="form-label">Müşteri / Cari Hesap</label>
                        <div style="display: flex; gap: 10px;">
                            <input type="text" @bind="EftVm.EditMusteriUnvan" class="dark-input" readonly style="flex: 1;" />
                            <button class="action-btn-outline" style="width: auto; padding: 0 15px;" @onclick="EftVm.OpenMusteriSecim">SEÇ</button>
                        </div>
                    </div>

                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;" class="mb-4">
                        <div>
                            <label class="form-label">Tarih</label>
                            <input type="text" @bind="EftVm.EditTarihStr" class="dark-input" />
                        </div>
                        <div>
                            <label class="form-label">Tutar</label>
                            <input type="number" @bind="EftVm.EditTutar" class="dark-input fw-bold" style="color: #60A5FA !important;" />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label">Banka / Hesap Bilgisi</label>
                        <input type="text" @bind="EftVm.EditBanka" class="dark-input" placeholder="Banka ve Şube..." />
                    </div>

                    <div class="mb-4">
                        <label class="form-label">Dekont / İşlem No</label>
                        <input type="text" @bind="EftVm.EditDekontNo" class="dark-input" />
                    </div>

                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 30px;">
                        <button @onclick="EftVm.CloseDialog" class="action-btn-outline">Vazgeç</button>
                        <button @onclick="EftVm.SaveIslemAsync" class="action-btn-filled">Kaydet</button>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- CARİ SEÇİM MODAL (GENERIC) -->
    @if (CekVm.IsCariSecimVisible || KrediKartiVm.IsCariSecimVisible || EftVm.IsCariSecimVisible)
    {
        var activeVm = CekVm.IsCariSecimVisible ? (object)CekVm : (KrediKartiVm.IsCariSecimVisible ? (object)KrediKartiVm : (object)EftVm);
        
        <div class="premium-dialog-overlay fade-in" style="z-index: 3000;">
            <div class="desktop-grid-wrapper" style="width: 500px; background: #1A1D21; border-radius: 20px; padding: 0;">
                <div style="padding: 20px; border-bottom: 1px solid rgba(255,255,255,0.05); display: flex; justify-content: space-between; align-items: center;">
                    <h3 class="desktop-title">Cari Hesap Seçimi</h3>
                    <button @onclick='() => { CekVm.CloseCariSecim(); KrediKartiVm.CloseCariSecim(); EftVm.CloseCariSecim(); }' style="background: transparent; border: none; color: white;">
                        <MudIcon Icon="@Icons.Material.Filled.Close" />
                    </button>
                </div>
                <div style="padding: 20px;">
                    <div class="mb-3">
                        @if (CekVm.IsCariSecimVisible)
                        {
                            <input type="text" class="dark-input" placeholder="Cari Ünvan ile ara..." 
                                   @bind:event="oninput" @bind="CekVm.CariSearchText" 
                                   @onkeyup="CekVm.SearchCariAsync" />
                        }
                        else if (KrediKartiVm.IsCariSecimVisible)
                        {
                            <input type="text" class="dark-input" placeholder="Cari Ünvan ile ara..." 
                                   @bind:event="oninput" @bind="KrediKartiVm.CariSearchText" 
                                   @onkeyup="KrediKartiVm.SearchCariAsync" />
                        }
                        else if (EftVm.IsCariSecimVisible)
                        {
                            <input type="text" class="dark-input" placeholder="Cari Ünvan ile ara..." 
                                   @bind:event="oninput" @bind="EftVm.CariSearchText" 
                                   @onkeyup="EftVm.SearchCariAsync" />
                        }
                    </div>
                    <div style="max-height: 300px; overflow-y: auto;">
                        <table class="desktop-table">
                            <tbody>
                                @{
                                    IEnumerable<CariKart> list = CekVm.IsCariSecimVisible ? CekVm.CariListesi : (KrediKartiVm.IsCariSecimVisible ? KrediKartiVm.CariListesi : EftVm.CariListesi);
                                }
                                @foreach (var c in list)
                                {
                                    <tr class="desktop-row clickable" @onclick='() => { if (CekVm.IsCariSecimVisible) { CekVm.SelectedCariForAdd = c; CekVm.SelectCari(); } else if (KrediKartiVm.IsCariSecimVisible) KrediKartiVm.SelectCari(c); else EftVm.SelectCari(c); }'>
                                        <td>@c.Unvan</td>
                                        <td class="text-end fw-bold">@c.Bakiye.ToString("N2")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private string activeTab = "Nakit";

    protected override async Task OnInitializedAsync()
    {
        // Global shortcut handler
        UiService.OnEscapePressed += HandleEscape;

        // UI refresh handlers
        KasaVm.PropertyChanged += (s, e) => StateHasChanged();
        CekVm.PropertyChanged += (s, e) => StateHasChanged();
        KrediKartiVm.PropertyChanged += (s, e) => StateHasChanged();
        EftVm.PropertyChanged += (s, e) => StateHasChanged();

        // REFRESH DATA from DB to ensure parity with Cari entries
        await KasaVm.LoadKasalarAsync();
        await CekVm.LoadDataAsync();
        await KrediKartiVm.LoadIslemlerAsync();
        await EftVm.LoadIslemlerAsync();
    }

    private async Task<bool> HandleEscape()
    {
        if (CekVm.IsCariSecimVisible || KrediKartiVm.IsCariSecimVisible || EftVm.IsCariSecimVisible)
        {
            CekVm.CloseCariSecim();
            KrediKartiVm.CloseCariSecim();
            EftVm.CloseCariSecim();
            StateHasChanged();
            return true;
        }

        if (CekVm.IsEditFormVisible) { CekVm.IsEditFormVisible = false; StateHasChanged(); return true; }
        if (KrediKartiVm.IsEditDialogVisible) { KrediKartiVm.CloseDialog(); StateHasChanged(); return true; }
        if (EftVm.IsEditDialogVisible) { EftVm.CloseDialog(); StateHasChanged(); return true; }
        if (KasaVm.IsEditDialogVisible) { KasaVm.CloseDialog(); StateHasChanged(); return true; }

        await Task.CompletedTask;
        return false;
    }

    public void Dispose()
    {
        KasaVm.PropertyChanged -= (s, e) => StateHasChanged();
        CekVm.PropertyChanged -= (s, e) => StateHasChanged();
        KrediKartiVm.PropertyChanged -= (s, e) => StateHasChanged();
        EftVm.PropertyChanged -= (s, e) => StateHasChanged();
        UiService.OnEscapePressed -= HandleEscape;
    }

    private async Task ConfirmDeleteKasa(BankaKart kasa)
    {
        bool? confirm = await DialogService.ShowMessageBox(
            "Kasa Silinecek",
            $"{kasa.BankaAdi} hesabını silmek istediğinize emin misiniz?",
            yesText: "Sil", cancelText: "Vazgeç"
        );
        if (confirm == true)
        {
            await KasaVm.DeleteKasaAsync(kasa);
            Snackbar.Add("Kasa hesabı silindi", Severity.Success);
        }
    }

    private async Task ConfirmDeleteCek(Cek cek)
    {
        bool? confirm = await DialogService.ShowMessageBox(
            "Çek Kaydı Silinecek",
            $"{cek.PortfoyNo} numaralı çek kaydını silmek istediğinize emin misiniz?",
            yesText: "Sil", cancelText: "Vazgeç"
        );
        if (confirm == true)
        {
            await CekVm.DeleteCekAsync(cek);
            Snackbar.Add("Çek kaydı silindi", Severity.Success);
        }
    }

    private async Task ConfirmDeleteKk(KrediKartiIslem islem)
    {
        bool? confirm = await DialogService.ShowMessageBox(
            "İşlem Silinecek",
            "Bu kredi kartı işlemini silmek istediğinize emin misiniz?",
            yesText: "Sil", cancelText: "Vazgeç"
        );
        if (confirm == true)
        {
            await KrediKartiVm.DeleteIslemAsync(islem);
            Snackbar.Add("İşlem silindi", Severity.Success);
        }
    }

    private async Task ConfirmDeleteEft(EftIslem islem)
    {
        bool? confirm = await DialogService.ShowMessageBox(
            "İşlem Silinecek",
            "Bu havale/EFT işlemini silmek istediğinize emin misiniz?",
            yesText: "Sil", cancelText: "Vazgeç"
        );
        if (confirm == true)
        {
            await EftVm.DeleteIslemAsync(islem);
            Snackbar.Add("İşlem silindi", Severity.Success);
        }
    }
}


