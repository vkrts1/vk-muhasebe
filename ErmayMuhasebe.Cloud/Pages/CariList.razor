@code {

    protected override async Task OnInitializedAsync() {
        ViewModel.PropertyChanged += (s, e) => {
             if (e.PropertyName == nameof(ViewModel.ErrorMessage) && !string.IsNullOrEmpty(ViewModel.ErrorMessage))
             {
                 Snackbar.Add(ViewModel.ErrorMessage, Severity.Error);
             }
             if (e.PropertyName == nameof(ViewModel.SuccessMessage) && !string.IsNullOrEmpty(ViewModel.SuccessMessage))
             {
                 Snackbar.Add(ViewModel.SuccessMessage, Severity.Success);
             }
             if (e.PropertyName == nameof(ViewModel.StatusMessage) && !string.IsNullOrEmpty(ViewModel.StatusMessage))
             {
                 Snackbar.Add(ViewModel.StatusMessage, Severity.Info);
             }
             InvokeAsync(StateHasChanged);
        };
        UiService.OnEscapePressed += HandleEscape;
        await ViewModel.LoadCarilerAsync();

        // Handle direct selection from Query String
        var uri = NavManager.ToAbsoluteUri(NavManager.Uri);
        var query = uri.Query;
        if (!string.IsNullOrEmpty(query) && query.Contains("selectId="))
        {
            var parts = query.TrimStart('?').Split('&');
            var selectPart = parts.FirstOrDefault(p => p.StartsWith("selectId="));
            if (selectPart != null && int.TryParse(selectPart.Split('=')[1], out int id))
            {
                var cari = ViewModel.Cariler.FirstOrDefault(c => c.Id == id);
                if (cari != null)
                {
                    ViewModel.SelectedCari = cari;
                    StateHasChanged();
                }
            }
        }
    }

    private void ShowContextMenu(MouseEventArgs e, CariKart cari)
    {
        ViewModel.SelectedCari = cari;
        var items = new List<UiService.ContextMenuItem>
        {
            new UiService.ContextMenuItem { Text = "Satış", Icon = Icons.Material.Filled.ShoppingCart, Action = () => { ViewModel.OpenSatisFaturasi(); return Task.CompletedTask; } },
            new UiService.ContextMenuItem { Text = "Alış", Icon = Icons.Material.Filled.LocalShipping, Action = () => { ViewModel.OpenAlisFaturasi(); return Task.CompletedTask; } },
            new UiService.ContextMenuItem { IsDivider = true },
            new UiService.ContextMenuItem { Text = "Tahsilat", Icon = Icons.Material.Filled.MonetizationOn, Action = () => { ViewModel.TahsilatYap(); return Task.CompletedTask; } },
            new UiService.ContextMenuItem { Text = "Ödeme", Icon = Icons.Material.Filled.Payments, Action = () => { ViewModel.OdemeYap(); return Task.CompletedTask; } },
            new UiService.ContextMenuItem { IsDivider = true },
            new UiService.ContextMenuItem { Text = "Alacaklandır", Icon = Icons.Material.Filled.Add, Action = () => { ViewModel.Alacaklandir(); return Task.CompletedTask; } },
            new UiService.ContextMenuItem { Text = "Borçlandır", Icon = Icons.Material.Filled.Remove, Action = () => { ViewModel.Borclandir(); return Task.CompletedTask; } },
            new UiService.ContextMenuItem { IsDivider = true },
            new UiService.ContextMenuItem { Text = "Ekstre", Icon = Icons.Material.Filled.Description, Action = async () => await ViewModel.HesapEkstresiAsync() },
            new UiService.ContextMenuItem { Text = "Detaylı Ekstre", Icon = Icons.Material.Filled.Assignment, Action = async () => await ViewModel.DetayliHesapEkstresiAsync() },
            new UiService.ContextMenuItem { Text = "Cari Yaşlandırma", Icon = Icons.Material.Filled.History, Action = async () => await ViewModel.CariYaslandirmaAsync() }
        };
        UiService.ShowContextMenu(e.ClientX, e.ClientY, items);
    }

    private void ShowMovementContextMenu(MouseEventArgs e, CariHareket hareket)
    {
        ViewModel.SelectedHareket = hareket;
        var items = new List<UiService.ContextMenuItem>
        {
            new UiService.ContextMenuItem { Text = "Düzenle", Icon = Icons.Material.Filled.Edit, Action = async () => await ViewModel.EditTransactionAsync() }
        };
        if (AuthService.IsAdmin)
        {
            items.Add(new UiService.ContextMenuItem { Text = "Sil", Icon = Icons.Material.Filled.Delete, IsDanger = true, Action = async () => await ConfirmDeleteMovement(ViewModel.SelectedHareket) });
        }
        items.Add(new UiService.ContextMenuItem { IsDivider = true });
        items.Add(new UiService.ContextMenuItem { Text = "Görüntüle", Icon = Icons.Material.Filled.Visibility, Action = async () => await ViewModel.ViewTransactionAsync() });
        
        UiService.ShowContextMenu(e.ClientX, e.ClientY, items);
    }

    private void HideContextMenu() => UiService.HideContextMenu();

    private async Task<bool> HandleEscape()
    {
        // Centralized context menu is already handled by UiService.NotifyEscapePressedAsync

        if (ViewModel.IsCariSelectionVisible)
        {
            ViewModel.CloseCariSelection();
            StateHasChanged();
            return true;
        }

        if (ViewModel.IsCariEkleVisible)
        {
            ViewModel.CloseDialog();
            StateHasChanged();
            return true;
        }

        if (ViewModel.IsTransactionDialogVisible)
        {
            ViewModel.CloseTransactionDialog();
            StateHasChanged();
            return true;
        }

        if (ViewModel.CheckHelper.IsEditFormVisible)
        {
            ViewModel.CheckHelper.IsEditFormVisible = false;
            StateHasChanged();
            return true;
        }

        if (ViewModel.IsEkstreOptionVisible)
        {
            ViewModel.IsEkstreOptionVisible = false;
            StateHasChanged();
            return true;
        }

        if (ViewModel.SelectedCari != null)
        {
            ViewModel.SelectedCari = null;
            ViewModel.SelectedHareket = null;
            StateHasChanged();
            return true;
        }

        await Task.CompletedTask;
        return false;
    }

    public void Dispose()
    {
        UiService.OnEscapePressed -= HandleEscape;
    }

    private async Task HandleSearchKeyUp(KeyboardEventArgs e) {
        if (e.Key == "Enter") await ViewModel.LoadCarilerAsync();
    }

    private async Task OnSlipFileChanged(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file != null)
        {
            var buffer = new byte[file.Size];
            await file.OpenReadStream(10 * 1024 * 1024).ReadAsync(buffer);
            ViewModel.KkSlipPath = $"data:{file.ContentType};base64,{Convert.ToBase64String(buffer)}";
            StateHasChanged();
        }
    }

    private async Task OnCheckFrontFileChanged(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file != null)
        {
            var buffer = new byte[file.Size];
            await file.OpenReadStream(10 * 1024 * 1024).ReadAsync(buffer);
            ViewModel.CheckHelper.EditGorselYoluOn = $"data:{file.ContentType};base64,{Convert.ToBase64String(buffer)}";
            StateHasChanged();
        }
    }

    private async Task OnCheckBackFileChanged(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file != null)
        {
            var buffer = new byte[file.Size];
            await file.OpenReadStream(10 * 1024 * 1024).ReadAsync(buffer);
            ViewModel.CheckHelper.EditGorselYoluArka = $"data:{file.ContentType};base64,{Convert.ToBase64String(buffer)}";
            StateHasChanged();
        }
    }

    private async Task ConfirmDeleteCari() {
        if (ViewModel.SelectedCari == null) return;
        
        bool? confirm = await DialogService.ShowMessageBox(
            "Silme Onayı",
            $"{ViewModel.SelectedCari.Unvan} ünvanlı cariyi silmek istediğinize emin misiniz?",
            yesText: "Sil", cancelText: "Vazgeç"
        );

        if (confirm == true)
        {
            await ViewModel.DeleteCariAsync();
            Snackbar.Add("Cari kart başarıyla silindi", Severity.Success);
        }
    }

    private async Task OpenAddDialog()
    {
        var parameters = new DialogParameters { ["Model"] = new CariKart() };
        var options = new DialogOptions { NoHeader = true, MaxWidth = MaxWidth.Large, FullWidth = true, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<CariKartDialog>("Yeni Cari Kart", parameters, options);
        var result = await dialog.Result;
        if (result != null && !result.Canceled)
        {
            await ViewModel.LoadCarilerAsync();
            StateHasChanged();
        }
    }

    private async Task OpenEditDialog()
    {
        if (ViewModel.SelectedCari == null) return;
        var parameters = new DialogParameters { ["Model"] = ViewModel.SelectedCari };
        var options = new DialogOptions { NoHeader = true, MaxWidth = MaxWidth.Large, FullWidth = true, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<CariKartDialog>("Cari Kart Düzenle", parameters, options);
        var result = await dialog.Result;
        if (result != null && !result.Canceled)
        {
            await ViewModel.LoadCarilerAsync();
            StateHasChanged();
        }
    }

    private async Task ConfirmDeleteMovement(CariHareket? hareket)
    {
        if (hareket == null) return;
        bool? confirm = await DialogService.ShowMessageBox(
            "İşlem Silinecek", 
            "Bu işlemi silmek istediğinize emin misiniz? (Fatura ise fatura da silinecektir)", 
            yesText: "Sil", cancelText: "Vazgeç");

        if (confirm == true)
        {
            ViewModel.SelectedHareket = hareket;
            await ViewModel.DeleteTransactionAsync();
            Snackbar.Add("İşlem başarıyla silindi", Severity.Success);
        }
    }
}
