@page "/risk-puani"
@using MudBlazor
@using ErmayMuhasebe.Models
@using ErmayMuhasebe.Repositories
@using System.Globalization
@inject IUnitOfWork Uow
@inject ISnackbar Snackbar

<div class="risk-container">
    <!-- Header Section -->
    <div class="header-section mb-8">
        <div class="header-icon-box orange">
            <MudIcon Icon="@Icons.Material.Filled.Timeline" Style="font-size: 24px; color: #F59E0B;" />
        </div>
        <div class="header-content">
            <h1 class="page-title">Cari Risk Puanlama ve Analiz</h1>
            <p class="page-subtitle">Ödeme alışkanlıkları ve finansal geçmişe göre carilerinizin risk skorlarını takip edin.</p>
        </div>
    </div>

    <div class="risk-grid">
        <!-- Left: Risk List -->
        <div class="list-panel">
            <div class="panel-card p-0">
                <table class="risk-table">
                    <thead>
                        <tr>
                            <th class="text-left">Cari Ünvan</th>
                            <th class="text-left" style="width: 180px;">Risk Skoru</th>
                            <th class="text-left" style="width: 120px;">Durum</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var x in _riskListesi)
                        {
                            <tr class="risk-row">
                                <td class="cari-name">@x.CariUnvan</td>
                                <td class="risk-score-cell">
                                    <div class="d-flex align-center gap-3">
                                        <div class="risk-progress-bg">
                                            <div class="risk-progress-bar" style="@GetProgressStyle(x)"></div>
                                        </div>
                                        <span class="score-text" style="@($"color: {x.Renk};")">@x.Puan.ToString("N1")</span>
                                    </div>
                                </td>
                                <td>
                                    <span class="status-badge" style="@($"background-color: {x.Renk};")">
                                        @x.Durum
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Right: Summary -->
        <div class="summary-panel">
            <div class="summary-card mb-5">
                <span class="summary-title">GENEL PORTFÖY RİSKİ</span>
                <div class="gauge-container">
                    <div class="gauge-ring">
                        <svg viewBox="0 0 100 100">
                            <circle class="gauge-bg" cx="50" cy="50" r="45" />
                            <circle class="gauge-active" cx="50" cy="50" r="45" 
                                    style="@GetGaugeStyle()" />
                        </svg>
                        <div class="gauge-content">
                            <span class="gauge-value">@_genelRiskPuani.ToString("N1")</span>
                            <span class="gauge-unit">PUAN</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="ai-box">
                <div class="ai-header">
                    <MudIcon Icon="@Icons.Material.Filled.Lightbulb" Style="color: #F59E0B; font-size: 20px;" />
                    <span>Yapay Zeka Analizi</span>
                </div>
                <p class="ai-text">@_analizOzeti</p>
                <MudButton Variant="Variant.Filled" 
                           Class="report-btn" 
                           FullWidth="true"
                           OnClick="GenerateReport"
                           Disabled="@_isGeneratingReport">
                    @if (_isGeneratingReport)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        <span>HAZIRLANIYOR...</span>
                    }
                    else
                    {
                        <span>DETAYLI RAPOR AL</span>
                    }
                </MudButton>
            </div>
        </div>
    </div>
</div>

<!-- Detailed Report Drawer -->
<MudDrawer Anchor="Anchor.Right" @bind-Open="_isReportOpen" Variant="@DrawerVariant.Temporary" Width="500px" Elevation="2" Class="premium-drawer" Style="background: #111821; border-left: 1px solid rgba(255,255,255,0.05);">
    <div class="drawer-header" style="padding: 24px; border-bottom: 1px solid rgba(255,255,255,0.05); display: flex; align-items: center; justify-content: space-between;">
        <div class="d-flex align-center gap-3">
            <MudIcon Icon="@Icons.Material.Filled.Analytics" Style="color: #F59E0B; font-size: 28px;" />
            <div>
                <h3 class="fw-bold" style="font-size: 18px; margin: 0; color: white;">Risk Analiz Raporu</h3>
                <span style="font-size: 11px; color: #9ca3af;">Oluşturulma: @DateTime.Now.ToString("dd.MM.yyyy HH:mm")</span>
            </div>
        </div>
        <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Inherit" OnClick="() => _isReportOpen = false" Style="color: #9ca3af;" />
    </div>
    
    <div class="drawer-content" style="padding: 24px;">
        <!-- Executive Summary -->
        <div class="report-box mb-6" style="background: rgba(245,158,11,0.05); border: 1px solid rgba(245,158,11,0.15); border-radius: 12px; padding: 20px;">
            <h4 style="font-size: 13px; font-weight: 700; color: #F59E0B; margin-bottom: 8px;">Yönetici Özeti</h4>
            <p style="font-size: 13px; color: #d1d5db; line-height: 1.5; margin: 0;">@_analizOzeti</p>
        </div>
        
        <!-- Risk Distribution -->
        <h4 style="font-size: 14px; font-weight: 700; color: white; margin-bottom: 16px;">Ana Risk Faktörleri Dağılımı</h4>
        <div class="d-flex flex-column gap-4 mb-8">
            <div class="factor-row">
                <div class="d-flex justify-space-between mb-1">
                    <span style="font-size: 13px; color: #9ca3af;">Tahsilat Gecikmeleri (Ort: 14 Gün)</span>
                    <span style="font-size: 13px; font-weight: 700; color: #EF4444;">Yüksek Riskli</span>
                </div>
                <MudProgressLinear Color="Color.Error" Value="75" Class="my-1" Style="height: 6px; border-radius: 3px;" />
            </div>
            
            <div class="factor-row">
                <div class="d-flex justify-space-between mb-1">
                    <span style="font-size: 13px; color: #9ca3af;">Bakiye Aşımları</span>
                    <span style="font-size: 13px; font-weight: 700; color: #F59E0B;">Orta Riskli</span>
                </div>
                <MudProgressLinear Color="Color.Warning" Value="45" Class="my-1" Style="height: 6px; border-radius: 3px;" />
            </div>
            
            <div class="factor-row">
                <div class="d-flex justify-space-between mb-1">
                    <span style="font-size: 13px; color: #9ca3af;">Karşılıksız/İade Çek Oranı</span>
                    <span style="font-size: 13px; font-weight: 700; color: #10B981;">Düşük Riskli</span>
                </div>
                <MudProgressLinear Color="Color.Success" Value="12" Class="my-1" Style="height: 6px; border-radius: 3px;" />
            </div>
        </div>

        <!-- System Recommendations -->
        <h4 style="font-size: 14px; font-weight: 700; color: white; margin-bottom: 16px;">Sistem Önerileri</h4>
        <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 10px;">
            <li style="font-size: 13px; color: #d1d5db; padding-left: 15px; position: relative;">
                <span style="position: absolute; left: 0; top: 6px; width: 6px; height: 6px; border-radius: 50%; background: #EF4444;"></span>
                Yüksek riskli carilerin vadeli satış limitleri daraltılmalı.
            </li>
            <li style="font-size: 13px; color: #d1d5db; padding-left: 15px; position: relative;">
                <span style="position: absolute; left: 0; top: 6px; width: 6px; height: 6px; border-radius: 50%; background: #F59E0B;"></span>
                Ödeme gecikmelerini azaltmak için otomatik vade ihbar e-postaları devreye alınsın.
            </li>
        </ul>
        
        <!-- Actions -->
        <div class="mt-8 d-flex gap-3">
            <MudButton Variant="Variant.Outlined" 
                       FullWidth="true" 
                       StartIcon="@Icons.Material.Filled.Download" 
                       Style="border-color: rgba(255,255,255,0.1); color: white; height: 42px; border-radius: 10px; flex: 1;">
                PDF YAZDIR
            </MudButton>
        </div>
    </div>
</MudDrawer>

@code {
    private List<RiskItem> _riskListesi = new();
    private double _genelRiskPuani;
    private string _analizOzeti = "Veriler analiz ediliyor...";
    private Random _rnd = new();
    private bool _isGeneratingReport = false;
    private bool _isReportOpen = false;

    public class RiskItem {
        public string CariUnvan { get; set; } = "";
        public double Puan { get; set; }
        public string Durum { get; set; } = "";
        public string Renk { get; set; } = "";
    }

    private string GetProgressStyle(RiskItem item) => $"width: {item.Puan.ToString(CultureInfo.InvariantCulture)}%; background-color: {item.Renk};";
    private string GetGaugeStyle() => $"stroke-dasharray: {(282.0 * _genelRiskPuani / 100.0).ToString(CultureInfo.InvariantCulture)}, 282;";

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        try 
        {
            var cariler = await Uow.Cariler.GetAllAsync();
        
            var list = new List<RiskItem>();
            foreach (var c in cariler.Take(20))
            {
                double puan = 85.0;
                if (c.Borc > c.Alacak * 1.5m) puan -= 25;
                if (c.Bakiye > 50000m) puan -= 10;
                
                puan += _rnd.Next(-5, 5);
                if (puan > 100) puan = 100;
                if (puan < 0) puan = 0;

                string durum = puan > 75 ? "Güvenli" : (puan > 45 ? "Dikkat" : "Riskli");
                string renk = puan > 75 ? "#10B981" : (puan > 45 ? "#F59E0B" : "#EF4444");
                
                list.Add(new RiskItem { 
                    CariUnvan = c.Unvan ?? "Adsız Cari", 
                    Puan = puan, 
                    Durum = durum, 
                    Renk = renk 
                });
            }

            _riskListesi = list.OrderBy(x => x.Puan).ToList();
            _genelRiskPuani = _riskListesi.Any() ? _riskListesi.Average(x => x.Puan) : 85.0;
            
            int riskCount = _riskListesi.Count(x => x.Puan < 50);
            _analizOzeti = $"Portföyünüzde {riskCount} yüksek riskli cari tespit edildi. Çek kabullerinde dikkatli olunmalıdır.";
        }
        catch(Exception ex)
        {
            Snackbar.Add("Veri yükleme hatası: " + ex.Message, Severity.Error);
        }
    }

    private async Task GenerateReport()
    {
        _isGeneratingReport = true;
        StateHasChanged();
        
        // Simulating report generation delay
        await Task.Delay(1500);
        
        _isGeneratingReport = false;
        _isReportOpen = true; // Open the beautiful sidebar report!
        StateHasChanged();
    }
}

<style>
    .risk-container {
        padding: 30px 40px !important;
        background-color: #0d1117;
        min-height: 100vh;
        color: white;
        font-family: 'Inter', sans-serif;
    }

    /* Header Styling */
    .header-section { display: flex; align-items: center; gap: 15px; }
    .header-icon-box {
        width: 45px; height: 45px; border-radius: 12px;
        display: flex; align-items: center; justify-content: center;
    }
    .header-icon-box.orange { background: rgba(245, 158, 11, 0.15); }
    .page-title { font-size: 26px; font-weight: 700; margin: 0; }
    .page-subtitle { font-size: 13px; color: #9ca3af; margin: 2px 0 0 0; }

    /* Layout */
    .risk-grid {
        display: grid;
        grid-template-columns: 1fr 350px;
        gap: 20px;
        align-items: stretch;
    }

    .panel-card {
        background: #161b22;
        border-radius: 20px;
        border: 1px solid rgba(255,255,255,0.05);
        overflow: hidden;
    }

    /* Table Styling */
    .risk-table {
        width: 100%;
        border-collapse: collapse;
    }

    .risk-table th {
        background: #0d1117;
        padding: 15px 20px;
        font-size: 12px;
        color: #9ca3af;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .risk-table td {
        padding: 12px 20px;
        border-bottom: 1px solid rgba(255,255,255,0.03);
    }

    .cari-name { font-size: 14px; font-weight: 500; }

    .risk-progress-bg {
        width: 100px;
        height: 6px;
        background: rgba(255,255,255,0.05);
        border-radius: 3px;
        overflow: hidden;
    }

    .risk-progress-bar {
        height: 100%;
        border-radius: 3px;
        transition: width 1s ease-in-out;
    }

    .score-text { font-size: 14px; font-weight: 700; min-width: 40px; }

    .status-badge {
        font-size: 10px;
        font-weight: 800;
        color: white;
        padding: 3px 10px;
        border-radius: 10px;
        display: inline-block;
        box-shadow: 0 4px 10px rgba(0,0,0,0.2);
    }

    /* Summary Panel */
    .summary-card {
        background: #161b22;
        border-radius: 20px;
        border: 1px solid rgba(255,255,255,0.05);
        padding: 30px;
        text-align: center;
    }

    .summary-title { font-size: 13px; color: #9ca3af; font-weight: 600; letter-spacing: 1px; }

    .gauge-container {
        margin: 25px 0 10px 0;
        display: flex;
        justify-content: center;
    }

    .gauge-ring {
        position: relative;
        width: 160px;
        height: 160px;
    }

    .gauge-ring svg { transform: rotate(-90deg); }
    .gauge-bg { fill: none; stroke: rgba(255,255,255,0.05); stroke-width: 8; }
    .gauge-active { 
        fill: none; 
        stroke: #F59E0B; 
        stroke-width: 8; 
        stroke-linecap: round;
        stroke-dasharray: 0, 282;
        transition: stroke-dasharray 1.5s ease;
    }

    .gauge-content {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        display: flex;
        flex-direction: column;
    }

    .gauge-value { font-size: 38px; font-weight: 900; line-height: 1; }
    .gauge-unit { font-size: 11px; color: #9ca3af; font-weight: 700; margin-top: 2px; }

    .ai-box {
        background: rgba(245, 158, 11, 0.05);
        border: 1px solid rgba(245, 158, 11, 0.15);
        border-radius: 20px;
        padding: 25px;
    }

    .ai-header {
        display: flex;
        align-items: center;
        gap: 10px;
        font-weight: 700;
        margin-bottom: 12px;
    }

    .ai-text {
        font-size: 13px;
        color: #9ca3af;
        line-height: 1.6;
        margin-bottom: 25px;
    }

    .report-btn {
        background-color: #F59E0B !important;
        color: white !important;
        font-weight: 800 !important;
        height: 44px !important;
        border-radius: 12px !important;
        box-shadow: 0 8px 16px rgba(245, 158, 11, 0.2) !important;
        text-transform: none !important;
    }

    @@media (max-width: 1000px) {
        .risk-grid { grid-template-columns: 1fr; }
        .summary-panel { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
    }
</style>
