@page "/fatura-tasarim"
@using MudBlazor
@using ErmayMuhasebe.Shared.ViewModels
@inject FaturaTasarimViewModel ViewModel
@inject NavigationManager Nav

<div class="premium-container fade-in">
    <div class="d-flex align-center gap-4 mb-8">
        <div class="icon-box-large bg-info-light">
            <MudIcon Icon="@Icons.Material.Filled.Description" Class="text-info" Style="font-size: 32px;" />
        </div>
        <div>
            <h1 class="h2 fw-black mb-1 text-white">Fatura Tasarım Ayarları</h1>
            <p class="text-muted mb-0">PDF fatura çıktılarınızın görsel düzenini ve içeriğini özelleştirin.</p>
        </div>
    </div>

    <div class="row g-6">
        <!-- Settings Panel -->
        <div class="col-lg-5">
            <div class="glass-panel pa-6">
                <h3 class="h5 fw-bold mb-6 text-white border-bottom border-white-10 pb-3">Tasarım Parametreleri</h3>
                
                <div class="mb-6">
                    <label class="d-block mb-2 text-muted fw-bold small">FATURA BAŞLIĞI</label>
                    <MudTextField @bind-Value="ViewModel.BaslikText" 
                                  Placeholder="Örn: SATIŞ FATURASI"
                                  Variant="Variant.Outlined"
                                  Class="premium-input-dark" />
                </div>

                <div class="mb-6">
                    <label class="d-block mb-2 text-muted fw-bold small">ALT BİLGİ (FOOTER)</label>
                    <MudTextField @bind-Value="ViewModel.AltBilgi" 
                                  Placeholder="Fatura altındaki not..."
                                  Lines="3"
                                  Variant="Variant.Outlined"
                                  Class="premium-input-dark" />
                </div>

                <div class="mb-8">
                    <label class="d-block mb-4 text-muted fw-bold small pb-2 border-bottom border-white-5">GÖRÜNÜRLÜK AYARLARI</label>
                    <div class="row g-2">
                        <div class="col-6">
                            <MudCheckBox @bind-Value="ViewModel.ShowLogo" Label="Logo Göster" Color="Color.Info" Dense="true" />
                        </div>
                        <div class="col-6">
                            <MudCheckBox @bind-Value="ViewModel.ShowBirim" Label="Birim Göster" Color="Color.Info" Dense="true" />
                        </div>
                        <div class="col-6">
                            <MudCheckBox @bind-Value="ViewModel.ShowKdv" Label="KDV Göster" Color="Color.Info" Dense="true" />
                        </div>
                        <div class="col-6">
                            <MudCheckBox @bind-Value="ViewModel.ShowAraToplam" Label="Ara Toplam" Color="Color.Info" Dense="true" />
                        </div>
                        <div class="col-6">
                            <MudCheckBox @bind-Value="ViewModel.ShowAciklama" Label="Açıklama" Color="Color.Info" Dense="true" />
                        </div>
                    </div>
                </div>

                <button class="action-btn-large primary-btn w-100 py-4" @onclick="ViewModel.KaydetCommand.Execute">
                    <MudIcon Icon="@Icons.Material.Filled.Save" Class="mr-2" /> AYARLARI KAYDET
                </button>
            </div>
        </div>

        <!-- Preview Panel -->
        <div class="col-lg-7">
            <div class="glass-panel pa-0 overflow-hidden h-100 d-flex flex-column" style="background: white !important; color: black !important;">
                <div class="w-100 pa-3 border-bottom border-gray-200 text-center bg-gray-50">
                    <span class="small fw-black text-muted tracking-widest" style="color: #666 !important;">PDF ÖNİZLEME (TEMSİLİ)</span>
                </div>
                
                <div class="flex-grow-1 pa-8" style="font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;">
                    <div class="d-flex justify-between mb-10">
                        <div>
                            @if (ViewModel.ShowLogo)
                            {
                                <div style="width: 120px; height: 50px; background: #eee; display: flex; align-items: center; justify-content: center; font-size: 10px; color: #999; border: 1px dashed #ccc; margin-bottom: 10px;">LOGO</div>
                            }
                            <h2 style="font-weight: 800; font-size: 24px; color: #333;">@ViewModel.BaslikText</h2>
                        </div>
                        <div class="text-end">
                            <div class="small fw-bold">FATURA NO: FTR20240001</div>
                            <div class="small">TARİH: @DateTime.Now.ToString("dd.MM.yyyy")</div>
                        </div>
                    </div>

                    <div class="row mb-8">
                        <div class="col-6">
                            <div class="small fw-bold border-bottom mb-2">GÖNDEREN</div>
                            <div class="small fw-bold">ERMAY MUHASEBE A.Ş.</div>
                            <div class="small">İstanbul / Türkiye</div>
                        </div>
                        <div class="col-6">
                            <div class="small fw-bold border-bottom mb-2">ALICI</div>
                            <div class="small fw-bold">ÖRNEK MÜŞTERİ LTD. ŞTİ.</div>
                            <div class="small">Örnek Adres Mah. No:1</div>
                        </div>
                    </div>

                    <table class="w-100 small mb-8 invoice-preview-table">
                        <thead class="bg-gray-100">
                            <tr>
                                <th class="pa-2">STOK ADI</th>
                                <th class="pa-2 text-center">MİKTAR</th>
                                @if (ViewModel.ShowBirim) { <th class="pa-2 text-center">BİRİM</th> }
                                <th class="pa-2 text-end">FİYAT</th>
                                @if (ViewModel.ShowKdv) { <th class="pa-2 text-end">KDV</th> }
                                <th class="pa-2 text-end">TOPLAM</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="pa-2">Örnek Ürün Kalemi 1</td>
                                <td class="pa-2 text-center">5.00</td>
                                @if (ViewModel.ShowBirim) { <td class="pa-2 text-center">Adet</td> }
                                <td class="pa-2 text-end">100.00 TL</td>
                                @if (ViewModel.ShowKdv) { <td class="pa-2 text-end">%20</td> }
                                <td class="pa-2 text-end">600.00 TL</td>
                            </tr>
                        </tbody>
                    </table>

                    <div class="d-flex justify-end">
                        <div style="min-width: 200px;">
                            @if (ViewModel.ShowAraToplam)
                            {
                                <div class="d-flex justify-between py-1 border-bottom">
                                    <span class="small font-weight-bold">Ara Toplam:</span>
                                    <span class="small">500.00 TL</span>
                                </div>
                            }
                            <div class="d-flex justify-between py-1 border-bottom">
                                <span class="small font-weight-bold">KDV Toplam:</span>
                                <span class="small">100.00 TL</span>
                            </div>
                            <div class="d-flex justify-between py-2 bg-gray-50 pa-2">
                                <span class="fw-black">GENEL TOPLAM:</span>
                                <span class="fw-black">600.00 TL</span>
                            </div>
                        </div>
                    </div>

                    @if (ViewModel.ShowAciklama)
                    {
                        <div class="mt-8 pa-3 bg-gray-50 rounded small italic" style="border-left: 3px solid #ccc;">
                            @ViewModel.AltBilgi
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        ViewModel.OnNavigatedTo();
        ViewModel.PropertyChanged += (s, e) => StateHasChanged();
    }
}

<style>
    .invoice-preview-table {
        border-collapse: collapse;
    }
    .invoice-preview-table th, .invoice-preview-table td {
        border: 1px solid #eee;
    }
    .bg-gray-50 { background-color: #f9fafb; }
    .bg-gray-100 { background-color: #f3f4f6; }
    .border-gray-200 { border-color: #e5e7eb; }
</style>
