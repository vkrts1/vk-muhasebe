@page "/cari-birlestirme"
@using MudBlazor
@using ErmayMuhasebe.Shared.ViewModels
@inject CariBirlestirmeViewModel ViewModel
@inject NavigationManager Nav

<div class="premium-container fade-in">
    <!-- Header -->
    <div class="d-flex align-center gap-4 mb-8">
        <div class="icon-box-large bg-primary-light">
            <MudIcon Icon="@Icons.Material.Filled.Merge" Class="text-primary" Style="font-size: 32px;" />
        </div>
        <div>
            <h1 class="h2 fw-black mb-1 text-white">Cari Birleştirme Sihirbazı</h1>
            <p class="text-muted mb-0">Mükerrer açılmış cari kartları tüm hareketleri ve bakiyeleriyle birlikte tek bir kartta birleştirin.</p>
        </div>
    </div>

    <!-- Main Content -->
    <div class="row g-6 align-start">
        <!-- Source Cari (To be deleted) -->
        <div class="col-lg-5">
            <div class="glass-panel pa-6 border-danger-glow h-100">
                <div class="d-flex align-center justify-center mb-6 gap-3">
                    <MudIcon Icon="@Icons.Material.Filled.DeleteSweep" Color="Color.Error" />
                    <h3 class="h5 fw-black text-danger mb-0">KAYNAK CARİ (SİLİNECEK)</h3>
                </div>
                
                <p class="small text-muted text-center mb-6">Bu karttaki tüm borç, alacak ve hareketler aktarılacak ve bu kart <span class="fw-bold text-danger">KALICI OLARAK SİLİNECEKTİR.</span></p>

                <div class="mb-6">
                    <label class="d-block mb-2 text-muted fw-bold small">SİLİNECEK CARİYİ ARA</label>
                    <MudAutocomplete T="ErmayMuhasebe.Models.CariKart" 
                                     @bind-Value="ViewModel.KaynakCari" 
                                     SearchFunc="@SearchCariler"
                                     ToStringFunc="@(c => c?.Unvan ?? "")"
                                     Placeholder="Ünvan veya kod yazın..."
                                     Variant="Variant.Outlined"
                                     Class="premium-input-dark"
                                     AnchorOrigin="Origin.BottomLeft"
                                     TransformOrigin="Origin.TopLeft"
                                     Dense="true" />
                </div>

                <div class="info-card-dark pa-6 rounded-xl min-h-150">
                    @if (ViewModel.KaynakCari != null)
                    {
                        <div class="d-flex flex-column gap-2 animate-fade-in">
                            <span class="small fw-bold text-muted">@ViewModel.KaynakCari.CariKod</span>
                            <span class="h5 fw-black text-white">@ViewModel.KaynakCari.Unvan</span>
                            <div class="d-flex align-center gap-2 mt-2">
                                <span class="small text-muted">Güncel Bakiye:</span>
                                <span class="fw-black text-danger">@ViewModel.KaynakCari.Bakiye.ToString("N2") ₺</span>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex flex-column align-center justify-center h-100 text-muted" style="opacity: 0.3;">
                            <MudIcon Icon="@Icons.Material.Filled.Search" Size="Size.Large" />
                            <span class="small mt-2">Cari Seçilmedi</span>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Arrow -->
        <div class="col-lg-2 d-none d-lg-flex align-center justify-center pt-20">
            <div class="pulse-arrow">
                <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Style="font-size: 48px; color: rgba(255,255,255,0.1);" />
            </div>
        </div>

        <!-- Destination Cari (To stay) -->
        <div class="col-lg-5">
            <div class="glass-panel pa-6 border-success-glow h-100">
                <div class="d-flex align-center justify-center mb-6 gap-3">
                    <MudIcon Icon="@Icons.Material.Filled.Verified" Color="Color.Success" />
                    <h3 class="h5 fw-black text-success mb-0">HEDEF CARİ (KALACAK)</h3>
                </div>

                <p class="small text-muted text-center mb-6">Tüm veriler bu kart altında toplanacak ve bu kart sistemde <span class="fw-bold text-success">KALMAYA DEVAM EDECEKTİR.</span></p>

                <div class="mb-6">
                    <label class="d-block mb-2 text-muted fw-bold small">KALACAK CARİYİ ARA</label>
                    <MudAutocomplete T="ErmayMuhasebe.Models.CariKart" 
                                     @bind-Value="ViewModel.HedefCari" 
                                     SearchFunc="@SearchCariler"
                                     ToStringFunc="@(c => c?.Unvan ?? "")"
                                     Placeholder="Ünvan veya kod yazın..."
                                     Variant="Variant.Outlined"
                                     Class="premium-input-dark"
                                     AnchorOrigin="Origin.BottomLeft"
                                     TransformOrigin="Origin.TopLeft"
                                     Dense="true" />
                </div>

                <div class="info-card-dark pa-6 rounded-xl min-h-150">
                    @if (ViewModel.HedefCari != null)
                    {
                        <div class="d-flex flex-column gap-2 animate-fade-in">
                            <span class="small fw-bold text-muted">@ViewModel.HedefCari.CariKod</span>
                            <span class="h5 fw-black text-white">@ViewModel.HedefCari.Unvan</span>
                            <div class="d-flex align-center gap-2 mt-2">
                                <span class="small text-muted">Güncel Bakiye:</span>
                                <span class="fw-black text-success">@ViewModel.HedefCari.Bakiye.ToString("N2") ₺</span>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex flex-column align-center justify-center h-100 text-muted" style="opacity: 0.3;">
                            <MudIcon Icon="@Icons.Material.Filled.Search" Size="Size.Large" />
                            <span class="small mt-2">Cari Seçilmedi</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Status and Action Bar -->
    <div class="glass-panel pa-8 mt-6">
        <div class="row align-center">
            <div class="col-md-8">
                <div class="d-flex flex-column gap-1">
                    <span class="small fw-black text-muted tracking-widest">BİRLEŞTİRME DURUMU</span>
                    <h4 class="fw-bold text-white mb-0">@ViewModel.StatusMessage</h4>
                </div>
            </div>
            <div class="col-md-4 text-end">
                <button class="action-btn-large primary-btn w-100 py-4" 
                        @onclick="ViewModel.BirlestirCommand.Execute"
                        disabled="@(ViewModel.IsLoading || ViewModel.KaynakCari == null || ViewModel.HedefCari == null)">
                    @if (ViewModel.IsLoading)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    }
                    else
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Merge" Class="mr-2" />
                    }
                    BİRLEŞTİRMEYİ BAŞLAT
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        ViewModel.PropertyChanged += (s, e) => InvokeAsync(StateHasChanged);
        await ViewModel.LoadDataAsync();
    }

    private async Task<IEnumerable<ErmayMuhasebe.Models.CariKart>> SearchCariler(string value, System.Threading.CancellationToken token)
    {
        await Task.CompletedTask;
        if (string.IsNullOrEmpty(value)) return ViewModel.Cariler;
        return ViewModel.Cariler.Where(x => (x.Unvan ?? "").Contains(value, StringComparison.OrdinalIgnoreCase) || (x.CariKod ?? "").Contains(value, StringComparison.OrdinalIgnoreCase));
    }
}

<style>
    .min-h-150 { min-height: 150px; }
    
    .info-card-dark {
        background: rgba(0,0,0,0.2);
        border: 1px solid rgba(255,255,255,0.05);
    }
    
    .border-danger-glow {
        border: 1px solid rgba(239, 68, 68, 0.1) !important;
    }
    .glass-panel.border-danger-glow:hover {
        border-color: rgba(239, 68, 68, 0.3) !important;
        box-shadow: 0 0 30px rgba(239, 68, 68, 0.1);
    }
    
    .border-success-glow {
        border: 1px solid rgba(16, 185, 129, 0.1) !important;
    }
    .glass-panel.border-success-glow:hover {
        border-color: rgba(16, 185, 129, 0.3) !important;
        box-shadow: 0 0 30px rgba(16, 185, 129, 0.1);
    }

    .pulse-arrow {
        animation: pulse-horizontal 2s infinite;
    }

    @@keyframes pulse-horizontal {
        0% { transform: translateX(0); opacity: 0.1; }
        50% { transform: translateX(15px); opacity: 0.3; }
        100% { transform: translateX(0); opacity: 0.1; }
    }
    
    .animate-fade-in {
        animation: fadeIn 0.4s ease-out;
    }
    
    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(5px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>
