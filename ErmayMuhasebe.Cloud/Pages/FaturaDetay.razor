@page "/fatura-detay"
@page "/fatura-detay/{Id:int}"
@page "/fatura-detay/yeni/{Tur}"
@using ErmayMuhasebe.Models
@using ErmayMuhasebe.Cloud.ViewModels
@inject FaturaDetayViewModel ViewModel
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject UiService UiService
@implements IDisposable

<div class="premium-container fade-in">
    <!-- Header with Breadcrumbs & Actions -->
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div class="d-flex align-items-center gap-3">
            <button class="premium-button secondary p-2" @onclick="ViewModel.Cancel">
                <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Size="Size.Small" />
            </button>
            <div>
                <div class="small opacity-50 uppercase fw-bold ls-1">FATURA EDİTÖRÜ</div>
                <h2 class="h3 fw-bold m-0 text-white">@ViewModel.FaturaTuru Faturası</h2>
            </div>
        </div>
        
        <div class="d-flex gap-3">
            <button class="premium-button secondary px-4" @onclick="ViewModel.Cancel">İptal</button>
            <button class="premium-button success shine-effect px-5" @onclick="ViewModel.SaveFaturaAsync">
                @if (ViewModel.IsLoading) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" /> }
                Faturayı Kaydet
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(ViewModel.ErrorMessage))
    {
        <div class="alert alert-danger glass-morphism border-danger-50 text-white mb-4">
            <MudIcon Icon="@Icons.Material.Filled.Error" Size="Size.Small" Class="me-2" />
            @ViewModel.ErrorMessage
        </div>
    }

    <div class="row g-4">
        <!-- Main Form -->
        <div class="col-xl-9 col-lg-8">
            <div class="premium-panel glass-morphism mb-4">
                <div class="premium-section-title mb-4">Üst Bilgiler</div>
                <div class="row g-4">
                    <div class="col-md-6">
                        <div class="premium-input-group">
                            <label>Cari Hesap</label>
                            <div class="d-flex gap-2">
                                <input type="text" value="@(ViewModel.Cari?.Unvan ?? "Cari seçiniz...")" readonly class="flex-grow-1" />
                                <button class="premium-button secondary p-2" @onclick="() => ViewModel.IsCariSecimVisible = true">
                                    <MudIcon Icon="@Icons.Material.Filled.PersonSearch" Size="Size.Small" />
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="premium-input-group">
                            <label>Fatura No</label>
                            <input type="text" @bind="ViewModel.FaturaNo" />
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="premium-input-group">
                            <label>Tarih</label>
                            <input type="text" @bind="ViewModel.TarihStr" placeholder="GG.AA.YYYY" />
                        </div>
                    </div>
                    <div class="col-md-12">
                        <div class="premium-input-group m-0">
                            <label>Açıklama</label>
                            <textarea @bind="ViewModel.Aciklama" rows="1"></textarea>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Items Grid -->
            <div class="premium-panel glass-morphism p-0 overflow-hidden mb-4">
                <div class="premium-panel-header d-flex justify-content-between align-items-center">
                    <h2 class="premium-panel-title">Fatura Satırları</h2>
                    <button class="premium-button primary py-2 px-4" @onclick="() => ViewModel.IsStokSecimVisible = true">
                        <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" Class="me-2" />
                        Ürün Ekle
                    </button>
                </div>
                
                <div class="table-responsive">
                    <table class="premium-table">
                        <thead>
                            <tr>
                                <th>Ürün / Stok</th>
                                <th style="width: 100px;">Birim</th>
                                <th style="width: 120px;" class="text-end">Miktar</th>
                                <th style="width: 150px;" class="text-end">Birim Fiyat</th>
                                <th style="width: 100px;" class="text-end">KDV %</th>
                                <th style="width: 150px;" class="text-end">Toplam</th>
                                <th style="width: 50px;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!ViewModel.Items.Any())
                            {
                                <tr>
                                    <td colspan="7" class="text-center py-5 opacity-30">
                                        <MudIcon Icon="@Icons.Material.Filled.PlaylistAdd" Size="Size.Large" Class="mb-2" />
                                        <p>Faturaya henüz ürün eklenmedi.</p>
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var item in ViewModel.Items)
                                {
                                    <tr class="premium-row">
                                        <td>
                                            <div class="fw-bold">@item.Ad</div>
                                            <div class="small opacity-50">@item.Kod</div>
                                        </td>
                                        <td class="small">@item.Birim</td>
                                        <td class="text-end">
                                            <input type="number" step="0.01" @bind="item.Miktar" class="table-input text-end" />
                                        </td>
                                        <td class="text-end">
                                            <input type="number" step="0.01" @bind="item.BirimFiyat" class="table-input text-end" />
                                        </td>
                                        <td class="text-end">
                                            <input type="number" @bind="item.KdvOrani" class="table-input text-end" />
                                        </td>
                                        <td class="text-end fw-bold">@item.GenelToplam.ToString("N2")</td>
                                        <td class="text-center">
                                            <button class="btn-icon-danger" @onclick="() => ViewModel.RemoveItem(item)">
                                                <MudIcon Icon="@Icons.Material.Filled.Delete" Size="Size.Small" />
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Sidebar Summary -->
        <div class="col-xl-3 col-lg-4">
            <div class="premium-panel glass-morphism">
                <div class="premium-section-title mb-4">GENEL TOPLAM</div>
                
                <div class="d-flex flex-column gap-3 mb-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="opacity-70">Ara Toplam</span>
                        <span class="fw-bold">@ViewModel.AraToplam.ToString("C2")</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="opacity-70">Toplam KDV</span>
                        <span class="fw-bold">@ViewModel.KdvToplam.ToString("C2")</span>
                    </div>
                    <div class="premium-divider"></div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="h5 m-0 fw-bold">Net Toplam</span>
                        <span class="h4 m-0 fw-bold text-primary-accent">@ViewModel.GenelToplam.ToString("C2")</span>
                    </div>
                </div>

                <div class="mt-5 p-3 rounded-4 bg-white-5 border border-white-10 text-center">
                    <MudIcon Icon="@Icons.Material.Filled.Security" Size="Size.Small" Class="opacity-30 mb-2" />
                    <p class="small opacity-50 m-0">Fatura onaylandığı an cari hesap bakiye ve stok miktarları güncellenecektir.</p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Stok Seçim Dialog -->
@if (ViewModel.IsStokSecimVisible)
{
    <div class="premium-dialog-overlay fade-in">
        <div class="premium-dialog glass-morphism p-0 shadow-2xl" style="width: 700px;">
            <div class="premium-dialog-header p-4 bg-white-5 d-flex justify-content-between align-items-center">
                <h3 class="m-0 h5 fw-bold">Stok Kartı Seçimi</h3>
                <button class="btn-close-premium" @onclick="() => ViewModel.IsStokSecimVisible = false">
                    <MudIcon Icon="@Icons.Material.Filled.Close" />
                </button>
            </div>
            <div class="p-4">
                <div class="premium-input-group mb-3">
                    <div class="input-container border-white-10">
                        <MudIcon Icon="@Icons.Material.Filled.Search" Class="input-icon" />
                        <input type="text" @bind="ViewModel.StokSearchText" @bind:event="oninput" 
                               @onkeyup='(e) => { if(e.Key == "Enter") ViewModel.SearchStokAsync(); }'
                               placeholder="Ürün adı veya kod ara..." autofocus />
                    </div>
                </div>
                <div class="table-responsive" style="max-height: 400px;">
                    <table class="premium-table">
                        <thead>
                            <tr>
                                <th>Stok Adı</th>
                                <th>Kod</th>
                                <th class="text-end">Mevcut</th>
                                <th class="text-end">Birim F.</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var stok in ViewModel.StokListesi)
                            {
                                <tr class="premium-row clickable @(ViewModel.SelectedStokForAdd?.Id == stok.Id ? "selected" : "")"
                                    @onclick="() => ViewModel.SelectedStokForAdd = stok"
                                    @ondblclick="ViewModel.AddStokToGrid">
                                    <td class="fw-bold">@stok.StokAdi</td>
                                    <td class="small opacity-50">@stok.StokKodu</td>
                                    <td class="text-end @(stok.Miktar <= stok.KritikSeviye ? "text-danger fw-bold" : "")">@stok.Miktar.ToString("N0")</td>
                                    <td class="text-end">@stok.SatisFiyati.ToString("C2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="p-4 border-top border-white-10 d-flex justify-content-end gap-2">
                <button class="premium-button secondary" @onclick="() => ViewModel.IsStokSecimVisible = false">Kapat</button>
                <button class="premium-button success" @onclick="ViewModel.AddStokToGrid" disabled="@(ViewModel.SelectedStokForAdd == null)">Seç ve Ekle</button>
            </div>
        </div>
    </div>
}

<!-- Cari Seçim Dialog -->
@if (ViewModel.IsCariSecimVisible)
{
    <div class="premium-dialog-overlay fade-in">
        <div class="premium-dialog glass-morphism p-0 shadow-2xl" style="width: 500px;">
            <div class="premium-dialog-header p-4 bg-white-5 d-flex justify-content-between align-items-center">
                <h3 class="m-0 h5 fw-bold">Cari Hesap Seçimi</h3>
                <button class="btn-close-premium" @onclick="() => ViewModel.IsCariSecimVisible = false">
                    <MudIcon Icon="@Icons.Material.Filled.Close" />
                </button>
            </div>
            <div class="p-4">
                <div class="premium-input-group mb-3">
                    <div class="input-container border-white-10">
                        <MudIcon Icon="@Icons.Material.Filled.Search" Class="input-icon" />
                        <input type="text" @bind="ViewModel.CariSearchText" @bind:event="oninput" 
                               @onkeyup='(e) => { if(e.Key == "Enter") ViewModel.SearchCariAsync(); }'
                               placeholder="Ünvan veya kod ara..." autofocus />
                    </div>
                </div>
                <div class="table-responsive" style="max-height: 400px;">
                    <table class="premium-table">
                        <tbody>
                            @foreach (var cari in ViewModel.CariListesi)
                            {
                                <tr class="premium-row clickable @(ViewModel.SelectedCariForAdd?.Id == cari.Id ? "selected" : "")"
                                    @onclick="() => ViewModel.SelectedCariForAdd = cari"
                                    @ondblclick="ViewModel.SelectCari">
                                    <td class="fw-bold">@cari.Unvan</td>
                                    <td class="text-end small opacity-50">@cari.CariKod</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="p-4 border-top border-white-10 d-flex justify-content-end gap-2">
                <button class="premium-button secondary" @onclick="() => ViewModel.IsCariSecimVisible = false">Kapat</button>
                <button class="premium-button success" @onclick="ViewModel.SelectCari" disabled="@(ViewModel.SelectedCariForAdd == null)">Seç</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int? Id { get; set; }
    [Parameter] public string Tur { get; set; } = "";

    protected override async Task OnInitializedAsync()
    {
        ViewModel.PropertyChanged += (s, e) => StateHasChanged();
        UiService.OnEscapePressed += HandleEscape;
        await ViewModel.InitializeAsync(Id, null, Tur);
        
        // Load initial search results
        _ = ViewModel.SearchStokAsync();
        _ = ViewModel.SearchCariAsync();
    }

    private async Task<bool> HandleEscape()
    {
        if (ViewModel.IsStokSecimVisible)
        {
            ViewModel.IsStokSecimVisible = false;
            StateHasChanged();
            return true;
        }

        if (ViewModel.IsCariSecimVisible)
        {
            ViewModel.IsCariSecimVisible = false;
            StateHasChanged();
            return true;
        }

        await Task.CompletedTask;
        return false;
    }

    public void Dispose()
    {
        UiService.OnEscapePressed -= HandleEscape;
    }
}

<style>
    .table-input {
        background: rgba(255,255,255,0.05);
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 6px;
        color: white;
        padding: 4px 8px;
        width: 100%;
        transition: all 0.2s;
    }
    .table-input:focus {
        background: rgba(var(--primary-accent-rgb), 0.1);
        border-color: var(--primary-accent);
        outline: none;
    }

    .btn-icon-danger {
        background: transparent;
        border: none;
        color: #F87171;
        opacity: 0.5;
        transition: opacity 0.2s;
    }
    .btn-icon-danger:hover {
        opacity: 1;
    }

    .premium-row.selected {
        background: rgba(var(--primary-accent-rgb), 0.1) !important;
        border-left: 3px solid var(--primary-accent);
    }

    .btn-close-premium {
        background: rgba(255,255,255,0.05);
        border: none;
        color: white;
        width: 32px;
        height: 32px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
    }
</style>
