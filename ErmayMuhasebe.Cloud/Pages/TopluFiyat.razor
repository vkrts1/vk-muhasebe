@page "/toplu-fiyat"
@using ErmayMuhasebe.Models
@using ErmayMuhasebe.Shared.ViewModels
@inject TopluFiyatViewModel ViewModel
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<style>
    .tp-container {
        padding: 30px 40px;
        background: #0B0D12;
        min-height: 100vh;
        color: white;
        font-family: 'Outfit', sans-serif;
    }

    .tp-header {
        display: flex;
        align-items: center;
        gap: 20px;
        margin-bottom: 30px;
    }

    .tp-icon-box {
        width: 54px;
        height: 54px;
        background: rgba(16, 185, 129, 0.1);
        border: 1px solid rgba(16, 185, 129, 0.2);
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .tp-title {
        font-size: 28px;
        font-weight: 800;
        margin: 0;
        background: linear-gradient(to right, #ffffff, #9CA3AF);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .tp-subtitle {
        color: #9CA3AF;
        font-size: 14px;
        margin-top: 4px;
    }

    .tp-content-grid {
        display: grid;
        grid-template-columns: 350px 1fr;
        gap: 24px;
        align-items: start;
    }

    .tp-card {
        background: #111417;
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 20px;
        padding: 24px;
    }

    .tp-card-title {
        font-size: 18px;
        font-weight: 700;
        margin-bottom: 20px;
        color: white;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .tp-field-label {
        font-size: 12px;
        color: #9CA3AF;
        margin-bottom: 8px;
        display: block;
        font-weight: 500;
    }

    .tp-input {
        width: 100%;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 12px;
        padding: 10px 14px;
        color: white;
        font-size: 14px;
        outline: none;
        transition: border-color 0.2s;
    }

    .tp-input:focus {
        border-color: #10B981;
    }

    .tp-radio-group {
        display: flex;
        gap: 15px;
        margin-top: 5px;
    }

    .tp-radio-item {
        display: flex;
        align-items: center;
        gap: 8px;
        cursor: pointer;
        font-size: 14px;
    }

    .tp-apply-btn {
        width: 100%;
        height: 48px;
        background: #10B981;
        color: white;
        border: none;
        border-radius: 14px;
        font-weight: 700;
        font-size: 14px;
        margin-top: 20px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        transition: all 0.2s;
    }

    .tp-apply-btn:hover {
        filter: brightness(1.1);
        transform: translateY(-2px);
    }

    .tp-table {
        width: 100%;
        border-collapse: collapse;
    }

    .tp-table th {
        text-align: left;
        padding: 12px 16px;
        font-size: 12px;
        color: #6B7280;
        font-weight: 700;
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    }

    .tp-table td {
        padding: 14px 16px;
        font-size: 13px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.03);
    }

    .tp-badge-old {
        color: #9CA3AF;
        text-decoration: line-through;
        opacity: 0.6;
    }

    .tp-badge-new {
        color: #10B981;
        font-weight: 700;
    }

    .tp-note {
        background: rgba(16, 185, 129, 0.05);
        border: 1px solid rgba(16, 185, 129, 0.1);
        border-radius: 12px;
        padding: 12px;
        margin-top: 20px;
        font-size: 11px;
        color: #10B981;
        line-height: 1.4;
    }
</style>

<div class="tp-container">
    <div class="tp-header">
        <div class="tp-icon-box">
            <MudIcon Icon="@Icons.Material.Filled.LocalOffer" Style="color: #10B981; font-size: 28px;" />
        </div>
        <div>
            <h1 class="tp-title">Toplu Fiyat Güncelleme</h1>
            <p class="tp-subtitle">Ürün fiyatlarını filtreleyerek toplu halde güncelleyin.</p>
        </div>
    </div>

    <div class="tp-content-grid">
        <!-- Control Card -->
        <div class="tp-card">
            <h2 class="tp-card-title">
                <MudIcon Icon="@Icons.Material.Filled.FilterList" Size="Size.Small" />
                Filtreleme ve Değişim
            </h2>

            <div style="margin-bottom: 20px;">
                <span class="tp-field-label">Stok Grubu / Kategori</span>
                <select class="tp-input" @bind="ViewModel.SeciliKategori">
                    @foreach (var kat in ViewModel.Kategoriler)
                    {
                        <option value="@kat">@kat</option>
                    }
                </select>
            </div>

            <div style="margin-bottom: 20px;">
                <span class="tp-field-label">İşlem Türü</span>
                <div class="tp-radio-group">
                    <label class="tp-radio-item" @onclick='() => ViewModel.IslemTuru = "Zam"'>
                        <MudIcon Icon="@(ViewModel.IslemTuru == "Zam" ? Icons.Material.Filled.RadioButtonChecked : Icons.Material.Filled.RadioButtonUnchecked)" Size="Size.Small" Color="Color.Primary" />
                        <span>Zam</span>
                    </label>
                    <label class="tp-radio-item" @onclick='() => ViewModel.IslemTuru = "Indirim"'>
                        <MudIcon Icon="@(ViewModel.IslemTuru == "Indirim" ? Icons.Material.Filled.RadioButtonChecked : Icons.Material.Filled.RadioButtonUnchecked)" Size="Size.Small" Color="Color.Primary" />
                        <span>İndirim</span>
                    </label>
                </div>
            </div>

            <div style="margin-bottom: 20px;">
                <span class="tp-field-label">Değişim Tipi</span>
                <div class="tp-radio-group">
                    <label class="tp-radio-item" @onclick="() => ViewModel.IsPercentage = true">
                        <MudIcon Icon="@(ViewModel.IsPercentage ? Icons.Material.Filled.RadioButtonChecked : Icons.Material.Filled.RadioButtonUnchecked)" Size="Size.Small" Color="Color.Primary" />
                        <span>Yüzde (%)</span>
                    </label>
                    <label class="tp-radio-item" @onclick="() => ViewModel.IsPercentage = false">
                        <MudIcon Icon="@(!ViewModel.IsPercentage ? Icons.Material.Filled.RadioButtonChecked : Icons.Material.Filled.RadioButtonUnchecked)" Size="Size.Small" Color="Color.Primary" />
                        <span>Sabit Tutar</span>
                    </label>
                </div>
            </div>

            <div style="margin-bottom: 20px;">
                <span class="tp-field-label">Değişim Miktarı</span>
                <input type="number" class="tp-input" @bind="ViewModel.Oran" />
            </div>

            <div class="tp-note">
                Not: Değişiklikler yandaki listede anlık olarak önizlenebilir. Uygula butonuna basana kadar veritabanına kaydedilmez.
            </div>

            <button class="tp-apply-btn" @onclick="HandleApply" disabled="@ViewModel.IsLoading">
                @if (ViewModel.IsLoading)
                {
                    <MudProgressCircular Color="Color.Default" Size="Size.Small" Indeterminate="true" />
                }
                else
                {
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" />
                    <span>DEĞİŞİKLİKLERİ UYGULA</span>
                }
            </button>
        </div>

        <!-- Table Card -->
        <div class="tp-card" style="padding: 0; overflow: hidden; display: flex; flex-direction: column;">
            <div style="padding: 16px 24px; border-bottom: 1px solid rgba(255,255,255,0.05); display: flex; justify-content: space-between; align-items: center;">
                <span style="font-weight: 700; font-size: 14px;">Önizleme Listesi (@ViewModel.Items.Count Ürün)</span>
            </div>
            <div style="overflow-y: auto; max-height: 600px;">
                <table class="tp-table">
                    <thead>
                        <tr>
                            <th>Stok Kodu</th>
                            <th>Stok Adı</th>
                            <th>Kategori</th>
                            <th style="text-align:right;">Eski Fiyat</th>
                            <th style="text-align:right;">Yeni Fiyat</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in ViewModel.Items)
                        {
                            <tr>
                                <td style="color: #60A5FA; font-weight: 700;">@item.Stok.StokKodu</td>
                                <td>@item.Stok.StokAdi</td>
                                <td>@item.Stok.Kategori</td>
                                <td style="text-align:right;" class="tp-badge-old">@item.EskiFiyat.ToString("N2")</td>
                                <td style="text-align:right;" class="tp-badge-new">@item.YeniFiyat.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        ViewModel.PropertyChanged += (s, e) => StateHasChanged();
        await ViewModel.InitializeAsync();
    }

    private async Task HandleApply()
    {
        if (ViewModel.Items.Count == 0) return;

        bool? confirm = await DialogService.ShowMessageBox(
            "Fiyat Güncelleme",
            $"{ViewModel.Items.Count} adet ürünün fiyatı güncellenecektir. Emin misiniz?",
            yesText: "Evet, Uygula", cancelText: "Vazgeç"
        );

        if (confirm == true)
        {
            await ViewModel.UygulaAsync();
            if (string.IsNullOrEmpty(ViewModel.ErrorMessage))
            {
                Snackbar.Add("Fiyatlar başarıyla güncellendi.", Severity.Success);
            }
            else
            {
                Snackbar.Add(ViewModel.ErrorMessage, Severity.Error);
            }
        }
    }
}
