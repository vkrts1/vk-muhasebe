    private async void ShowYearSelection()
    {
        _availableYears = await FirebaseService.GetAvailableYearsAsync();
        selectedYear = _availableYears.FirstOrDefault();
        if (selectedYear == 0) selectedYear = DateTime.Now.Year;
        
        _isYearSelectionVisible = true;
        StateHasChanged();
    }

