    private bool _isStatusBarEditMode = false;
    private List<string>? _pendingItemsOrder;

    private void StartStatusBarEdit()
    {
        _pendingItemsOrder = new List<string>(_itemsOrder);
        _isStatusBarEditMode = true;
    }

    private async Task SaveStatusBarEdit()
    {
        if (_pendingItemsOrder != null)
        {
            _itemsOrder = new List<string>(_pendingItemsOrder);
            LocalStorage.SetItem("sb_items_order", _itemsOrder);
        }
        _isStatusBarEditMode = false;
        _pendingItemsOrder = null;
    }

    private void CancelStatusBarEdit()
    {
        _isStatusBarEditMode = false;
        _pendingItemsOrder = null;
    }

    private string _draggingId = "";
    private void HandleDragStart(string id) => _draggingId = id;
    
    private void HandleDragEnter(string targetId)
    {
        if (string.IsNullOrEmpty(_draggingId) || _draggingId == targetId) return;
        
        // Live reorder logic
        var list = _pendingItemsOrder ?? new List<string>(_itemsOrder);
        int oldIndex = list.IndexOf(_draggingId);
        int newIndex = list.IndexOf(targetId);
        
        if (oldIndex != -1 && newIndex != -1)
        {
            list.RemoveAt(oldIndex);
            list.Insert(newIndex, _draggingId);
            
            _pendingItemsOrder = list;
            _isStatusBarEditMode = true; // Automatically enter edit mode on drag
            StateHasChanged();
        }
    }

    private void HandleDragEnd()
    {
        // Don't clear draggingId immediately if we want a smooth finish, 
        // but here it's fine
        _draggingId = "";
        StateHasChanged();
    }

    private void HandleDrop(string targetId)
    {
        // Drop is now handled by DragEnter for 'live' effect,
        // but we can keep it for final cleanup if needed.
        _draggingId = "";
        StateHasChanged();
    }

