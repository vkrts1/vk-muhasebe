    [JSInvokable]
    public async Task HandleGlobalShortcut(string key)
    {
        switch (key)
        {
            case "Esc":
                // 1. Notify custom overlays (Context menus etc.) 
                if (await UiService.NotifyEscapePressedAsync()) return;

                // 2. Desktop Parity: Navigate Back / Home
                // Desktop: if (History.Count > 0) Pop(); else if (CurrentPage != Dashboard) go Dashboard;
                
                string currentPath = new Uri(Nav.Uri).AbsolutePath.ToLower().TrimEnd('/');
                
                // Known module roots
                var moduleRoots = new[] { "/stoklar", "/cariler", "/faturalar", "/teklifler", "/siparisler", "/finans", "/raporlar", "/ayarlar", "/araclar" };
                bool isAtModuleRoot = moduleRoots.Contains(currentPath);

                if (currentPath != "" && currentPath != "/")
                {
                    if (isAtModuleRoot)
                    {
                        // If at module root, ESC goes to Dashboard (exact desktop parity)
                        Nav.NavigateTo("/");
                    }
                    else
                    {
                        // Otherwise try history back
                        await JS.InvokeVoidAsync("history.back");
                    }
                }
                break;
            case "KeyK":
                // 3. CTRL + K Shortcut for Search
                await OpenMobileSearch();
                break;
            case "F1":
                // ...
                break;
        }
    }

