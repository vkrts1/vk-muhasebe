    private DotNetObjectReference<MainLayout>? _objRef;



    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _objRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("initDesktopBehavior", _objRef);
            await JS.InvokeVoidAsync("historyManagement.registerBackListener", _objRef);

            // Apply saved scaling with aggressive safety
            try 
            {
                double scale = 1.0;
                bool autoScale = true;
                if (LocalStorage.ContainKey("auto_scale_enabled"))
                {
                    autoScale = LocalStorage.GetItem<bool>("auto_scale_enabled");
                }

                if (LocalStorage.ContainKey("app_scale"))
                {
                    var scaleVal = LocalStorage.GetItem<object>("app_scale");
                    if (scaleVal != null && double.TryParse(scaleVal.ToString()?.Replace(",", "."), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var s))
                    {
                        scale = s;
                        // If scale is not 1.0, we might have manual scaling, but if autoScale is on, it takes precedence in JS
                    }
                }

                // If it's manual mode, we pass the saved scale. If auto mode, JS ignores the scale param.
                await JS.InvokeVoidAsync("applyAppScaling", scale, autoScale);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"ERMAY scaling error: {ex.Message}");
                // Absolute fallback to prevent black screen
                try { await JS.InvokeVoidAsync("applyAppScaling", 1.0, false); } catch { }
            }

            // --- Background Sync Loop (Offline-First Management) ---
            _ = Task.Run(async () => 
            {
                while (true)
                {
                    await Task.Delay(30000); // Check every 30 seconds
                    if (AuthService.IsAuthenticated)
                    {
                        try 
                        { 
                            await FirebaseService.ProcessSyncQueueAsync(); 
                        } 
                        catch { /* Silent fail in background */ }
                    }
                }
            });
        }
    }

